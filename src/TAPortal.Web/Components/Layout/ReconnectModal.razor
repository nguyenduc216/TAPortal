<div id="components-reconnect-modal" class="ta-reconnect" aria-live="assertive" role="alert" aria-hidden="true">
    <div class="ta-reconnect-card">
        <i class="ti ti-refresh" aria-hidden="true"></i>
        <h2 data-ta-reconnect-title>Đang kết nối lại hệ thống</h2>
        <p data-ta-reconnect-message>Máy chủ có thể đang được cập nhật. Hệ thống sẽ tự kết nối lại khi sẵn sàng.</p>
        <button class="btn btn-primary" type="button" data-ta-reconnect-retry>Thử lại</button>
        <button class="btn btn-link" type="button" data-ta-reconnect-reload>Tải lại trang</button>
    </div>
</div>
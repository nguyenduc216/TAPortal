@{ // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-002 — normalize absolute and MVC/Blazor route paths before active-state rendering.
   var currentPath = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/'); if (string.IsNullOrEmpty(currentPath)) currentPath = "/"; var routePath = string.IsNullOrWhiteSpace(Node.Menu.Route) ? "#" : Node.Menu.Route.Split('?', '#')[0].TrimEnd('/'); if (string.IsNullOrEmpty(routePath)) routePath = "/"; var active = routePath != "#" && currentPath.Equals(routePath, StringComparison.OrdinalIgnoreCase); var hasChildren = Node.Children.Count > 0; var icon = (Node.Menu.Icon ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault(x => x.StartsWith("ti-")) ?? (hasChildren ? "ti-folders" : "ti-point"); }
<li class="nav-item ta-nav-node @(active ? "is-active-branch" : "")"><div class="ta-nav-row"><a class="nav-link ta-nav-link @(active ? "active" : "")" href="@(string.IsNullOrWhiteSpace(Node.Menu.Route) ? "#" : Node.Menu.Route)" style="--ta-menu-depth:@Depth"><span class="nav-link-icon"><i class="ti @icon"></i></span><span class="nav-link-title ta-sidebar-label">@Node.Menu.Name</span></a></div>@if (hasChildren) { <ul class="ta-nav-children">@foreach (var child in Node.Children) { <SidebarMenuNode Node="child" Depth="@(Depth + 1)" /> }</ul> }</li>
@code { [Parameter] public PortalMenuNode Node { get; set; } = default!; [Parameter] public int Depth { get; set; } [Inject] private NavigationManager Nav { get; set; } = default!; }
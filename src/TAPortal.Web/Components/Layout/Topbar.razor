@inject AuthenticationStateProvider Auth
@implements IDisposable
@code {
    private string Name = "Người dùng";
    protected override async Task OnInitializedAsync() { Auth.AuthenticationStateChanged += OnAuthenticationStateChanged; await RefreshAsync(await Auth.GetAuthenticationStateAsync()); }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-007 — keep circuit identity chrome synchronized after auth-state changes.
    private void OnAuthenticationStateChanged(Task<AuthenticationState> stateTask) => _ = InvokeAsync(async () => { await RefreshAsync(await stateTask); StateHasChanged(); });
    private Task RefreshAsync(AuthenticationState state) { var user=state.User; Name=user.Identity?.IsAuthenticated==true ? user.FindFirst("display_name")?.Value ?? user.Identity.Name ?? "Người dùng" : "Người dùng"; return Task.CompletedTask; }
    public void Dispose() => Auth.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}

@page "/blazor/hr/teams"
@attribute [Authorize]
@inject PortalDb Db
@inject AuthenticationStateProvider Authentication
@inject GlobalLoadingService Loading
<PageTitle>Team - T.A Portal</PageTitle>
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Nhân sự</div><h1 class="ta-page-title">Team</h1><p class="ta-page-subtitle">Quản lý các nhóm làm việc thuộc phòng ban.</p></div></div>
@if (_loading) { <p class="text-secondary">Đang tải...</p> } else if (!_allowed) { <div class="alert alert-danger">Bạn không có quyền truy cập chức năng này.</div> } else { @if (_message is not null) { <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div> } <div class="row row-cards"><div class="col-lg-8"><div class="card"><div class="card-header ta-toolbar"><input class="form-control" placeholder="Tìm theo mã hoặc tên Team..." @bind="_search" @bind:event="oninput" /><select class="form-select" @bind="_departmentFilter"><option value="">Tất cả phòng ban</option>@foreach (var d in _departments) { <option value="@d.Id">@d.Code – @d.Name</option> }</select></div><div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Mã</th><th>Tên</th><th>Phòng ban</th><th>Team cha</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var t in Filtered) { <tr><td><code>@t.Code</code></td><td>@t.Name</td><td>@t.DepartmentCode</td><td>@(t.ParentTeamCode ?? "—")</td><td>@(t.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td>@if (_canUpdate) { <button class="btn btn-sm btn-outline-secondary" disabled="@_saving" @onclick="() => ToggleAsync(t)">@(t.IsActive ? "Ngừng" : "Kích hoạt")</button> } @if (_canDelete) { <button class="btn btn-sm btn-outline-danger" disabled="@_saving" @onclick="() => DeleteAsync(t)">Xóa</button> }</td></tr> }</tbody></table></div>@if (!Filtered.Any()) { <div class="card-body text-secondary">@(_teams.Count == 0 ? "Chưa có Team." : "Không tìm thấy kết quả phù hợp.")</div>}</div></div>@if (_canCreate) { <div class="col-lg-4"><div class="card"><div class="card-header"><h2 class="card-title">Thêm Team</h2></div><div class="card-body"><EditForm Model="_create" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary /><InputSelect class="form-select mb-2" @bind-Value="_create.DepartmentId"><option value="@Guid.Empty">Chọn phòng ban</option>@foreach (var d in _departments) { <option value="@d.Id">@d.Code – @d.Name</option> }</InputSelect><InputText class="form-control mb-2" @bind-Value="_create.Code" placeholder="Mã" /><InputText class="form-control mb-2" @bind-Value="_create.Name" placeholder="Tên" /><InputText class="form-control mb-2" @bind-Value="_create.Description" placeholder="Mô tả" /><InputNumber class="form-control mb-2" @bind-Value="_create.SortOrder" /><button class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Lưu")</button></EditForm></div></div></div> }</div> }
@code {
    private List<TeamRow> _teams = new(); private List<TeamDepartmentOption> _departments = new(); private TeamCreateVm _create = new() { IsActive = true }; private bool _loading = true, _allowed, _canCreate, _canUpdate, _canDelete, _saving, _success; private string _search = "", _departmentFilter = ""; private string? _message;
    private IEnumerable<TeamRow> Filtered => _teams.Where(x => (string.IsNullOrWhiteSpace(_search) || $"{x.Code} {x.Name}".Contains(_search, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_departmentFilter) || x.DepartmentId.ToString() == _departmentFilter));
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — resolve current identity and load existing team/department projections.
    private async Task<Guid?> UserIdAsync() { var user = (await Authentication.GetAuthenticationStateAsync()).User; return Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null; }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — retain MVC action permission and option loading semantics.
    protected override async Task OnInitializedAsync() { using var scope = Loading.Begin("Đang tải Team..."); try { var id = await UserIdAsync(); _allowed = id.HasValue && await Db.HasFunctionActionAsync(id.Value, "Teams.Index"); if (_allowed) { var p = await Db.GetEffectivePermissionsAsync(id!.Value); _canCreate = p.Contains("HR.TEAM.CREATE"); _canUpdate = p.Contains("HR.TEAM.UPDATE"); _canDelete = p.Contains("HR.TEAM.DELETE"); await ReloadAsync(); } } catch { _message = "Không thể tải Team."; } finally { _loading = false; } }
    private async Task ReloadAsync() { _teams = (await Db.GetTeamsAsync()).ToList(); var options = await Db.GetTeamOptionsAsync(); _departments = options.Departments.ToList(); }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — recheck permission, normalize input and delegate hierarchy validation to PortalDb.
    private async Task CreateAsync() { if (_saving) return; _saving = true; try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Teams.Create")) { Fail("Bạn không có quyền tạo Team."); return; } _create.Code = TeamRules.NormalizeCode(_create.Code); var r = await Db.CreateTeamAsync(_create, id); Report(r, "Đã tạo Team mới."); if (r == TeamWriteResult.Success) { await ReloadAsync(); _create = new() { IsActive = true }; } } catch { Fail("Không thể lưu Team lúc này."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — use server row versions for status changes and preserve concurrency handling.
    private async Task ToggleAsync(TeamRow t) { if (_saving) return; _saving = true; try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Teams.Update")) { Fail("Bạn không có quyền cập nhật Team."); return; } TeamRules.TryDecodeRowVersion(t.RowVersion, out var rv); Report(await Db.SetTeamActiveAsync(t.Id, !t.IsActive, rv, id), "Đã cập nhật trạng thái."); await ReloadAsync(); } catch { Fail("Không thể cập nhật Team."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — retain MVC soft-delete dependency protection.
    private async Task DeleteAsync(TeamRow t) { if (_saving) return; _saving = true; try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Teams.Delete")) { Fail("Bạn không có quyền xóa Team."); return; } TeamRules.TryDecodeRowVersion(t.RowVersion, out var rv); Report(await Db.SoftDeleteTeamAsync(t.Id, rv, id), "Đã xóa mềm Team."); await ReloadAsync(); } catch { Fail("Không thể xóa Team."); } finally { _saving = false; } }
    private void Fail(string text) { _success = false; _message = text; } private void Report(TeamWriteResult r, string ok) { _success = r == TeamWriteResult.Success; _message = _success ? ok : r switch { TeamWriteResult.DuplicateCode => "Mã Team đã tồn tại.", TeamWriteResult.InvalidDepartment => "Phòng ban không tồn tại hoặc không hoạt động.", TeamWriteResult.InvalidParent or TeamWriteResult.Cycle or TeamWriteResult.SelfParent => "Quan hệ Team cha không hợp lệ.", TeamWriteResult.HasDependencies => "Không thể xóa Team đang được sử dụng.", _ => "Dữ liệu đã thay đổi, vui lòng tải lại." }; }
}
@page "/blazor/hr/teams"
@attribute [Authorize]
@inject IBlazorPortalService Db
@inject AuthenticationStateProvider Authentication
@inject GlobalLoadingService Loading
<PageTitle>Team - T.A Portal</PageTitle>
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Nhân sự</div><h1 class="ta-page-title">Team</h1><p class="ta-page-subtitle">Quản lý các nhóm làm việc thuộc phòng ban.</p></div></div>
@if (_loading) { <p class="text-secondary" role="status">Đang tải...</p> }
else if (!_allowed) { <div class="alert alert-danger">Bạn không có quyền truy cập chức năng này.</div> }
else
{
 @if (_message is not null) { <div class="alert @(_success ? "alert-success" : "alert-danger")" role="alert">@_message</div> }
 <div class="row row-cards"><div class="col-lg-8"><div class="card">
  <div class="card-header ta-toolbar"><input class="form-control" placeholder="Tìm theo mã hoặc tên Team..." @bind="_search" @bind:event="oninput" /><select class="form-select" @bind="_departmentFilter"><option value="">Tất cả phòng ban</option>@foreach (var d in _departments) { <option value="@d.Id">@d.Code – @d.Name</option> }</select></div>
  <div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Mã</th><th>Tên</th><th>Phòng ban</th><th>Team cha</th><th>Trạng thái</th><th></th></tr></thead><tbody>
  @foreach (var t in Filtered) { <tr><td><code>@t.Code</code></td><td>@t.Name</td><td>@t.DepartmentCode</td><td>@(t.ParentTeamCode ?? "—")</td><td>@(t.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td>@if (_canUpdate) { <button class="btn btn-sm btn-outline-primary js-edit-team" disabled="@_saving" @onclick="() => BeginEdit(t)">Sửa</button> <button class="btn btn-sm btn-outline-secondary" disabled="@_saving" @onclick="() => ToggleAsync(t)">@(t.IsActive ? "Ngừng" : "Kích hoạt")</button> } @if (_canDelete) { <button class="btn btn-sm btn-outline-danger" disabled="@_saving" @onclick="() => DeleteAsync(t)">Xóa</button> }</td></tr> }
  </tbody></table></div>@if (!Filtered.Any()) { <div class="card-body text-secondary">@(_teams.Count == 0 ? "Chưa có Team." : "Không tìm thấy kết quả phù hợp.")</div> }
 </div></div><div class="col-lg-4">
 @if (_editing is not null)
 {
  <div class="card" data-testid="team-edit"><div class="card-header"><h2 class="card-title">Sửa Team</h2></div><div class="card-body"><EditForm Model="_editing" OnValidSubmit="UpdateAsync"><DataAnnotationsValidator /><ValidationSummary />
   <InputSelect class="form-select mb-2" @bind-Value="_editing.DepartmentId" @bind-Value:after="OnEditDepartmentChanged"><option value="@Guid.Empty">Chọn phòng ban</option>@foreach (var d in _departments) { <option value="@d.Id">@d.Code – @d.Name</option> }</InputSelect>
   <InputSelect class="form-select mb-2" @bind-Value="_editing.ParentTeamId"><option value="">Không có Team cha</option>@foreach (var t in ParentsFor(_editing, true)) { <option value="@t.Id">@t.Code – @t.Name</option> }</InputSelect>
   <InputText class="form-control mb-2" @bind-Value="_editing.Code" placeholder="Mã" /><InputText class="form-control mb-2" @bind-Value="_editing.Name" placeholder="Tên" />@if (_schema.TeamHasDescription) { <InputText class="form-control mb-2" @bind-Value="_editing.Description" placeholder="Mô tả" /> }<InputNumber class="form-control mb-2" @bind-Value="_editing.SortOrder" /><label class="form-check mb-3"><InputCheckbox class="form-check-input" @bind-Value="_editing.IsActive" /><span class="form-check-label">Hoạt động</span></label>
   <button class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Cập nhật")</button> <button type="button" class="btn btn-link" disabled="@_saving" @onclick="CancelEdit">Hủy</button>
  </EditForm></div></div>
 }
 else if (_canCreate)
 {
  <div class="card"><div class="card-header"><h2 class="card-title">Thêm Team</h2></div><div class="card-body"><EditForm Model="_create" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary />
   <InputSelect class="form-select mb-2" @bind-Value="_create.DepartmentId" @bind-Value:after="OnCreateDepartmentChanged"><option value="@Guid.Empty">Chọn phòng ban</option>@foreach (var d in _departments) { <option value="@d.Id">@d.Code – @d.Name</option> }</InputSelect>
   <InputSelect class="form-select mb-2" @bind-Value="_create.ParentTeamId"><option value="">Không có Team cha</option>@foreach (var t in ParentsFor(_create, false)) { <option value="@t.Id">@t.Code – @t.Name</option> }</InputSelect>
   <InputText class="form-control mb-2" @bind-Value="_create.Code" placeholder="Mã" /><InputText class="form-control mb-2" @bind-Value="_create.Name" placeholder="Tên" />@if (_schema.TeamHasDescription) { <InputText class="form-control mb-2" @bind-Value="_create.Description" placeholder="Mô tả" /> }<InputNumber class="form-control mb-2" @bind-Value="_create.SortOrder" /><label class="form-check mb-3"><InputCheckbox class="form-check-input" @bind-Value="_create.IsActive" /><span class="form-check-label">Hoạt động</span></label>
   <button class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Lưu")</button>
  </EditForm></div></div>
 }
 </div></div>
}

@code {
 private List<TeamRow> _teams = new(); private List<TeamDepartmentOption> _departments = new(); private List<TeamParentOption> _parentTeams = new();
 private HrSchemaOptions _schema = new(false, false, true, []);
 private TeamCreateVm _create = new() { IsActive = true }; private TeamUpdateVm? _editing;
 private bool _loading = true, _allowed, _canCreate, _canUpdate, _canDelete, _saving, _success; private string _search = "", _departmentFilter = ""; private string? _message;
 private IEnumerable<TeamRow> Filtered => _teams.Where(x => (string.IsNullOrWhiteSpace(_search) || $"{x.Code} {x.Name}".Contains(_search, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_departmentFilter) || x.DepartmentId.ToString() == _departmentFilter));
 private IEnumerable<TeamParentOption> ParentsFor(TeamCreateVm model, bool editing) => _parentTeams.Where(x => x.DepartmentId == model.DepartmentId && (!editing || x.Id != _editing?.Id));

 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — clear a create parent that becomes invalid after Department selection changes.
 private void OnCreateDepartmentChanged() { if (_create.ParentTeamId.HasValue && !_parentTeams.Any(x => x.Id == _create.ParentTeamId && x.DepartmentId == _create.DepartmentId)) _create.ParentTeamId = null; }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — clear an edit parent that becomes invalid after Department selection changes.
 private void OnEditDepartmentChanged() { if (_editing?.ParentTeamId is Guid parentId && !_parentTeams.Any(x => x.Id == parentId && x.DepartmentId == _editing.DepartmentId && x.Id != _editing.Id)) _editing.ParentTeamId = null; }

 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — resolve current circuit identity for authorization decisions.
 private async Task<Guid?> UserIdAsync() { var user = (await Authentication.GetAuthenticationStateAsync()).User; return Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null; }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — load projections and action permissions with visible failure state.
 protected override async Task OnInitializedAsync() { using var scope = Loading.Begin("Đang tải Team..."); try { var id = await UserIdAsync(); _allowed = id.HasValue && await Db.HasFunctionActionAsync(id.Value, "Teams.Index"); if (_allowed) { var p = await Db.GetEffectivePermissionsAsync(id!.Value); _canCreate = p.Contains("HR.TEAM.CREATE"); _canUpdate = p.Contains("HR.TEAM.UPDATE"); _canDelete = p.Contains("HR.TEAM.DELETE"); _schema=await Db.GetHrSchemaOptionsAsync(); await ReloadAsync(); } } catch { Fail("Không thể tải Team."); } finally { _loading = false; } }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — reload team and hierarchy option snapshots together.
 private async Task ReloadAsync() { _teams = (await Db.GetTeamsAsync()).ToList(); var options = await Db.GetTeamOptionsAsync(); _departments = options.Departments.ToList(); _parentTeams = options.Teams.ToList(); }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — preserve server-owned identity and concurrency token in edit mode.
 private void BeginEdit(TeamRow t) { _message = null; _editing = new() { Id=t.Id, RowVersion=t.RowVersion, DepartmentId=t.DepartmentId, ParentTeamId=t.ParentTeamId, Code=t.Code, Name=t.Name, Description=t.Description, SortOrder=t.SortOrder, IsActive=t.IsActive }; }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — cancel edit without persistence.
 private void CancelEdit() => _editing = null;
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — recheck create permission and delegate authoritative hierarchy validation to PortalDb.
 private async Task CreateAsync() { if (_saving) return; _saving = true; using var scope=Loading.Begin("Đang lưu Team..."); try { var id=await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Teams.Create")) { Fail("Bạn không có quyền tạo Team."); return; } _create.Code=TeamRules.NormalizeCode(_create.Code); var r=await Db.CreateTeamAsync(_create,id); Report(r,"Đã tạo Team mới."); if(r==TeamWriteResult.Success){await ReloadAsync();_create=new(){IsActive=true};} } catch { Fail("Không thể lưu Team lúc này."); } finally { _saving=false; } }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — update team hierarchy with original row version after a write-time permission recheck.
 private async Task UpdateAsync() { if(_saving||_editing is null)return;_saving=true;using var scope=Loading.Begin("Đang cập nhật Team...");try{var id=await UserIdAsync();if(!id.HasValue||!await Db.HasFunctionActionAsync(id.Value, "Teams.Update")){Fail("Bạn không có quyền cập nhật Team.");return;}if(!TeamRules.TryDecodeRowVersion(_editing.RowVersion,out var rv)){Fail("Phiên bản dữ liệu không hợp lệ.");return;}_editing.Code=TeamRules.NormalizeCode(_editing.Code);var r=await Db.UpdateTeamAsync(_editing,rv,id);Report(r,"Đã cập nhật Team.");if(r==TeamWriteResult.Success){_editing=null;await ReloadAsync();}}catch{Fail("Không thể cập nhật Team lúc này.");}finally{_saving=false;} }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — retain row-version and authorization checks for status mutation.
 private async Task ToggleAsync(TeamRow t) { if(_saving)return;_saving=true;using var scope=Loading.Begin("Đang cập nhật Team...");try{var id=await UserIdAsync();if(!id.HasValue||!await Db.HasFunctionActionAsync(id.Value,"Teams.Update")){Fail("Bạn không có quyền cập nhật Team.");return;}if(!TeamRules.TryDecodeRowVersion(t.RowVersion,out var rv)){Fail("Phiên bản dữ liệu không hợp lệ.");return;}var r=await Db.SetTeamActiveAsync(t.Id,!t.IsActive,rv,id);Report(r,"Đã cập nhật trạng thái.");if(r==TeamWriteResult.Success)await ReloadAsync();}catch{Fail("Không thể cập nhật Team.");}finally{_saving=false;} }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — retain soft-delete dependency protection and write-time permission check.
 private async Task DeleteAsync(TeamRow t) { if(_saving)return;_saving=true;using var scope=Loading.Begin("Đang xóa Team...");try{var id=await UserIdAsync();if(!id.HasValue||!await Db.HasFunctionActionAsync(id.Value, "Teams.Delete")){Fail("Bạn không có quyền xóa Team.");return;}if(!TeamRules.TryDecodeRowVersion(t.RowVersion,out var rv)){Fail("Phiên bản dữ liệu không hợp lệ.");return;}var r=await Db.SoftDeleteTeamAsync(t.Id,rv,id);Report(r,"Đã xóa mềm Team.");if(r==TeamWriteResult.Success)await ReloadAsync();}catch{Fail("Không thể xóa Team.");}finally{_saving=false;} }
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — expose a consistent operation failure.
 private void Fail(string text){_success=false;_message=text;}
 // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — translate typed hierarchy and concurrency outcomes.
 private void Report(TeamWriteResult r,string ok){_success=r==TeamWriteResult.Success;_message=_success?ok:r switch{TeamWriteResult.DuplicateCode=>"Mã Team đã tồn tại.",TeamWriteResult.InvalidDepartment=>"Phòng ban không tồn tại hoặc không hoạt động.",TeamWriteResult.InvalidParent=>"Team cha phải tồn tại và thuộc cùng phòng ban.",TeamWriteResult.SelfParent=>"Team không thể là cha của chính nó.",TeamWriteResult.Cycle=>"Quan hệ Team cha tạo thành vòng lặp.",TeamWriteResult.UnsupportedDescription=>"Schema hiện tại chưa hỗ trợ mô tả Team.",TeamWriteResult.HasDependencies=>"Không thể xóa Team đang được sử dụng.",_=>"Dữ liệu đã thay đổi, vui lòng tải lại."};}
}

@page "/blazor/account/change-password"
@attribute [Authorize]
@inject PortalDb Db
@inject PasswordService Passwords
@inject AuthenticationStateProvider Authentication
@inject GlobalLoadingService Loading

<PageTitle>Đổi mật khẩu - T.A Portal</PageTitle>
<div class="page-header"><h1 class="page-title">Đổi mật khẩu</h1></div>
<div class="row mt-3"><div class="col-lg-6"><div class="card"><div class="card-body"><EditForm Model="_model" OnValidSubmit="ChangeAsync"><DataAnnotationsValidator /><ValidationSummary />
@if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert @(_success ? "alert-success" : "alert-danger")" role="alert">@_message</div> }
<div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label><InputText type="password" class="form-control" @bind-Value="_model.CurrentPassword" /><ValidationMessage For="@(() => _model.CurrentPassword)" /></div><div class="mb-2"><label class="form-label">Mật khẩu mới</label><InputText type="password" class="form-control" @bind-Value="_model.NewPassword" /><ValidationMessage For="@(() => _model.NewPassword)" /></div><ul class="password-rules ps-3 mb-3"><li>Ít nhất 8 ký tự</li><li>Có chữ cái</li><li>Có chữ số</li><li>Có ký tự đặc biệt</li></ul><div class="mb-4"><label class="form-label">Xác nhận mật khẩu mới</label><InputText type="password" class="form-control" @bind-Value="_model.ConfirmPassword" /><ValidationMessage For="@(() => _model.ConfirmPassword)" /></div><button class="btn btn-primary" type="submit" disabled="@_saving">@( _saving ? "Đang cập nhật..." : "Cập nhật mật khẩu")</button>
</EditForm></div></div></div></div>

@code {
    private ChangePasswordVm _model = new(); private bool _saving, _success; private string? _message;
    private async Task ChangeAsync()
    {
        if (_saving) return; _saving = true; _message = null;
        var policy = PasswordPolicy.Validate(_model.NewPassword);
        if (!policy.IsValid) { _success = false; _message = policy.Error; _saving = false; return; }
        using var scope = Loading.Begin("Đang cập nhật mật khẩu...");
        try { var principal = (await Authentication.GetAuthenticationStateAsync()).User; if (!Guid.TryParse(principal.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id)) { _message = "Phiên đăng nhập không hợp lệ."; return; } var user = await Db.GetAuthUserByIdAsync(id); if (user is null || !Passwords.Verify(_model.CurrentPassword, user.PasswordHash)) { _message = "Mật khẩu hiện tại không đúng."; return; } if (Passwords.Verify(_model.NewPassword, user.PasswordHash)) { _message = "Mật khẩu mới phải khác mật khẩu hiện tại."; return; } if (!await Db.UpdatePasswordAsync(user.Id, Passwords.Hash(_model.NewPassword))) { _message = "Phiên đăng nhập không còn hợp lệ."; return; } _success = true; _message = "Đã đổi mật khẩu thành công."; _model = new(); }
        catch (Exception) { _success = false; _message = "Không thể cập nhật mật khẩu lúc này."; }
        finally { _saving = false; }
    }
}

@page "/blazor/hr/departments"
@attribute [Authorize]
@inject IBlazorPortalService Db
@inject AuthenticationStateProvider Authentication
@inject GlobalLoadingService Loading
<PageTitle>Phòng ban - T.A Portal</PageTitle>

<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Nhân sự</div><h1 class="ta-page-title">Phòng ban</h1></div></div>
@if (_loading) { <p class="text-secondary" role="status">Đang tải...</p> }
else if (!_allowed) { <div class="alert alert-danger">Bạn không có quyền truy cập chức năng này.</div> }
else
{
    @if (_message is not null) { <div class="alert @(_success ? "alert-success" : "alert-danger")" role="alert">@_message</div> }
    <div class="row row-cards">
        <div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @foreach (var d in _items)
        {
            <tr><td><code>@d.Code</code></td><td>@d.Name</td><td>@(d.Description ?? "—")</td><td>@d.SortOrder</td><td>@(d.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td>
                @if (_canUpdate) { <button class="btn btn-sm btn-outline-primary js-edit-department" disabled="@_saving" @onclick="() => BeginEdit(d)">Sửa</button> <button class="btn btn-sm btn-outline-secondary" disabled="@_saving" @onclick="() => ToggleAsync(d)">@(d.IsActive ? "Ngừng" : "Kích hoạt")</button> }
                @if (_canDelete) { <button class="btn btn-sm btn-outline-danger" disabled="@_saving" @onclick="() => DeleteAsync(d)">Xóa</button> }
            </td></tr>
        }
        </tbody></table></div>@if (!_items.Any()) { <div class="card-body text-secondary">Chưa có phòng ban.</div> }</div></div>
        <div class="col-lg-4">
        @if (_editing is not null)
        {
            <div class="card" data-testid="department-edit"><div class="card-header"><h2 class="card-title">Sửa phòng ban</h2></div><div class="card-body">
                <EditForm Model="_editing" OnValidSubmit="UpdateAsync"><DataAnnotationsValidator /><ValidationSummary />
                    <InputText class="form-control mb-2" @bind-Value="_editing.Code" aria-label="Mã phòng ban sửa" />
                    <InputText class="form-control mb-2" @bind-Value="_editing.Name" aria-label="Tên phòng ban sửa" />
                    <InputText class="form-control mb-2" @bind-Value="_editing.Description" aria-label="Mô tả phòng ban sửa" />
                    <InputNumber class="form-control mb-2" @bind-Value="_editing.SortOrder" aria-label="Thứ tự phòng ban sửa" />
                    <label class="form-check mb-3"><InputCheckbox class="form-check-input" @bind-Value="_editing.IsActive" /><span class="form-check-label">Hoạt động</span></label>
                    <button class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Cập nhật")</button> <button type="button" class="btn btn-link" disabled="@_saving" @onclick="CancelEdit">Hủy</button>
                </EditForm>
            </div></div>
        }
        else if (_canCreate)
        {
            @if (_schema.DepartmentHasBranch)
            {
                <label class="form-label">Chi nhánh</label><select class="form-select mb-2" @bind="_create.BranchId" aria-label="Chi nhánh phòng ban"><option value="">Chọn chi nhánh</option>@foreach(var branch in _schema.Branches){<option value="@branch.Id">@branch.Code – @branch.Name</option>}</select>
            }
            <div class="card"><div class="card-header"><h2 class="card-title">Thêm phòng ban</h2></div><div class="card-body"><EditForm Model="_create" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary /><InputText class="form-control mb-2" @bind-Value="_create.Code" placeholder="Mã" /><InputText class="form-control mb-2" @bind-Value="_create.Name" placeholder="Tên" /><InputText class="form-control mb-2" @bind-Value="_create.Description" placeholder="Mô tả" /><InputNumber class="form-control mb-2" @bind-Value="_create.SortOrder" /><button class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Lưu")</button></EditForm></div></div>
        }
        </div>
    </div>
}

@code {
    private List<DepartmentRow> _items = new();
    private DepartmentCreateVm _create = new() { IsActive = true };
    private DepartmentUpdateVm? _editing;
    private HrSchemaOptions _schema = new(false, false, true, []);
    private bool _loading = true, _allowed, _canCreate, _canUpdate, _canDelete, _saving, _success;
    private string? _message;

    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — resolve the authenticated circuit identity for authorization decisions.
    private async Task<Guid?> UserIdAsync() { var user = (await Authentication.GetAuthenticationStateAsync()).User; return Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null; }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — load the projection and permissions with visible failure state.
    protected override async Task OnInitializedAsync() { using var scope = Loading.Begin("Đang tải phòng ban..."); try { var id = await UserIdAsync(); _allowed = id.HasValue && await Db.HasFunctionActionAsync(id.Value, "Departments.Index"); if (_allowed) { var p = await Db.GetEffectivePermissionsAsync(id!.Value); _canCreate = p.Contains("HR.DEPARTMENT.CREATE"); _canUpdate = p.Contains("HR.DEPARTMENT.UPDATE"); _canDelete = p.Contains("HR.DEPARTMENT.DELETE"); _schema = await Db.GetHrSchemaOptionsAsync(); await ReloadAsync(); } } catch { Fail("Không thể tải phòng ban."); } finally { _loading = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — refresh rows after authorized successful writes.
    private async Task ReloadAsync() => _items = (await Db.GetDepartmentsAsync()).ToList();
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — preserve server id and row version when entering edit mode.
    private void BeginEdit(DepartmentRow d) { _message = null; _editing = new() { Id = d.Id, RowVersion = d.RowVersion, Code = d.Code, Name = d.Name, Description = d.Description, SortOrder = d.SortOrder, IsActive = d.IsActive }; }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — cancel edit without persistence.
    private void CancelEdit() => _editing = null;
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — recheck permission and prevent duplicate creates.
    private async Task CreateAsync() { if (_saving) return; _saving = true; using var scope = Loading.Begin("Đang lưu phòng ban..."); try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Create")) { Fail("Bạn không có quyền tạo phòng ban."); return; } _create.Code = DepartmentRules.NormalizeCode(_create.Code); var result = await Db.CreateDepartmentAsync(_create, id); Report(result, "Đã tạo phòng ban mới."); if (result == DepartmentWriteResult.Success) { await ReloadAsync(); _create = new() { IsActive = true }; } } catch { Fail("Không thể lưu phòng ban lúc này."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — update editable fields with the original row version and a write-time permission recheck.
    private async Task UpdateAsync() { if (_saving || _editing is null) return; _saving = true; using var scope = Loading.Begin("Đang cập nhật phòng ban..."); try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Update")) { Fail("Bạn không có quyền cập nhật phòng ban."); return; } if (!DepartmentRules.TryDecodeRowVersion(_editing.RowVersion, out var rv)) { Fail("Phiên bản dữ liệu không hợp lệ."); return; } _editing.Code = DepartmentRules.NormalizeCode(_editing.Code); var result = await Db.UpdateDepartmentAsync(_editing, rv, id); Report(result, "Đã cập nhật phòng ban."); if (result == DepartmentWriteResult.Success) { _editing = null; await ReloadAsync(); } } catch { Fail("Không thể cập nhật phòng ban lúc này."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — retain row-version and authorization checks for status mutation.
    private async Task ToggleAsync(DepartmentRow d) { if (_saving) return; _saving = true; using var scope = Loading.Begin("Đang cập nhật phòng ban..."); try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Update")) { Fail("Bạn không có quyền cập nhật phòng ban."); return; } if (!DepartmentRules.TryDecodeRowVersion(d.RowVersion, out var rv)) { Fail("Phiên bản dữ liệu không hợp lệ."); return; } var result = await Db.SetDepartmentActiveAsync(d.Id, !d.IsActive, rv, id); Report(result, "Đã cập nhật trạng thái."); if (result == DepartmentWriteResult.Success) await ReloadAsync(); } catch { Fail("Không thể cập nhật phòng ban."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — retain soft-delete dependency protection and write-time permission check.
    private async Task DeleteAsync(DepartmentRow d) { if (_saving) return; _saving = true; using var scope = Loading.Begin("Đang xóa phòng ban..."); try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Delete")) { Fail("Bạn không có quyền xóa phòng ban."); return; } if (!DepartmentRules.TryDecodeRowVersion(d.RowVersion, out var rv)) { Fail("Phiên bản dữ liệu không hợp lệ."); return; } var result = await Db.SoftDeleteDepartmentAsync(d.Id, rv, id); Report(result, "Đã xóa mềm phòng ban."); if (result == DepartmentWriteResult.Success) await ReloadAsync(); } catch { Fail("Không thể xóa phòng ban."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — expose a consistent operation failure.
    private void Fail(string text) { _success = false; _message = text; }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-008 — translate typed persistence outcomes without hiding conflicts.
    private void Report(DepartmentWriteResult r, string ok) { _success = r == DepartmentWriteResult.Success; _message = _success ? ok : r == DepartmentWriteResult.DuplicateCode ? "Mã phòng ban đã tồn tại." : r == DepartmentWriteResult.InvalidBranch ? "Vui lòng chọn chi nhánh đang hoạt động." : r == DepartmentWriteResult.HasDependencies ? "Không thể xóa phòng ban đang được sử dụng." : "Dữ liệu đã thay đổi, vui lòng tải lại."; }
}

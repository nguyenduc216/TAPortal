@page "/blazor/hr/departments"
@attribute [Authorize]
@inject PortalDb Db
@inject AuthenticationStateProvider Authentication
@inject GlobalLoadingService Loading
<PageTitle>Phòng ban - T.A Portal</PageTitle>
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Nhân sự</div><h1 class="ta-page-title">Phòng ban</h1></div></div>
@if (_loading) { <p class="text-secondary">Đang tải...</p> } else if (!_allowed) { <div class="alert alert-danger">Bạn không có quyền truy cập chức năng này.</div> } else { @if (_message is not null) { <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div> } <div class="row row-cards"><div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var d in _items) { <tr><td><code>@d.Code</code></td><td>@d.Name</td><td>@(d.Description ?? "—")</td><td>@d.SortOrder</td><td>@(d.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td>@if (_canUpdate) { <button class="btn btn-sm btn-outline-secondary" disabled="@_saving" @onclick="() => ToggleAsync(d)">@(d.IsActive ? "Ngừng" : "Kích hoạt")</button> } @if (_canDelete) { <button class="btn btn-sm btn-outline-danger" disabled="@_saving" @onclick="() => DeleteAsync(d)">Xóa</button> }</td></tr> }</tbody></table></div>@if (!_items.Any()) { <div class="card-body text-secondary">Chưa có phòng ban.</div>}</div></div>@if (_canCreate) { <div class="col-lg-4"><div class="card"><div class="card-header"><h2 class="card-title">Thêm phòng ban</h2></div><div class="card-body"><EditForm Model="_create" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary /><InputText class="form-control mb-2" @bind-Value="_create.Code" placeholder="Mã" /><InputText class="form-control mb-2" @bind-Value="_create.Name" placeholder="Tên" /><InputText class="form-control mb-2" @bind-Value="_create.Description" placeholder="Mô tả" /><InputNumber class="form-control mb-2" @bind-Value="_create.SortOrder" /><button class="btn btn-primary" disabled="@_saving">@(_saving ? "Đang lưu..." : "Lưu")</button></EditForm></div></div></div> }</div> }
@code {
    private List<DepartmentRow> _items = new(); private DepartmentCreateVm _create = new() { IsActive = true }; private bool _loading = true, _allowed, _canCreate, _canUpdate, _canDelete, _saving, _success; private string? _message;
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — resolve the circuit identity and function permissions from the server.
    private async Task<Guid?> UserIdAsync() { var user = (await Authentication.GetAuthenticationStateAsync()).User; return Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null; }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — load the existing department projection and action permissions.
    protected override async Task OnInitializedAsync() { using var scope = Loading.Begin("Đang tải phòng ban..."); try { var id = await UserIdAsync(); _allowed = id.HasValue && await Db.HasFunctionActionAsync(id.Value, "Departments.Index"); if (_allowed) { var p = await Db.GetEffectivePermissionsAsync(id!.Value); _canCreate = p.Contains("HR.DEPARTMENT.CREATE"); _canUpdate = p.Contains("HR.DEPARTMENT.UPDATE"); _canDelete = p.Contains("HR.DEPARTMENT.DELETE"); _items = (await Db.GetDepartmentsAsync()).ToList(); } } catch { _message = "Không thể tải phòng ban."; } finally { _loading = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — recheck permission and prevent duplicate writes before creating.
    private async Task CreateAsync() { if (_saving) return; _saving = true; using var scope = Loading.Begin("Đang lưu phòng ban..."); try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Create")) { Fail("Bạn không có quyền tạo phòng ban."); return; } _create.Code = DepartmentRules.NormalizeCode(_create.Code); var result = await Db.CreateDepartmentAsync(_create, id); Report(result, "Đã tạo phòng ban mới."); if (result == DepartmentWriteResult.Success) { _items = (await Db.GetDepartmentsAsync()).ToList(); _create = new() { IsActive = true }; } } catch { Fail("Không thể lưu phòng ban lúc này."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — use the server-provided row version for status mutation.
    private async Task ToggleAsync(DepartmentRow d) { if (_saving) return; _saving = true; try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Update")) { Fail("Bạn không có quyền cập nhật phòng ban."); return; } DepartmentRules.TryDecodeRowVersion(d.RowVersion, out var rv); Report(await Db.SetDepartmentActiveAsync(d.Id, !d.IsActive, rv, id), "Đã cập nhật trạng thái."); _items = (await Db.GetDepartmentsAsync()).ToList(); } catch { Fail("Không thể cập nhật phòng ban."); } finally { _saving = false; } }
    // CHANGE_ID: TAPORTAL-20261011-BLAZOR-MIGRATION-006 — retain MVC soft-delete/dependency behavior and permission check.
    private async Task DeleteAsync(DepartmentRow d) { if (_saving) return; _saving = true; try { var id = await UserIdAsync(); if (!id.HasValue || !await Db.HasFunctionActionAsync(id.Value, "Departments.Delete")) { Fail("Bạn không có quyền xóa phòng ban."); return; } DepartmentRules.TryDecodeRowVersion(d.RowVersion, out var rv); Report(await Db.SoftDeleteDepartmentAsync(d.Id, rv, id), "Đã xóa mềm phòng ban."); _items = (await Db.GetDepartmentsAsync()).ToList(); } catch { Fail("Không thể xóa phòng ban."); } finally { _saving = false; } }
    private void Fail(string text) { _success = false; _message = text; } private void Report(DepartmentWriteResult r, string ok) { _success = r == DepartmentWriteResult.Success; _message = _success ? ok : r == DepartmentWriteResult.DuplicateCode ? "Mã phòng ban đã tồn tại." : r == DepartmentWriteResult.HasDependencies ? "Không thể xóa phòng ban đang được sử dụng." : "Dữ liệu đã thay đổi, vui lòng tải lại."; }
}
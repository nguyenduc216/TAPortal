<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TAPortal.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content\post-library\*.json" LogicalName="TAPortal.postlib.%(Filename).json" />
    <!-- Cover photo of each ready-written article (NN = Order; CC0 photos from StockSnap via Openverse, 960x540). -->
    <EmbeddedResource Include="Content\post-library\covers\*.jpg" LogicalName="TAPortal.postcover.%(Filename).jpg" />
  </ItemGroup>
<ItemGroup><ProjectReference Include="../TAPortal.Shared/TAPortal.Shared.csproj" /><ProjectReference Include="..\TAPortal.Integrations\TAPortal.Integrations.csproj" /><ProjectReference Include="..\TAWebsite.Core\TAWebsite.Core.csproj" /></ItemGroup></Project>

@functions {
    // SYS_ADMIN sees everything; other accounts see only the items their permissions open (same rule as the policies).
    private bool Can(string code) => AdminPermissions.Has(User, code);

    private string CurrentController => ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    private bool IsCurrent(string controller, string? action = null) =>
        string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase));

    // Initial of the given name (last word of a Vietnamese full name), e.g. "Nguyễn Văn A" -> "A".
    private static string Initials(string? name)
    {
        var last = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        return string.IsNullOrEmpty(last) ? "TA" : last[..1].ToUpperInvariant();
    }
}
@{
    var isAdmin = User.IsInRole("SYS_ADMIN");
    var canDashboard = Can(AdminPermissions.DashboardView);
    var canCustomers = Can(AdminPermissions.CustomersView);
    var canReconciliation = Can(AdminPermissions.ReconciliationView);
    var canPackages = Can(AdminPermissions.PackagesView);
    var canPurchases = Can(AdminPermissions.PurchasesView);
    var canSandbox = Can(AdminPermissions.IntegrationsSandbox);
    var canLogs = Can(AdminPermissions.IntegrationsLogsView);
    var canNotifications = Can(AdminPermissions.NotificationsManage);
    var canUsers = Can(AdminPermissions.UsersView);
    var canRoles = Can(AdminPermissions.RolesView);
    var canMenus = Can(AdminPermissions.MenusManage);
    var canEmployees = Can(AdminPermissions.EmployeesView);
    var canDepartments = Can(AdminPermissions.DepartmentsView);
    var canTeams = Can(AdminPermissions.TeamsView);
    var canJobTitles = Can(AdminPermissions.JobTitlesView);
    var canWork = Can(AdminPermissions.TasksView);
    var canTaskTemplates = Can(AdminPermissions.TaskTemplatesManage);
    var canTaskReport = Can(AdminPermissions.TaskReportView);
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name;
    // Role names (never codes); "Người dùng TAPortal" only when no role name is known.
    var roleNames = User.FindAll("role_name").Select(c => c.Value).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct().ToList();
    var roleLabel = isAdmin ? "Quản trị hệ thống" : roleNames.Count > 0 ? string.Join(", ", roleNames) : "Người dùng TAPortal";
    var heading = ViewData["Heading"] as string ?? ViewData["Title"] as string;
    var parentTitle = ViewData["ParentTitle"] as string;
    var parentController = ViewData["ParentController"] as string;
    var parentAction = ViewData["ParentAction"] as string ?? "Index";
    var hideHeader = ViewData["HideHeader"] is true;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="ta-build" content="@TAPortal.Shared.BuildInfo.Id" data-url="@Url.Content("~" + TAPortal.Shared.BuildInfo.Path)" data-logo="@Url.Content("~/images/ta-logo.png")" />
    <title>@ViewData["Title"] - T.A Portal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/favicon-192x192.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#082746" />
    <link rel="stylesheet" href="~/lib/tabler/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ta-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ta-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ta-website.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <a class="ta-skip-link" href="#taMain">Bỏ qua đến nội dung chính</a>
    <aside class="ta-sidebar" id="taSidebar" aria-label="Điều hướng chính">
        <div class="ta-sidebar__brand">
            <a class="ta-brand" asp-controller="@(canWork ? "Work" : canDashboard ? "Home" : "Account")" asp-action="@(canWork || canDashboard ? "Index" : "Profile")" title="T.A Portal">
                <img src="~/images/ta-logo.png" class="ta-brand__logo" alt="" width="36" height="36" />
                <span class="ta-brand__text">T.A Portal</span>
            </a>
            <button type="button" class="ta-sidebar__close" data-ta-drawer-close aria-label="Đóng menu">@UiIcon.Render("x")</button>
        </div>
        <nav class="ta-nav" aria-label="Menu quản trị" id="taNav" data-ta-swap>
            @if (canDashboard)
            {
                <div class="ta-nav__group">
                    <ul class="ta-nav__list">
                        <li><a class="ta-nav__link" asp-controller="Home" asp-action="Index" title="Tổng quan" aria-current="@(IsCurrent("Home", "Index") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("layout-dashboard")</span><span class="ta-nav__label">Tổng quan</span></a></li>
                    </ul>
                </div>
            }
            @if (canWork || canTaskTemplates || canTaskReport)
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Công việc</p>
                    <ul class="ta-nav__list">
                        @if (canWork) {<li><a class="ta-nav__link" asp-controller="Work" asp-action="Index" title="Việc của tôi" aria-current="@(IsCurrent("Work", "Index") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("checks")</span><span class="ta-nav__label">Việc của tôi</span></a></li>
                        <li><a class="ta-nav__link" asp-controller="Work" asp-action="Tasks" title="Danh sách công việc" aria-current="@(IsCurrent("Work", "Tasks") || IsCurrent("Work", "Details") || IsCurrent("Work", "Create") || IsCurrent("Work", "Edit") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("list-tree")</span><span class="ta-nav__label">Danh sách công việc</span></a></li>}
                        @if (canTaskTemplates) {<li><a class="ta-nav__link" asp-controller="Work" asp-action="Templates" title="Việc lặp theo kỳ" aria-current="@(IsCurrent("Work", "Templates") || IsCurrent("Work", "TemplateCreate") || IsCurrent("Work", "TemplateEdit") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("refresh")</span><span class="ta-nav__label">Việc lặp theo kỳ</span></a></li>}
                        @if (canTaskReport) {<li><a class="ta-nav__link" asp-controller="Work" asp-action="Report" title="Báo cáo tiến độ" aria-current="@(IsCurrent("Work", "Report") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("chart-bar")</span><span class="ta-nav__label">Báo cáo tiến độ</span></a></li>}
                    </ul>
                </div>
            }
            @if (canCustomers || canReconciliation || Can(AdminPermissions.ContractsView))
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Quản lý khách hàng</p>
                    <ul class="ta-nav__list">
                        @* Customer Portal accounts are managed inside each customer's workspace (tab "Tài khoản Portal"). *@
                        @if (canCustomers) {<li><a class="ta-nav__link" asp-controller="Customers" asp-action="Index" title="Khách hàng" aria-current="@(IsCurrent("Customers") || IsCurrent("CustomerPortalAccounts") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("building")</span><span class="ta-nav__label">Khách hàng</span></a></li>}
                        @if (canReconciliation) {<li><a class="ta-nav__link" asp-controller="PaymentReconciliation" asp-action="Index" title="Đối soát giao dịch" aria-current="@(IsCurrent("PaymentReconciliation") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("report-money")</span><span class="ta-nav__label">Đối soát giao dịch</span></a></li>}
                        @if (Can(AdminPermissions.ContractsView)) {<li><a class="ta-nav__link" asp-controller="Contracts" asp-action="Index" title="Hợp đồng" aria-current="@(IsCurrent("Contracts") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("file-text")</span><span class="ta-nav__label">Hợp đồng</span></a></li>}
                    </ul>
                </div>
            }
            @if (Can(AdminPermissions.WebsiteView) || Can(AdminPermissions.WebsiteLeadsView))
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Website TA</p>
                    <ul class="ta-nav__list">
                        @if (Can(AdminPermissions.WebsiteView)) {<li><a class="ta-nav__link" asp-controller="Website" asp-action="Index" title="Trang &amp; nội dung" aria-current="@(IsCurrent("Website", "Index") || IsCurrent("Website", "Page") || IsCurrent("Website", "Section") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("layout-dashboard")</span><span class="ta-nav__label">Trang &amp; nội dung</span></a></li>
                        <li><a class="ta-nav__link" asp-controller="WebsitePosts" asp-action="Index" title="Bài viết" aria-current="@(IsCurrent("WebsitePosts") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("file-text")</span><span class="ta-nav__label">Bài viết</span></a></li>
                        <li><a class="ta-nav__link" asp-controller="WebsiteMedia" asp-action="Index" title="Thư viện ảnh" aria-current="@(IsCurrent("WebsiteMedia") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("photo")</span><span class="ta-nav__label">Thư viện ảnh</span></a></li>
                        <li><a class="ta-nav__link" asp-controller="Website" asp-action="Settings" title="Cài đặt chung" aria-current="@(IsCurrent("Website", "Settings") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("settings")</span><span class="ta-nav__label">Cài đặt chung</span></a></li>}
                        @if (Can(AdminPermissions.WebsiteLeadsView)) {<li><a class="ta-nav__link" asp-controller="WebsiteLeads" asp-action="Index" title="Liên hệ – báo giá" aria-current="@(IsCurrent("WebsiteLeads") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("inbox")</span><span class="ta-nav__label">Liên hệ – báo giá</span></a></li>}
                    </ul>
                </div>
            }
            @if (Can(AdminPermissions.InvoiceAppContentView))
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Hóa đơn tự động</p>
                    <ul class="ta-nav__list">
                        <li><a class="ta-nav__link" asp-controller="InvoiceAppContent" asp-action="Index" title="Mẫu email" aria-current="@(IsCurrent("InvoiceAppContent", "Index") || IsCurrent("InvoiceAppContent", "Email") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("mail")</span><span class="ta-nav__label">Mẫu email</span></a></li>
                        <li><a class="ta-nav__link" asp-controller="InvoiceAppContent" asp-action="Terms" title="Điều khoản dịch vụ" aria-current="@(IsCurrent("InvoiceAppContent", "Terms") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("file-text")</span><span class="ta-nav__label">Điều khoản dịch vụ</span></a></li>
                    </ul>
                </div>
            }
            @if (canEmployees || canDepartments || canTeams || canJobTitles)
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Nhân sự</p>
                    <ul class="ta-nav__list">
                        @if (canEmployees) {<li><a class="ta-nav__link" asp-controller="Employees" asp-action="Index" title="Nhân viên" aria-current="@(IsCurrent("Employees") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("id")</span><span class="ta-nav__label">Nhân viên</span></a></li>}
                        @if (canDepartments) {<li><a class="ta-nav__link" asp-controller="Departments" asp-action="Index" title="Phòng ban" aria-current="@(IsCurrent("Departments") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("building")</span><span class="ta-nav__label">Phòng ban</span></a></li>}
                        @if (canTeams) {<li><a class="ta-nav__link" asp-controller="Teams" asp-action="Index" title="Nhóm" aria-current="@(IsCurrent("Teams") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("users-group")</span><span class="ta-nav__label">Nhóm</span></a></li>}
                        @if (canJobTitles) {<li><a class="ta-nav__link" asp-controller="JobTitles" asp-action="Index" title="Chức danh" aria-current="@(IsCurrent("JobTitles") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("user-cog")</span><span class="ta-nav__label">Chức danh</span></a></li>}
                    </ul>
                </div>
            }
            @if (canPackages || canPurchases)
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Gói dịch vụ</p>
                    <ul class="ta-nav__list">
                        @if (canPackages) {<li><a class="ta-nav__link" asp-controller="ServicePackages" asp-action="Index" title="Danh sách gói" aria-current="@(IsCurrent("ServicePackages", "Index") || IsCurrent("ServicePackages", "Create") || IsCurrent("ServicePackages", "Edit") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("package")</span><span class="ta-nav__label">Danh sách gói</span></a></li>}
                        @if (canPurchases) {<li><a class="ta-nav__link" asp-controller="ServicePackages" asp-action="Purchases" title="Giao dịch mua gói" aria-current="@(IsCurrent("ServicePackages", "Purchases") || IsCurrent("ServicePackages", "Purchase") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("receipt-tax")</span><span class="ta-nav__label">Giao dịch mua gói</span></a></li>}
                    </ul>
                </div>
            }
            @if (canSandbox || canLogs || canNotifications)
            {
                <div class="ta-nav__group">
                    <p class="ta-nav__section">Tingee</p>
                    <ul class="ta-nav__list">
                        @if (canSandbox) {<li><a class="ta-nav__link" asp-controller="TingeeSandbox" asp-action="Index" title="Tingee Sandbox" aria-current="@(IsCurrent("TingeeSandbox") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("qrcode")</span><span class="ta-nav__label">Tingee Sandbox</span></a></li>
                        <li><a class="ta-nav__link" asp-controller="TingeeInvoiceSandbox" asp-action="Index" title="Hóa đơn Sandbox" aria-current="@(IsCurrent("TingeeInvoiceSandbox") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("file-invoice")</span><span class="ta-nav__label">Hóa đơn Sandbox</span></a></li>}
                        @if (canLogs) {<li><a class="ta-nav__link" asp-controller="TingeeLogs" asp-action="Index" title="Tingee log" aria-current="@(IsCurrent("TingeeLogs") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("history")</span><span class="ta-nav__label">Tingee log</span></a></li>}
                        @if (canNotifications) {<li><a class="ta-nav__link" asp-controller="NotificationSettings" asp-action="Index" title="Cài đặt thông báo" aria-current="@(IsCurrent("NotificationSettings") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("bell")</span><span class="ta-nav__label">Cài đặt thông báo</span></a></li>}
                    </ul>
                </div>
            }
            <div class="ta-nav__group">
                <p class="ta-nav__section">Quản lý hệ thống</p>
                <ul class="ta-nav__list">
                    @if (canUsers)
                    {
                        <li><a class="ta-nav__link" asp-controller="Users" asp-action="Index" title="Người dùng" aria-current="@(IsCurrent("Users") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("users")</span><span class="ta-nav__label">Người dùng</span></a></li>
                    }
                    @if (canRoles)
                    {
                        <li><a class="ta-nav__link" asp-controller="Roles" asp-action="Index" title="Vai trò &amp; phân quyền" aria-current="@(IsCurrent("Roles") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("shield-check")</span><span class="ta-nav__label">Vai trò &amp; phân quyền</span></a></li>
                    }
                    @if (canMenus)
                    {
                        <li><a class="ta-nav__link" asp-controller="Menus" asp-action="Index" title="Quản lý menu" aria-current="@(IsCurrent("Menus") ? "page" : null)"><span class="ta-nav__icon">@UiIcon.Render("list-tree")</span><span class="ta-nav__label">Quản lý menu</span></a></li>
                    }
                    <li><span class="ta-nav__link is-disabled" aria-disabled="true" title="Cấu hình hệ thống — chức năng chưa triển khai"><span class="ta-nav__icon">@UiIcon.Render("settings")</span><span class="ta-nav__label">Cấu hình hệ thống</span><span class="ta-nav__badge">Sắp có</span></span></li>
                    <li><span class="ta-nav__link is-disabled" aria-disabled="true" title="Nhật ký hoạt động — chức năng chưa triển khai"><span class="ta-nav__icon">@UiIcon.Render("file-text")</span><span class="ta-nav__label">Nhật ký hoạt động</span><span class="ta-nav__badge">Sắp có</span></span></li>
                </ul>
            </div>
        </nav>
    </aside>
    <div class="ta-overlay" data-ta-drawer-close hidden></div>
    <div class="ta-main">
        <header class="ta-topbar">
            <button type="button" class="ta-icon-btn" data-ta-sidebar-toggle aria-controls="taSidebar" aria-expanded="true" aria-label="Thu gọn/mở rộng menu">@UiIcon.Render("menu-2")</button>
            <nav class="ta-breadcrumb" aria-label="Breadcrumb" id="taCrumbs" data-ta-swap>
                <ol>
                    <li>@if (canDashboard) {<a asp-controller="Home" asp-action="Index" aria-label="Tổng quan">@UiIcon.Render("home")</a>} else {@UiIcon.Render("home")}</li>
                    @if (parentTitle is not null && parentController is not null) {<li><a asp-controller="@parentController" asp-action="@parentAction">@parentTitle</a></li>}
                    <li><span aria-current="page">@ViewData["Title"]</span></li>
                </ol>
            </nav>
            <div class="dropdown ms-auto">
                <a href="#" class="ta-user" data-bs-toggle="dropdown" role="button" aria-expanded="false" aria-label="Tài khoản: @displayName">
                    <span class="ta-avatar" aria-hidden="true">@Initials(displayName)</span>
                    <span class="ta-user__text"><span class="ta-user__name d-block">@displayName</span><span class="ta-user__role d-block">@roleLabel</span></span>
                    @UiIcon.Render("chevron-down", "text-secondary")
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <div class="dropdown-header">Đăng nhập với <strong>@User.Identity?.Name</strong></div>
                    <a asp-controller="Account" asp-action="Profile" class="dropdown-item">@UiIcon.Render("user-circle")<span>Hồ sơ cá nhân</span></a>
                    <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item">@UiIcon.Render("key")<span>Đổi mật khẩu</span></a>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger" type="submit" data-ta-loading data-ta-loading-text="Đang đăng xuất...">@UiIcon.Render("logout")<span>Đăng xuất</span></button></form>
                </div>
            </div>
        </header>
        <main id="taMain" class="ta-content ta-page-enter" tabindex="-1" data-ta-swap>
            @if (!hideHeader)
            {
                <div class="ta-page-head">
                    @if (ViewData["PageIcon"] is string pageIcon) {<div class="ta-page-head__icon" aria-hidden="true">@UiIcon.Render(pageIcon)</div>}
                    <div class="ta-page-head__text">
                        <h1 class="ta-page-title">@heading</h1>
                        @if (ViewData["Subtitle"] is string subtitle) {<p class="ta-page-sub">@subtitle</p>}
                    </div>
                    @if (IsSectionDefined("PageActions")) {<div class="ta-page-head__actions">@RenderSection("PageActions")</div>}
                </div>
            }
            @if (TempData["Success"] is string success) {<div class="ta-alert ta-alert--success" role="status" data-ta-toast>@UiIcon.Render("circle-check")<div class="ta-alert__body">@success</div></div>}
            @if (TempData["Error"] is string error) {<div class="ta-alert ta-alert--danger" role="alert" data-ta-toast>@UiIcon.Render("alert-circle")<div class="ta-alert__body">@error</div></div>}
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}
<template id="taIconSearch">@UiIcon.Render("search")</template>
<template id="taIconCheck">@UiIcon.Render("check", "ta-select__check")</template>
<script src="~/lib/tabler/tabler.min.js" asp-append-version="true"></script>
<script src="~/js/ta-update.js" asp-append-version="true"></script>
<script src="~/js/ta-shell.js" asp-append-version="true"></script>
<script src="~/js/ta-portal.js" asp-append-version="true"></script>
@* Loaded on every page: the shell swaps <main> without running page scripts; it initialises on ta:load and is idle elsewhere. *@
<script src="~/js/ta-tingee-sandbox.js" asp-append-version="true"></script>
<script src="~/js/ta-work.js" asp-append-version="true"></script>
<script src="~/js/ta-website.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using System.Security.Claims
@{ var isAuthenticated = User.Identity?.IsAuthenticated == true; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - T.A Portal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" /><meta name="theme-color" content="#092f52" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta21/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/ta-portal.css" asp-append-version="true" />
</head>
<body class="layout-fluid">
<div class="ta-global-progress" data-ta-progress role="progressbar" aria-label="Đang tải trang" aria-hidden="true"><span></span></div>
@if (isAuthenticated)
{
    <div class="page ta-app-shell">
        <partial name="_Sidebar" />
        <div class="page-wrapper ta-shell-main">
            <partial name="_Topbar" />
            <main class="page-body ta-page-content ta-page-enter" id="main-content"><div class="container-xl">
                @if (TempData["Success"] is string success) { <div class="alert alert-success ta-alert" role="status"><i class="ti ti-circle-check"></i><span>@success</span></div> }
                @if (TempData["Error"] is string error) { <div class="alert alert-danger ta-alert" role="alert"><i class="ti ti-alert-circle"></i><span>@error</span></div> }
                @RenderBody()
            </div></main>
        </div>
        <button class="ta-mobile-backdrop" type="button" data-ta-sidebar-close aria-label="Đóng điều hướng"></button>
    </div>
}
else { @RenderBody() }
<script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta21/dist/js/tabler.min.js"></script>
<script src="~/js/ta-portal.js" asp-append-version="true"></script>
<script src="~/js/taportal-reconnect.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

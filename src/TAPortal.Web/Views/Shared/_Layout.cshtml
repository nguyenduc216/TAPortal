<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - T.A Portal</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/favicon-192x192.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#07345c" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta21/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/ta-portal.css" asp-append-version="true" />
</head>
<body class="layout-fluid">
<div class="ta-global-progress" data-ta-progress role="progressbar" aria-label="Đang tải trang" aria-hidden="true"><span></span></div>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="page">
        <aside class="navbar navbar-vertical navbar-expand-lg ta-sidebar" data-bs-theme="dark">
            <div class="container-fluid">
                <h1 class="navbar-brand navbar-brand-autodark">
                    <a asp-controller="Home" asp-action="Index" class="ta-brand text-decoration-none">
                        <img src="~/images/ta-logo.png" class="ta-sidebar-logo" alt="T.A" onerror="this.classList.add('d-none');document.getElementById('sideLogoFallback').classList.remove('d-none');" />
                        <span id="sideLogoFallback" class="ta-logo-mark d-none">T<span>A</span><i></i></span>
                        <span class="ms-2">T.A Portal</span>
                    </a>
                </h1>
                <div class="collapse navbar-collapse show">
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><span class="nav-link-icon"><i class="ti ti-layout-dashboard"></i></span><span class="nav-link-title">Tổng quan</span></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index"><span class="nav-link-icon"><i class="ti ti-building-store"></i></span><span class="nav-link-title">Khách hàng</span></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><span class="nav-link-icon"><i class="ti ti-users"></i></span><span class="nav-link-title">Người dùng</span></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Roles" asp-action="Index"><span class="nav-link-icon"><i class="ti ti-shield-lock"></i></span><span class="nav-link-title">Vai trò &amp; phân quyền</span></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Menus" asp-action="Index"><span class="nav-link-icon"><i class="ti ti-list-details"></i></span><span class="nav-link-title">Quản lý menu</span></a></li>
                        <li class="nav-item"><a class="nav-link" href="#"><span class="nav-link-icon"><i class="ti ti-settings"></i></span><span class="nav-link-title">Cấu hình hệ thống</span></a></li>
                        <li class="nav-item"><a class="nav-link" href="#"><span class="nav-link-icon"><i class="ti ti-history"></i></span><span class="nav-link-title">Nhật ký hoạt động</span></a></li>
                    </ul>
                </div>
            </div>
        </aside>
        <div class="page-wrapper">
            <header class="navbar navbar-expand-md d-print-none ta-topbar">
                <div class="container-xl">
                    <div class="navbar-nav flex-row order-md-last ms-auto">
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown">
                                <span class="avatar avatar-sm ta-avatar">TA</span>
                                <div class="d-none d-xl-block ps-2">
                                    <div>@(User.FindFirst("display_name")?.Value ?? User.Identity?.Name)</div>
                                    <div class="mt-1 small text-secondary">@string.Join(", ", User.Claims.Where(x => x.Type == System.Security.Claims.ClaimTypes.Role).Select(x => x.Value))</div>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <a asp-controller="Account" asp-action="Profile" class="dropdown-item"><i class="ti ti-user-circle"></i><span>Hồ sơ cá nhân</span></a>
                                <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item"><i class="ti ti-key"></i><span>Đổi mật khẩu</span></a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger" type="submit" data-ta-loading data-ta-loading-text="Đang đăng xuất..."><i class="ti ti-logout"></i><span>Đăng xuất</span></button></form>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <main class="page-body ta-page-content ta-page-enter">
                <div class="container-xl">
                    @if (TempData["Success"] is string success) { <div class="alert alert-success ta-alert" role="status"><i class="ti ti-circle-check" aria-hidden="true"></i><span>@success</span></div> }
                    @if (TempData["Error"] is string error) { <div class="alert alert-danger ta-alert" role="alert"><i class="ti ti-alert-circle" aria-hidden="true"></i><span>@error</span></div> }
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}
<script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta21/dist/js/tabler.min.js"></script>
<script src="~/js/ta-portal.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

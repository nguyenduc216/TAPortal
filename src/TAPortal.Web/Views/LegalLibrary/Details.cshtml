@model LegalDocumentDetail
@{
    var d = Model.Document;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string Day(DateTime? x) => x?.ToString("dd/MM/yyyy", vi) ?? "—";
    string When(DateTime x) => x.ToLocalTime().ToString("dd/MM/yyyy HH:mm", vi);
    ViewData["ParentTitle"] = "Kho văn bản pháp luật";
    ViewData["ParentController"] = "LegalLibrary";
    ViewData["Title"] = d.DocumentNo;
    ViewData["Heading"] = d.Title;
    ViewData["Subtitle"] = $"{ContractReviewPolicy.Label(LegalLibraryPolicy.Types, d.DocType)} số {d.DocumentNo} · {Model.Articles.Count} điều";
    ViewData["PageIcon"] = "list-tree";
    var canManage = AdminPermissions.Has(User, AdminPermissions.LegalLibraryManage);
}
@section PageActions {
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@d.Id">@UiIcon.Render("pencil")<span>Sửa thông tin</span></a>
        <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline" data-ta-confirm="Xóa văn bản @d.DocumentNo khỏi kho? AI sẽ không trích dẫn văn bản này nữa.">
            <button type="submit" class="btn btn-outline-danger">@UiIcon.Render("trash")<span>Xóa</span></button>
        </form>
    }
}
<div class="row g-4">
    <div class="col-xl-4 d-flex flex-column gap-4">
        <section class="card">
            <div class="card-body">
                <dl class="ta-dl">
                    <dt>Số hiệu</dt><dd><span class="ta-code">@d.DocumentNo</span></dd>
                    <dt>Ngày ban hành</dt><dd>@Day(d.IssuedDate)</dd>
                    <dt>Ngày hiệu lực</dt><dd>@Day(d.EffectiveDate)</dd>
                    <dt>Hết hiệu lực</dt><dd>@Day(d.ExpiredDate)</dd>
                    <dt>Tình trạng</dt><dd>@(d.IsInForce(DateTime.Today) ? "Còn hiệu lực – AI được trích dẫn" : "Chưa/hết hiệu lực – AI không dùng")</dd>
                    @if (d.Note is not null) {<dt>Ghi chú</dt><dd>@d.Note</dd>}
                </dl>
            </div>
        </section>

        <section class="card" aria-labelledby="lawFilesTitle" data-ta-legal-files>
            <div class="card-header"><h2 class="card-title" id="lawFilesTitle">@UiIcon.Render("file-invoice")File nguồn</h2><span class="ta-badge ta-badge--neutral ta-badge--plain ms-auto">@Model.Files.Count file</span></div>
            @if (Model.Files.Count == 0)
            {
                <div class="card-body"><p class="text-secondary mb-0">Văn bản này được nhập bằng cách dán toàn văn, chưa có file.</p></div>
            }
            else
            {
                <ul class="ta-list">
                    @foreach (var f in Model.Files)
                    {
                        <li class="d-block" data-ta-legal-file="@(f.IsCurrent ? "current" : "old")">
                            <div class="d-flex gap-2 align-items-start">
                                <a asp-action="Download" asp-route-id="@d.Id" asp-route-fileId="@f.Id" download data-ta-hard>@UiIcon.Render("file-text")<span class="ms-1">@f.FileName</span></a>
                                @if (f.IsCurrent) {<span class="ms-auto ta-badge ta-badge--success ta-badge--plain">Đang dùng</span>}
                            </div>
                            <div class="ta-cell-sub">@f.ArticleCount điều · @ContractPolicy.Size(f.SizeBytes) · @(f.CreatedByName ?? "—") · @When(f.CreatedAt)</div>
                            @if (canManage && !f.IsCurrent)
                            {
                                <form asp-action="Reimport" asp-route-id="@d.Id" method="post" class="mt-1" data-ta-confirm="Dùng lại file @f.FileName? Toàn bộ các điều hiện tại (kể cả điều đã sửa tay) sẽ được thay bằng nội dung file này.">
                                    <input type="hidden" name="fileId" value="@f.Id" />
                                    <button type="submit" class="btn btn-sm">@UiIcon.Render("refresh")<span>Dùng lại file này</span></button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            @if (canManage)
            {
                <form class="card-footer d-flex flex-column gap-2" asp-action="Upload" asp-route-id="@d.Id" method="post" enctype="multipart/form-data" data-ta-hard data-ta-legal-upload
                      data-ta-confirm="Cập nhật văn bản bằng file mới? Toàn bộ các điều hiện tại sẽ được thay; file cũ vẫn được giữ trong lịch sử.">
                    <label class="form-label mb-0" for="lawUpload">Cập nhật bằng file mới</label>
                    <div class="ta-input-icon">@UiIcon.Render("upload")<input id="lawUpload" class="form-control" type="file" name="file" accept="@LegalFileText.Accept" required /></div>
                    <button type="submit" class="btn btn-primary" data-ta-loading data-ta-loading-text="Đang đọc file...">@UiIcon.Render("upload")<span>Tải lên và cập nhật</span></button>
                    <div class="form-hint mt-0">Word .docx, PDF có chữ hoặc .txt, tối đa 20 MB. Dùng khi luật được sửa đổi hoặc có bản hợp nhất mới.</div>
                </form>
            }
        </section>
    </div>
    <div class="col-xl-8">
        <section class="card" aria-label="Các điều" data-ta-legal-articles>
            <ul class="ta-list">
                @foreach (var a in Model.Articles)
                {
                    <li class="d-block" id="a-@a.Id">
                        <details>
                            <summary><span class="ta-cell-strong">@a.ArticleNo</span>@if (a.Title is not null) {<span>. @a.Title</span>}@if (a.UpdatedAt is DateTime u) {<span class="ta-badge ta-badge--info ta-badge--plain ms-2">Đã sửa tay @When(u)</span>}</summary>
                            <div class="mt-2 ta-law-text">
                                @foreach (var line in a.Content.Split('\n'))
                                {
                                    var km = System.Text.RegularExpressions.Regex.Match(line, @"^\s*(\d+)\.\s");
                                    var dm = System.Text.RegularExpressions.Regex.Match(line, @"^\s*([a-zđ])\)\s");
                                    <span class="ta-law-line" data-k="@(km.Success ? km.Groups[1].Value : null)" data-d="@(dm.Success ? dm.Groups[1].Value : null)">@line</span>
                                }
                            </div>
                            @if (canManage)
                            {
                                <details class="mt-2">
                                    <summary class="text-secondary">@UiIcon.Render("pencil") Sửa điều này</summary>
                                    <form asp-action="UpdateArticle" asp-route-id="@d.Id" method="post" class="mt-2 d-flex flex-column gap-2">
                                        <input type="hidden" name="articleId" value="@a.Id" />
                                        <div class="ta-input-icon">@UiIcon.Render("file-text")<input class="form-control" name="title" value="@a.Title" maxlength="500" placeholder="Tên điều" aria-label="Tên điều" /></div>
                                        <div class="ta-input-icon ta-input-icon--top">@UiIcon.Render("pencil")<textarea class="form-control" name="content" rows="8" required aria-label="Nội dung điều">@a.Content</textarea></div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-sm btn-primary">@UiIcon.Render("device-floppy")<span>Lưu</span></button>
                                        </div>
                                    </form>
                                    <form asp-action="DeleteArticle" asp-route-id="@d.Id" method="post" class="mt-2" data-ta-confirm="Xóa @a.ArticleNo khỏi kho?">
                                        <input type="hidden" name="articleId" value="@a.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@UiIcon.Render("trash")<span>Xóa điều này</span></button>
                                    </form>
                                </details>
                            }
                        </details>
                    </li>
                }
            </ul>
        </section>
    </div>
</div>

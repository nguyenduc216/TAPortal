@model IReadOnlyList<PortalMenu>
@{
    ViewData["Title"] = "Quản lý menu";
    ViewData["Heading"] = "Quản lý menu hệ thống";
    ViewData["Subtitle"] = "Menu được lưu trong database và gắn với permission.";
    ViewData["PageIcon"] = "list-tree";
}
<section class="card ta-table-card" aria-label="Danh sách menu">
    <div class="ta-table-toolbar">
        <div class="ta-search">@UiIcon.Render("search")<input class="form-control" type="search" aria-label="Tìm menu" placeholder="Tìm theo mã, tên hoặc route menu..." oninput="taFilterRows(this.value,'menusTable')" /></div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("list-tree")</span><p class="ta-empty__title">Chưa có menu</p></div>
    }
    else
    {
        <div class="ta-table-wrap">
            <table class="ta-table ta-table-stack" id="menusTable">
                <thead><tr><th scope="col">Mã menu</th><th scope="col">Tên menu</th><th scope="col">Route</th><th scope="col">Icon</th><th scope="col">Thứ tự</th><th scope="col">Hiển thị</th><th scope="col">Trạng thái</th></tr></thead>
                <tbody>
                @foreach (var x in Model)
                {
                    <tr data-ta-row><td data-label="Mã menu"><span class="ta-code">@x.Code</span></td><td class="ta-cell-strong">@x.Name</td><td class="ta-nowrap" data-label="Route">@x.Route</td><td data-label="Icon">@x.Icon</td><td data-label="Thứ tự">@x.SortOrder</td><td data-label="Hiển thị">@(x.IsVisible ? "Có" : "Không")</td><td data-label="Trạng thái"><span class="ta-badge @(x.IsActive ? "ta-badge--success" : "ta-badge--neutral")">@(x.IsActive ? "Hoạt động" : "Ngừng")</span></td></tr>
                }
                </tbody>
            </table>
        </div>
        <div class="ta-empty d-none" data-ta-no-results><span class="ta-empty__icon">@UiIcon.Render("search-off")</span><p class="ta-empty__title">Không tìm thấy kết quả phù hợp</p></div>
        <div class="ta-table-footer"><span>Hiển thị <strong data-ta-visible-count>@Model.Count</strong> / @Model.Count menu</span></div>
    }
</section>

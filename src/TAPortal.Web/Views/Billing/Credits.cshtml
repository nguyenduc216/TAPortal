@model IReadOnlyList<CreditWalletRow>
@{ViewData["Title"]="Số dư Credit";}<div class="page-header"><h2 class="page-title">Số dư Credit</h2><div class="text-secondary">Credit ngân hàng và hóa đơn theo đối tác.</div></div><div class="card ta-table-card mt-2"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Đối tác</th><th>Loại Credit</th><th class="text-end">Khả dụng</th><th class="text-end">Đang giữ</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.PartnerName</strong></td><td><span class="badge bg-blue-lt">@x.CreditType</span></td><td class="text-end fw-semibold">@x.CurrentBalance.ToString("N0.##")</td><td class="text-end">@x.ReservedBalance.ToString("N0.##")</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="ta-table-empty"><i class="ti ti-coins"></i>Chưa có ví Credit.</div>}</div>
@model TeamPageVm
@{ ViewData["Title"] = "Team"; }
<div class="ta-page-header">
 <div class="ta-page-heading"><div class="ta-page-pretitle"><i class="ti ti-users-group me-1"></i>Nhân sự / Team</div><h1 class="ta-page-title">Team</h1><p class="ta-page-subtitle">Quản lý các nhóm làm việc thuộc phòng ban.</p></div>
 @if(Model.CanCreate){<div class="ta-page-actions"><button class="btn btn-ta-gold" type="button" data-bs-toggle="modal" data-bs-target="#teamCreate"><i class="ti ti-plus"></i>Thêm Team</button></div>}
</div>
<div class="card ta-table-card">
 <div class="card-header ta-toolbar"><div class="ta-team-filters"><div class="input-icon ta-search-compact"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input id="teamSearch" class="form-control" type="search" aria-label="Tìm Team" placeholder="Tìm theo mã hoặc tên Team..." oninput="taFilterTeams()" /></div><select id="teamDepartmentFilter" class="form-select" aria-label="Lọc phòng ban" onchange="taFilterTeams()"><option value="">Tất cả phòng ban</option>@foreach(var department in Model.Departments){<option value="@department.Id">@department.Code – @department.Name</option>}</select></div><span class="badge bg-blue-lt"><i class="ti ti-hierarchy-2 me-1"></i>@Model.Teams.Count Team</span></div>
 <div class="table-responsive"><table class="table table-vcenter card-table ta-team-table" id="teamsTable"><thead><tr><th>Mã</th><th>Tên Team</th><th>Phòng ban</th><th>Team cha</th><th>Mô tả</th><th class="text-center">Thứ tự</th><th>Trạng thái</th><th>Cập nhật</th>@if(Model.CanUpdate||Model.CanDelete){<th class="text-end">Thao tác</th>}</tr></thead><tbody>
 @foreach(var team in Model.Teams){var key=team.Id.ToString("N");<tr data-ta-row data-department-id="@team.DepartmentId"><td><code class="ta-code">@team.Code</code></td><td><div class="d-flex align-items-center gap-2"><span class="ta-menu-icon"><i class="ti ti-hierarchy-2"></i></span><strong>@team.Name</strong></div></td><td><span class="badge bg-azure-lt">@team.DepartmentCode</span><span class="ms-1">@team.DepartmentName</span></td><td>@if(team.ParentTeamId.HasValue){<span class="ta-parent-team"><i class="ti ti-corner-down-right"></i>@team.ParentTeamCode – @team.ParentTeamName</span>}else{<span class="text-secondary">—</span>}</td><td class="text-secondary ta-team-description">@(team.Description??"—")</td><td class="text-center">@team.SortOrder</td><td><span class="badge @(team.IsActive?"badge-ta-active":"bg-secondary-lt")">@(team.IsActive?"Hoạt động":"Ngừng hoạt động")</span></td><td><span class="text-secondary">@team.LastChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>@if(Model.CanUpdate||Model.CanDelete){<td class="text-end"><div class="btn-list flex-nowrap justify-content-end">@if(Model.CanUpdate){<button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#edit-@key"><i class="ti ti-edit"></i><span class="d-none d-xl-inline">Sửa</span></button><form asp-action="ToggleStatus" method="post" class="d-inline"><input type="hidden" name="Id" value="@team.Id"/><input type="hidden" name="RowVersion" value="@team.RowVersion"/><input type="hidden" name="IsActive" value="@(!team.IsActive)"/><button class="btn btn-sm btn-outline-secondary ta-btn-icon" type="submit" data-ta-loading title="@(team.IsActive?"Ngừng hoạt động":"Kích hoạt")"><i class="ti @(team.IsActive?"ti-player-pause":"ti-player-play")"></i></button></form>}@if(Model.CanDelete){<button class="btn btn-sm btn-outline-danger ta-btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#delete-@key"><i class="ti ti-trash"></i></button>}</div></td>}</tr>}
 </tbody></table></div>
 @if(Model.Teams.Count==0){<div class="ta-table-empty"><i class="ti ti-hierarchy-2"></i>Chưa có Team.</div>}<div class="ta-table-empty d-none" data-ta-no-results><i class="ti ti-search-off"></i>Không tìm thấy Team phù hợp.</div>
</div>
@if(Model.CanCreate){<div class="modal fade ta-crud-modal" id="teamCreate" tabindex="-1" aria-labelledby="teamCreateTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post"><div class="modal-header"><h2 class="modal-title" id="teamCreateTitle"><i class="ti ti-hierarchy-2"></i>Thêm Team</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><partial name="_TeamFields" model='new TeamFormVm(new TeamCreateVm { IsActive=true },Model.Departments,Model.ParentTeams)' /></div><div class="modal-footer"><button class="btn me-auto" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit" data-ta-loading data-ta-loading-text="Đang lưu..."><i class="ti ti-device-floppy"></i>Lưu Team</button></div></form></div></div></div>}
@foreach(var team in Model.Teams){var key=team.Id.ToString("N");if(Model.CanUpdate){<div class="modal fade ta-crud-modal" id="edit-@key" tabindex="-1" aria-labelledby="edit-title-@key" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form asp-action="Update" method="post"><input type="hidden" name="Id" value="@team.Id"/><input type="hidden" name="RowVersion" value="@team.RowVersion"/><div class="modal-header"><h2 class="modal-title" id="edit-title-@key"><i class="ti ti-edit"></i>Sửa Team @team.Code</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><partial name="_TeamFields" model='new TeamFormVm(new TeamCreateVm { DepartmentId=team.DepartmentId,ParentTeamId=team.ParentTeamId,Code=team.Code,Name=team.Name,Description=team.Description,SortOrder=team.SortOrder,IsActive=team.IsActive },Model.Departments,Model.ParentTeams,team.Id)' /></div><div class="modal-footer"><button class="btn me-auto" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit" data-ta-loading>Cập nhật</button></div></form></div></div></div>}if(Model.CanDelete){<div class="modal fade ta-crud-modal" id="delete-@key" tabindex="-1" aria-labelledby="delete-title-@key" aria-hidden="true"><div class="modal-dialog modal-sm"><div class="modal-content"><form asp-action="Delete" method="post"><input type="hidden" name="Id" value="@team.Id"/><input type="hidden" name="RowVersion" value="@team.RowVersion"/><div class="modal-body text-center py-4"><span class="ta-confirm-icon"><i class="ti ti-trash"></i></span><h2 class="h3 mt-3" id="delete-title-@key">Xóa Team?</h2><p>Bạn có chắc muốn xóa Team <strong>@team.Code – @team.Name</strong>?</p><p class="text-secondary small mb-0">Không thể xóa nếu Team đang có Team con hoặc nhân viên đang được phân công.</p></div><div class="modal-footer"><button class="btn" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-danger" type="submit" data-ta-loading>Xóa mềm</button></div></form></div></div></div>}}

@model TeamFormVm
<div class="row g-3" data-ta-team-form>
    <div class="col-sm-5"><label class="form-label">Mã Team <span class="text-danger">*</span></label><input class="form-control text-uppercase" name="Code" value="@Model.Value.Code" maxlength="50" required autocomplete="off" placeholder="VD: KT-SME" /></div>
    <div class="col-sm-7"><label class="form-label">Tên Team <span class="text-danger">*</span></label><input class="form-control" name="Name" value="@Model.Value.Name" maxlength="250" required placeholder="VD: SME" /></div>
    <div class="col-sm-6"><label class="form-label">Phòng ban <span class="text-danger">*</span></label><select class="form-select" name="DepartmentId" required data-ta-team-department><option value="">Chọn phòng ban</option>@foreach(var department in Model.Departments){<option value="@department.Id" selected="@(department.Id==Model.Value.DepartmentId)">@department.Code – @department.Name</option>}</select></div>
    <div class="col-sm-6"><label class="form-label">Team cha</label><select class="form-select" name="ParentTeamId" data-ta-team-parent><option value="">Không có Team cha</option>@foreach(var parent in Model.ParentTeams.Where(x=>x.Id!=Model.EditingId)){<option value="@parent.Id" data-department-id="@parent.DepartmentId" selected="@(parent.Id==Model.Value.ParentTeamId)">@parent.Code – @parent.Name</option>}</select></div>
    <div class="col-12"><label class="form-label">Mô tả</label><textarea class="form-control" name="Description" rows="3" maxlength="1000" placeholder="Mô tả ngắn về Team">@Model.Value.Description</textarea></div>
    <div class="col-sm-5"><label class="form-label">Thứ tự</label><input class="form-control" name="SortOrder" type="number" min="0" max="9999" value="@Model.Value.SortOrder" /></div>
    <div class="col-sm-7 d-flex align-items-end"><label class="form-check form-switch mb-2"><input type="hidden" name="IsActive" value="false"/>@if(Model.Value.IsActive){<input class="form-check-input" name="IsActive" type="checkbox" value="true" checked/>}else{<input class="form-check-input" name="IsActive" type="checkbox" value="true"/>}<span class="form-check-label">Đang hoạt động</span></label></div>
</div>

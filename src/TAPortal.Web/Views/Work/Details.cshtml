@model WorkDetailsVm
@inject IWorkCatalogStore WorkCatalog
@inject IEmployeePhotoStore AvatarPhotos
@{
    var guides = await WorkCatalog.GuidesAsync();
    var avatars = await AvatarPhotos.IndexAsync();
    var docs = Model.Documents;
    var docTab = TempData["TaskTab"] as string == "documents";
    string Size(int bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";
    string DocIcon(WorkDocument x) => x.Kind switch { "PDF" => "file-text", "Word" => "file-text", "Excel" => "report-money", _ => "photo" };
    var d = Model.Detail;
    var t = d.Task;
    ViewData["Title"] = t.TaskNo;
    ViewData["Heading"] = t.Title;
    ViewData["PageIcon"] = "checks";
    ViewData["ParentTitle"] = "Việc của tôi";
    ViewData["ParentController"] = "Work";
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string Local(DateTime utc) => WorkClock.Local(utc).ToString("HH:mm dd/MM/yyyy", vi);
    var returnUrl = Url.Action("Details", new { id = t.Id })!;
    var overdue = WorkTaskPolicy.IsOverdue(t.Status, t.DueDate, Model.Today);
    var closed = t.Status == WorkTaskPolicy.Cancelled;
    ViewData["Subtitle"] = $"{t.TaskNo} · tạo bởi {d.CreatedByName ?? "hệ thống"} lúc {Local(t.CreatedAt)}" + (d.TemplateTitle is null ? "" : $" · việc lặp “{d.TemplateTitle}”");
    string Event(WorkActivity a) => a.Kind switch
    {
        "CREATED" => a.Body ?? "Tạo công việc",
        "STATUS" => $"Trạng thái: {WorkTaskPolicy.StatusLabel(a.StatusFrom)} → {WorkTaskPolicy.StatusLabel(a.StatusTo)}",
        _ => a.Body ?? a.Kind
    };
}
@section PageActions {
    @if (d.CanEdit)
    {
        <a class="btn" asp-action="Edit" asp-route-id="@t.Id">@UiIcon.Render("pencil")<span>Sửa / giao lại</span></a>
        <form method="post" asp-action="Delete" asp-route-id="@t.Id" class="d-inline" onsubmit="return confirm('Xóa công việc này?');"><button class="btn btn-outline-danger" type="submit">@UiIcon.Render("trash")<span>Xóa</span></button></form>
    }
}
<div class="ta-ws-grid ta-task-detail">
    <section class="card" aria-labelledby="infoTitle">
        <div class="card-header"><h2 class="card-title" id="infoTitle">@UiIcon.Render("info-circle")Thông tin</h2></div>
        <div class="card-body">
            <dl class="ta-dl">
                <dt>Trạng thái</dt>
                <dd>
                    <form class="ta-task__status" method="post" asp-action="Status" asp-route-id="@t.Id">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <select class="form-select form-select-sm w-auto" name="status" aria-label="Trạng thái" data-ta-autosubmit>
                            @foreach (var s in WorkTaskPolicy.Statuses.Where(s => s != WorkTaskPolicy.Cancelled || d.CanEdit || closed)) {<option value="@s" selected="@(s == t.Status)">@WorkTaskPolicy.StatusLabel(s)</option>}
                        </select>
                        <noscript><button class="btn btn-sm" type="submit">Lưu</button></noscript>
                        <div class="ta-task__done-note" data-ta-done-note hidden>
            <label class="form-label mb-0" for="dn-@t.Id">Ghi chú kết quả (bắt buộc khi hoàn thành)</label>
            <div class="ta-input-icon ta-input-icon--top">@UiIcon.Render("file-text")<textarea class="form-control form-control-sm" id="dn-@t.Id" name="note" rows="2" maxlength="@(WorkTaskPolicy.CommentMax - WorkTaskPolicy.DoneNotePrefix.Length)" placeholder="Đã làm gì, kết quả ra sao..." data-ta-voice></textarea></div>
            <div class="ta-task__done-actions"><button class="btn btn-sm btn-primary" type="submit">@UiIcon.Render("check")Xác nhận hoàn thành</button><button class="btn btn-sm" type="button" data-ta-done-cancel>Hủy</button></div>
        </div>
                    </form>
                </dd>
                <dt>Ưu tiên</dt><dd><span class="ta-badge ta-badge--@WorkTaskPolicy.PriorityTone(t.Priority)">@WorkTaskPolicy.PriorityLabel(t.Priority)</span></dd>
                <dt>Phụ trách chính</dt><dd>@t.OwnerName</dd>
                <dt>Người cùng làm</dt><dd>@(d.Members.Count == 0 ? "—" : string.Join(", ", d.Members.Select(m => m.Name)))</dd>
                <dt>Khách hàng</dt><dd>@(t.CustomerName ?? "—")</dd>
                <dt>Hợp đồng</dt><dd>@(d.ContractLabel ?? "—")</dd>
                <dt>Bắt đầu</dt><dd>@(t.StartDate?.ToString("dd/MM/yyyy", vi) ?? "—")</dd>
                <dt>Hạn hoàn thành</dt><dd>@(t.DueDate?.ToString("dd/MM/yyyy", vi) ?? "—")@if (overdue) {<span class="ta-badge ta-badge--danger ms-1">Quá hạn</span>}</dd>
                <dt>Tiến độ</dt><dd><div class="ta-progress" aria-hidden="true"><span style="width:@(t.Progress)%"></span></div>@t.Progress%@if (t.CompletedAt is DateTime done) {<span class="text-secondary"> · hoàn thành @Local(done)</span>}</dd>
            </dl>
            @if (d.Description is not null) {<h3 class="h4 mt-3">Mô tả</h3><div class="ta-prewrap">@d.Description</div>}
        </div>
    </section>
    <section class="card" aria-labelledby="checkTitle">
        <div class="card-header"><h2 class="card-title" id="checkTitle">@UiIcon.Render("checks")Checklist (@t.ChecklistDone/@t.ChecklistTotal)</h2></div>
        <div class="card-body">
            @if (d.Checklist.Count == 0) {<p class="text-secondary">Chưa có mục nào. Checklist không bắt buộc; nếu có thì phải tích hết, và khi chuyển sang “Hoàn thành” cần nhập ghi chú kết quả.</p>}
            @{ var canOrder = !closed && d.Checklist.Count > 1; var orderForm = "checkOrder" + t.Id.ToString("N"); }
            @if (canOrder)
            {
                @* Drag and drop (operator 2026-11-16): the new order is posted in the background, the page stays as it is. *@
                <form id="@orderForm" method="post" asp-action="ChecklistOrder" asp-route-id="@t.Id" hidden><input type="hidden" name="returnUrl" value="@returnUrl" /></form>
            }
            <ul class="ta-checklist" data-ta-order="@(canOrder ? orderForm : null)">
                @foreach (var i in d.Checklist)
                {
                    <li class="@(i.IsDone ? "is-done" : null)" data-ta-step data-ta-item="@i.Id">
                        @if (canOrder) {<button class="ta-step__handle ta-checklist__handle" type="button" data-ta-step-handle aria-label="Đổi vị trí mục (kéo, hoặc ↑ / ↓): @i.Title" title="Kéo để đổi vị trí">@UiIcon.Render("grip-vertical")</button>}
                        <form method="post" asp-action="ChecklistSet" asp-route-id="@t.Id">
                            <input type="hidden" name="item" value="@i.Id" /><input type="hidden" name="done" value="@(i.IsDone ? "false" : "true")" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="ta-check" role="checkbox" aria-checked="@(i.IsDone ? "true" : "false")" aria-label="@(i.IsDone ? "Bỏ hoàn thành" : "Đánh dấu hoàn thành"): @i.Title" disabled="@closed">@if (i.IsDone) {@UiIcon.Render("check")}</button>
                        </form>
                        <span class="ta-checklist__text">@i.Title</span>
                        @if (guides.For(t.Title, i.Title) is string guide) {<details class="ta-checklist__guide"><summary>@UiIcon.Render("info-circle")<span>Hướng dẫn</span></summary><div class="ta-prewrap">@guide</div></details>}
                        @if (i.IsDone && i.DoneAt is DateTime doneAt) {<time class="ta-checklist__time" datetime="@doneAt.ToString("o")">@UiIcon.Render("clock")@Local(doneAt)@(i.DoneByName is null ? "" : " · " + i.DoneByName)</time>}
                        @if (!closed)
                        {
                            <form method="post" asp-action="ChecklistRemove" asp-route-id="@t.Id" class="ms-auto">
                                <input type="hidden" name="item" value="@i.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="ta-icon-btn ta-icon-btn--sm" aria-label="Xóa mục: @i.Title" title="Xóa mục">@UiIcon.Render("x")</button>
                            </form>
                        }
                    </li>
                }
            </ul>
            @if (!closed)
            {
                <form class="ta-task__inline" method="post" asp-action="ChecklistAdd" asp-route-id="@t.Id">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="ta-input-icon">@UiIcon.Render("checks")<input class="form-control" name="title" maxlength="@WorkTaskPolicy.ChecklistMax" required placeholder="Thêm mục checklist..." aria-label="Thêm mục checklist" data-ta-voice /></div>
                    <button class="btn" type="submit">@UiIcon.Render("plus")<span>Thêm</span></button>
                </form>
            }
            @if (Model.CanEditCatalog && d.Checklist.Count > 0)
            {
                <form class="mt-2" method="post" asp-controller="WorkCatalog" asp-action="FromTask" asp-route-id="@t.Id">
                    <button class="btn btn-sm btn-soft-primary" type="submit" title="Thêm các mục checklist của việc này (mục nào chưa có) vào checklist mẫu của đầu việc “@t.Title”">@UiIcon.Render("list-tree")<span>Bổ sung vào checklist mẫu của đầu việc</span></button>
                </form>
            }
        </div>
    </section>
    @* Trao đổi và lịch sử | Tài liệu (operator 2026-11-16): tabs; #documents in the address opens Tài liệu (after an upload). *@
    <section class="card ta-ws-span-all ta-task-tabs" data-ta-tabs aria-label="Trao đổi, lịch sử và tài liệu">
        <div class="ta-catalog-tabs ta-task-tabs__bar" role="tablist">
            <button class="ta-catalog-tabs__tab" type="button" role="tab" id="tabThread" aria-controls="thread" aria-selected="@(docTab ? "false" : "true")" tabindex="@(docTab ? "-1" : "0")" data-ta-tabbtn="thread">@UiIcon.Render("history")<span>Trao đổi và lịch sử</span></button>
            <button class="ta-catalog-tabs__tab" type="button" role="tab" id="tabDocuments" aria-controls="documents" aria-selected="@(docTab ? "true" : "false")" tabindex="@(docTab ? "0" : "-1")" data-ta-tabbtn="documents">@UiIcon.Render("file-text")<span>Tài liệu</span><span class="ta-catalog-tabs__count">@(docs?.Count ?? 0)</span></button>
        </div>
        <div class="card-body" role="tabpanel" id="thread" aria-labelledby="tabThread" data-ta-tabpanel="thread" hidden="@docTab">
            <ul class="ta-timeline">
                @foreach (var a in d.Activities)
                {
                    <li class="@(a.Kind == "COMMENT" ? "is-comment" : "is-event")">
                        @Avatar.Render(avatars, a.ActorName, userId: a.ActorId, cssClass: "ta-avatar--sm ta-timeline__avatar")
                        <div class="ta-timeline__main">
                            <div class="ta-timeline__head"><strong>@(a.ActorName ?? "Hệ thống")</strong> <time class="text-secondary small" datetime="@a.CreatedAt.ToString("o")">@Local(a.CreatedAt)</time></div>
                            @if (a.Kind == "COMMENT") {<div class="ta-comments__body">@a.Body</div>} else {<div class="text-secondary small">@Event(a)</div>}
                        </div>
                    </li>
                }
            </ul>
            <form class="ta-task__inline ta-task__inline--comment" method="post" asp-action="Comment" asp-route-id="@t.Id">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="ta-input-icon ta-input-icon--top">@UiIcon.Render("file-text")<textarea class="form-control" name="body" rows="3" maxlength="@WorkTaskPolicy.CommentMax" required placeholder="Ghi chú / trao đổi về công việc..." aria-label="Ghi chú hoặc trao đổi" data-ta-voice></textarea></div>
                <button class="btn btn-primary" type="submit">@UiIcon.Render("send")<span>Gửi</span></button>
            </form>
        </div>
        <div class="card-body" role="tabpanel" id="documents" aria-labelledby="tabDocuments" data-ta-tabpanel="documents" hidden="@(!docTab)">
            @if (docs is null)
            {
                <p class="text-secondary mb-0">Chưa dùng được tài liệu (bảng dbo.WorkTaskDocuments chưa sẵn sàng).</p>
            }
            else
            {
                @if (!closed)
                {
                    <form class="ta-doc-upload" method="post" enctype="multipart/form-data" asp-action="DocumentUpload" asp-route-id="@t.Id">
                        <div>
                            <label class="form-label required" for="docFile">File</label>
                            <div class="ta-input-icon">@UiIcon.Render("upload")<input class="form-control" type="file" id="docFile" name="file" required accept="@WorkDocumentPolicy.Accept" /></div>
                            <div class="form-hint">Nhận @WorkDocumentPolicy.AllowedText.</div>
                        </div>
                        <div>
                            <label class="form-label" for="docNote">Ghi chú nội dung</label>
                            <div class="ta-input-icon ta-input-icon--top">@UiIcon.Render("file-text")<textarea class="form-control" id="docNote" name="note" rows="2" maxlength="@WorkDocumentPolicy.NoteMax" placeholder="Tài liệu này là gì, dùng để làm gì... (không bắt buộc)" data-ta-voice></textarea></div>
                        </div>
                        <div><button class="btn btn-primary" type="submit">@UiIcon.Render("upload")<span>Tải lên</span></button></div>
                    </form>
                }
                @if (docs.Count == 0)
                {
                    <p class="text-secondary mb-0">Chưa có tài liệu nào.</p>
                }
                else
                {
                    <ul class="ta-docs">
                        @foreach (var x in docs)
                        {
                            var canChange = d.CanEdit || x.CreatedBy == Model.ActorId;
                            var href = Url.Action("Document", new { id = t.Id, doc = x.Id });
                            <li class="ta-doc">
                                @if (x.IsImage)
                                {
                                    <a class="ta-doc__thumb" href="@Url.Action("Document", new { id = t.Id, doc = x.Id, view = true })" target="_blank" rel="noopener" title="Xem ảnh"><img src="@Url.Action("Document", new { id = t.Id, doc = x.Id, view = true })" alt="" loading="lazy" /></a>
                                }
                                else
                                {
                                    <span class="ta-doc__icon ta-doc__icon--@x.Kind.ToLowerInvariant()" aria-hidden="true">@UiIcon.Render(DocIcon(x))<small>@x.Kind</small></span>
                                }
                                <div class="ta-doc__main">
                                    <a class="ta-doc__name" href="@href" title="Tải về">@x.FileName</a>
                                    <div class="ta-doc__meta">
                                        @Avatar.Render(avatars, x.CreatedByName, userId: x.CreatedBy, cssClass: "ta-avatar--sm")
                                        <span>@(x.CreatedByName ?? "—") · @Local(x.CreatedAt) · @x.Kind · @Size(x.SizeBytes)</span>
                                    </div>
                                    @if (x.Note is not null) {<div class="ta-doc__note ta-prewrap">@x.Note</div>}
                                    @if (canChange)
                                    {
                                        <details class="ta-doc__edit">
                                            <summary>@UiIcon.Render("pencil")<span>@(x.Note is null ? "Thêm ghi chú" : "Sửa ghi chú")</span></summary>
                                            <form method="post" asp-action="DocumentNote" asp-route-id="@t.Id">
                                                <input type="hidden" name="doc" value="@x.Id" />
                                                <div class="ta-input-icon ta-input-icon--top w-100">@UiIcon.Render("file-text")<textarea class="form-control form-control-sm" name="note" rows="2" maxlength="@WorkDocumentPolicy.NoteMax" aria-label="Ghi chú nội dung tài liệu" data-ta-voice>@x.Note</textarea></div>
                                                <button class="btn btn-sm btn-primary" type="submit">@UiIcon.Render("device-floppy")<span>Lưu ghi chú</span></button>
                                            </form>
                                        </details>
                                    }
                                </div>
                                <div class="ta-doc__actions">
                                    <a class="ta-icon-btn" href="@href" aria-label="Tải về @x.FileName" title="Tải về">@UiIcon.Render("external-link")</a>
                                    @if (canChange)
                                    {
                                        <form method="post" asp-action="DocumentDelete" asp-route-id="@t.Id" onsubmit="return confirm('Xóa tài liệu này?');">
                                            <input type="hidden" name="doc" value="@x.Id" />
                                            <button class="ta-icon-btn" type="submit" aria-label="Xóa @x.FileName" title="Xóa">@UiIcon.Render("trash")</button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
        </div>
    </section>
</div>

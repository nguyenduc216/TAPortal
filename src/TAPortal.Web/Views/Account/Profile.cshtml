@model AuthUserSnapshot
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["Subtitle"] = "Thông tin tài khoản đang đăng nhập.";
    ViewData["PageIcon"] = "user-circle";
    var initial = (Model.DisplayName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() is { Length: > 0 } last ? last[..1].ToUpperInvariant() : "TA";
}
<div class="row"><div class="col-xl-7">
<section class="card">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4"><span class="ta-avatar ta-avatar--lg" aria-hidden="true">@initial</span><div class="min-w-0"><h2 class="ta-section-title">@Model.DisplayName</h2><div class="text-secondary">@Model.Username</div></div></div>
        <dl class="ta-dl"><dt>Email</dt><dd>@(Model.Email ?? "—")</dd><dt>Điện thoại</dt><dd>@(Model.Phone ?? "—")</dd><dt>Vai trò</dt><dd>@string.Join(", ", Model.Roles)</dd></dl>
    </div>
    <div class="card-footer ta-form-actions"><a asp-action="ChangePassword" class="btn btn-primary">@UiIcon.Render("key")<span>Đổi mật khẩu</span></a></div>
</section>
</div></div>

@inject IEmployeePhotoStore AvatarPhotos
@model AuthUserSnapshot
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["Subtitle"] = "Thông tin tài khoản đang đăng nhập.";
    ViewData["PageIcon"] = "user-circle";
    var initial = (Model.DisplayName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() is { Length: > 0 } last ? last[..1].ToUpperInvariant() : "TA";
}
<div class="row"><div class="col-xl-7">
<section class="card">
    <div class="card-body">
        <div class="mb-2 min-w-0"><h2 class="ta-section-title">@Model.DisplayName</h2><div class="text-secondary">@Model.Username</div></div>
        <div class="mb-4">@{ var avatarIndex = await AvatarPhotos.IndexAsync(); var myPhoto = Avatar.Url(avatarIndex, null, Model.Id) is not null; }
            <partial name="_PhotoForm" model="@(new PhotoFormVm(Url.Action("SetAvatar", "Account")!, myPhoto, Avatar.Render(avatarIndex, Model.DisplayName, userId: Model.Id, cssClass: "ta-avatar--xl", initials: initial)))" /></div>
        <dl class="ta-dl"><dt>Email</dt><dd>@(Model.Email ?? "—")</dd><dt>Điện thoại</dt><dd>@(Model.Phone ?? "—")</dd><dt>Vai trò</dt><dd>@(ViewBag.RoleNames is IEnumerable<string> names && names.Any() ? string.Join(", ", names) : "—")</dd></dl>
    </div>
    <div class="card-footer ta-form-actions"><a asp-action="ChangePassword" class="btn btn-primary">@UiIcon.Render("key")<span>Đổi mật khẩu</span></a><a asp-action="Zalo" class="btn">@UiIcon.Render("qrcode")<span>Zalo Mini App</span></a></div>
</section>
</div></div>

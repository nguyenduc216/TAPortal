@model AuthUserSnapshot
@{ ViewData["Title"]="Hồ sơ cá nhân"; var initials=string.Concat(Model.DisplayName.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>char.ToUpperInvariant(x[0]))); }
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Tài khoản</div><h1 class="ta-page-title">Hồ sơ cá nhân</h1><p class="ta-page-subtitle">Thông tin nhận diện và quyền truy cập của bạn.</p></div><div class="ta-page-actions"><a asp-action="ChangePassword" class="btn btn-primary"><i class="ti ti-key"></i>Đổi mật khẩu</a></div></div>
<div class="row row-cards"><div class="col-lg-5"><div class="card h-100"><div class="card-body"><div class="ta-profile-hero"><div class="ta-profile-avatar">@(string.IsNullOrWhiteSpace(initials)?"TA":initials)</div><div><h2 class="h3 mb-1">@Model.DisplayName</h2><div class="text-secondary">@@@Model.Username</div><div class="mt-2"><span class="badge badge-ta-active"><i class="ti ti-circle-check me-1"></i>Đang hoạt động</span></div></div></div></div></div></div><div class="col-lg-7"><div class="card h-100"><div class="card-header"><h2 class="card-title"><i class="ti ti-id me-2"></i>Thông tin tài khoản</h2></div><div class="card-body"><dl class="ta-info-list"><div><dt>Email</dt><dd>@(Model.Email??"—")</dd></div><div><dt>Điện thoại</dt><dd>@(Model.Phone??"—")</dd></div><div><dt>Vai trò</dt><dd>@(Model.Roles.Count>0?string.Join(", ",Model.Roles):"—")</dd></div></dl></div></div></div></div>

@model AuthUserSnapshot
@{ ViewData["Title"]="Hồ sơ cá nhân"; }
<div class="page-header"><h2 class="page-title">Hồ sơ cá nhân</h2></div>
<div class="row mt-3"><div class="col-lg-7"><div class="card"><div class="card-body"><div class="d-flex align-items-center mb-4"><span class="avatar avatar-lg ta-avatar me-3">TA</span><div><h3 class="mb-0">@Model.DisplayName</h3><div class="text-secondary">@Model.Username</div></div></div><dl class="row"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(Model.Email??"—")</dd><dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9">@(Model.Phone??"—")</dd><dt class="col-sm-3">Vai trò</dt><dd class="col-sm-9">@string.Join(", ",Model.Roles)</dd></dl><a asp-action="ChangePassword" class="btn btn-primary"><i class="ti ti-key me-1"></i>Đổi mật khẩu</a></div></div></div></div>

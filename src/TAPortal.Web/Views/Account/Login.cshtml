@model LoginVm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="ta-auth">
    <section class="ta-auth-brand" aria-hidden="true">
        <div class="ta-auth-brand__inner">
            <img src="~/images/ta-logo.png" class="ta-auth-logo" alt="" />
            <h1>T.A Portal</h1>
            <p>Tư vấn giải pháp · Quản trị doanh nghiệp</p>
            <div class="ta-auth-benefits">
                <span>@UiIcon.Render("shield-check")Tin cậy</span>
                <span>@UiIcon.Render("chart-bar")Hiệu quả</span>
                <span>@UiIcon.Render("users-group")Đồng hành</span>
            </div>
        </div>
    </section>
    <main class="ta-auth-form">
        <div class="card ta-login-card @(ViewData.ModelState.ErrorCount > 0 ? "ta-shake" : "")">
            <div class="card-body">
                <div class="ta-login-heading mb-4">
                    <h2>Chào mừng trở lại!</h2>
                    <p>Đăng nhập để tiếp tục sử dụng T.A Portal.</p>
                </div>

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="ta-alert ta-alert--danger" role="alert">
                        @UiIcon.Render("alert-circle")
                        <div class="ta-alert__body">
                            <span class="ta-alert__title">Đăng nhập chưa thành công</span>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    </div>
                }

                <form asp-action="Login" method="post" autocomplete="on">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Tài khoản</label>
                        <div class="ta-input-icon">
                            @UiIcon.Render("user")
                            <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="ta-field-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <div class="ta-input-icon">
                            @UiIcon.Render("lock")
                            <input asp-for="Password" id="password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                            <button class="ta-password-toggle" type="button" onclick="taTogglePassword('password',this)" aria-label="Hiện mật khẩu" aria-pressed="false">@UiIcon.Render("eye", "ta-icon-show")@UiIcon.Render("eye-off", "ta-icon-hide")</button>
                        </div>
                        <span asp-validation-for="Password" class="ta-field-error"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-check mb-0"><input asp-for="RememberMe" class="form-check-input" /><span class="form-check-label">Ghi nhớ đăng nhập</span></label>
                    </div>

                    <button class="btn btn-ta-gold ta-login-button" type="submit" data-ta-loading data-ta-loading-text="Đang đăng nhập...">
                        @UiIcon.Render("login-2")<span>Đăng nhập</span>
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>

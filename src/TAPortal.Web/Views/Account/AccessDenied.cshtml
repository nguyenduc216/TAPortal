@{ ViewData["Title"]="Không có quyền truy cập"; var isAdmin = User.IsInRole("SYS_ADMIN"); }
<div class="container-tight py-5"><div class="empty"><div class="empty-header">403</div><p class="empty-title">Bạn không có quyền truy cập chức năng này.</p><p class="empty-subtitle text-secondary">Vui lòng liên hệ quản trị hệ thống nếu bạn cần thêm quyền.</p><div class="empty-action">@if (isAdmin) {<a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="ti ti-arrow-left" aria-hidden="true"></i>Về tổng quan</a>} else if (User.Identity?.IsAuthenticated == true) {<a asp-controller="Account" asp-action="Profile" class="btn btn-primary"><i class="ti ti-user-circle" aria-hidden="true"></i>Về hồ sơ cá nhân</a>} else {<a asp-controller="Account" asp-action="Login" class="btn btn-primary"><i class="ti ti-login-2" aria-hidden="true"></i>Đăng nhập</a>}</div></div></div>

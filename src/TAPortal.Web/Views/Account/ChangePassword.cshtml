@model ChangePasswordVm
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Subtitle"] = "Mật khẩu mới dùng chung cho TAPortal và Customer Portal.";
    ViewData["PageIcon"] = "key";
}
<div class="row"><div class="col-xl-6 col-lg-8">
<form class="card" asp-action="ChangePassword" method="post">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="ta-alert ta-alert--danger" role="alert"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" id="newPassword" class="form-control" autocomplete="new-password" oninput="taCheckPassword(this.value,'rules')" /><span asp-validation-for="NewPassword" class="text-danger"></span>
            <ul id="rules" class="password-rules"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div>
        <div><label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    </div>
    <div class="card-footer ta-form-actions"><a asp-action="Profile" class="btn">@UiIcon.Render("arrow-left")<span>Quay lại</span></a><button class="btn btn-primary ms-auto" type="submit" data-ta-loading data-ta-loading-text="Đang cập nhật...">@UiIcon.Render("device-floppy")<span>Cập nhật mật khẩu</span></button></div>
</form>
</div></div>

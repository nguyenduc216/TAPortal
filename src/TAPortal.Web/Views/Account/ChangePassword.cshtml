@model ChangePasswordVm
@{ ViewData["Title"]="Đổi mật khẩu"; }
<div class="page-header"><h2 class="page-title">Đổi mật khẩu</h2></div>
<div class="row mt-3"><div class="col-lg-6"><div class="card"><div class="card-body"><form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div><div class="mb-2"><label class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" id="newPassword" class="form-control" oninput="taCheckPassword(this.value,'rules')" /><span asp-validation-for="NewPassword" class="text-danger"></span></div><ul id="rules" class="password-rules ps-3 mb-3"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul><div class="mb-4"><label class="form-label">Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button class="btn btn-primary" type="submit" data-ta-loading data-ta-loading-text="Đang cập nhật..."><i class="ti ti-device-floppy" aria-hidden="true"></i><span>Cập nhật mật khẩu</span></button></form></div></div></div></div>

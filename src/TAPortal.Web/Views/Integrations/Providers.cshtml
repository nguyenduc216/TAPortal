@model IReadOnlyList<ProviderRow>
@{ViewData["Title"]="Nhà cung cấp";}<div class="page-header"><h2 class="page-title">Nhà cung cấp tích hợp</h2><div class="text-secondary">Provider được T.A Portal hỗ trợ.</div></div><div class="row row-cards mt-1">@foreach(var x in Model){<div class="col-md-6 col-xl-4"><div class="card ta-card-clickable"><div class="card-body d-flex align-items-center gap-3"><span class="ta-stat-icon"><i class="ti ti-plug-connected"></i></span><div class="flex-fill"><div class="fw-semibold">@x.Name</div><div class="text-secondary ta-xs">@x.Code · @x.ProviderType</div></div><span class="badge @(x.IsActive?"badge-ta-active":"bg-secondary-lt")">@(x.IsActive?"Sẵn sàng":"Tắt")</span></div></div></div>}</div>
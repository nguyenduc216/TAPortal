@model WebsitePostEdit
@using TAWebsite.Core.Content
@using TAWebsite.Core.Data
@inject IConfiguration Configuration
@{
    Layout = null;
    var publicUrl = WebsiteUi.PublicUrl(Configuration);
    var (body, toc) = PostHtml.WithToc(PostHtml.WithMedia(PostHtml.Sanitize(Model.BodyHtml)).Replace("src=\"/media/", "src=\"" + WebsiteUi.MediaBase + "/"));
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var library = ViewData["LibraryPost"] as LibraryPost; // "Bài soạn sẵn" preview: not saved yet, sources shown for the reviewer
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Xem trước: @Model.Title</title>
    @foreach (var css in new[] { "styles.css", "dich-vu.css", "trang-phu.css", "site.css" }) {<link rel="stylesheet" href="@publicUrl/css/@css" />}
    <style>.ta-preview-bar{position:sticky;top:0;z-index:50;background:#d7a407;color:#052b50;font:700 13px/1.4 'Be Vietnam Pro',sans-serif;padding:10px 16px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.ta-preview-bar a{color:#052b50;text-decoration:underline}.ta-preview-notes{margin:32px auto 48px;padding:20px 24px;border:2px dashed #d7a407;border-radius:12px;background:#fffdf4;font:14px/1.7 'Be Vietnam Pro',sans-serif;color:#20364c}.ta-preview-notes h2{font-size:18px;color:#052b50;margin:8px 0 4px}.ta-preview-notes a{color:#0b5cad;word-break:break-all}.ta-preview-hint{color:#8a5a00;font-size:13px;margin:0 0 8px}</style>
</head>
<body>
@if (library is not null)
{
<div class="ta-preview-bar">XEM THỬ – bài soạn sẵn, chưa có trên website · <a href="/WebsitePosts/Library">← Về Bài soạn sẵn</a> · <a href="#nguon-tham-khao">Nguồn tham khảo (@(library.Sources?.Count ?? 0))</a></div>
}
else
{
<div class="ta-preview-bar">XEM TRƯỚC – @(Model.Status == 1 ? "bài đã xuất bản" : "bản nháp, khách chưa thấy") · <a href="/WebsitePosts/Edit/@Model.Id">← Quay lại sửa bài</a></div>
}
<main class="dv-main" id="top">
<article>
    <header class="ar-head"><div class="wrap"><div class="ar-head-inner">
        <h1>@Model.Title</h1>
        @if (Model.Summary is not null) {<p class="ar-lead">@Model.Summary</p>}
        @if (Model.Source is { HasSource: true } origin) {<p class="ar-origin">@(origin.Kind == PostSource.Republished ? "Đăng lại từ" : "Tổng hợp từ") <b>@origin.Name</b>@if (origin.SafeUrl is not null) {<text> · </text><a href="@origin.SafeUrl" target="_blank" rel="noopener nofollow">Xem bài gốc ↗</a>}</p>}
        <div class="ar-byline"><img alt="" src="/site-assets/ta-logo.png" /><span>Biên soạn: <b>@(Model.AuthorName ?? "Ban chuyên môn T.A")</b></span><span>@(Model.PublishedAt is DateTime d ? WebsiteUi.Local(d).ToString("dd/MM/yyyy", vi) : "Chưa đăng")</span><span>@PostHtml.ReadMinutes(Model.BodyHtml) phút đọc</span></div>
    </div></div></header>
    <div class="wrap">
        @if (Model.CoverMediaId is Guid cover) {<figure class="ar-cover"><img alt="" src="@WebsiteUi.ImageUrl(cover)" /></figure>}
        <div class="ar-layout @(toc.Count == 0 ? "no-toc" : "")">
            <nav aria-label="Mục lục bài viết" class="ar-toc">@if (toc.Count > 0) {<b>MỤC LỤC</b><ol>@foreach (var (id, title) in toc) {<li><a href="#@id">@title</a></li>}</ol>}</nav>
            <div class="ar-body">@Html.Raw(body)
                @if (Model.Source is { HasSource: true } src)
                {
                    var republished = src.Kind == PostSource.Republished;
                    <aside class="ar-source" aria-label="Nguồn bài viết"><b>Nguồn</b>
                        <p>@(republished ? "Bài đăng lại với sự đồng ý của" : "Bài tóm tắt và trích dẫn từ") <b>@src.Name</b>@if (!string.IsNullOrWhiteSpace(src.Author)) {<text>, tác giả @src.Author</text>}@if (src.PublishedOn is DateTime on) {<text>, đăng ngày @on.ToString("dd/MM/yyyy")</text>}.</p>
                        @if (src.SafeUrl is not null) {<a href="@src.SafeUrl" target="_blank" rel="noopener nofollow">Xem bài gốc ↗</a>}
                    </aside>
                }
            </div>
        </div>
    </div>
</article>
@if (library is not null)
{
    <section class="wrap ta-preview-notes" id="nguon-tham-khao" aria-label="Ghi chú cho người duyệt">
        <h2>Nguồn tham khảo khi soạn bài</h2>
        <p class="ta-preview-hint">Chỉ người duyệt trong Portal thấy phần này, khách xem website không thấy.</p>
        @if (library.Sources is { Count: > 0 })
        {
            <ol>@foreach (var s in library.Sources) { var (label, url) = PostLibrary.SplitSource(s); <li>@label@if (url is not null) {<text> – </text><a href="@url" target="_blank" rel="noopener noreferrer">@url</a>}</li> }</ol>
        }
        else {<p>Chưa ghi nguồn.</p>}
        @if (library.Uncertain is { Count: > 0 })
        {
            <h2>Cần T.A rà lại (@library.Uncertain.Count điểm)</h2>
            <p class="ta-preview-hint">Các chi tiết chưa đối chiếu được với nguyên văn văn bản; bài đã viết thận trọng ở những chỗ này.</p>
            <ol>@foreach (var u in library.Uncertain) {<li>@u</li>}</ol>
        }
    </section>
}
</main>
</body>
</html>

@using TAPortal.Integrations.Tingee
@using TAPortal.Web.Controllers
@model TingeeSandboxVm
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Tingee Sandbox";
    var cfg = Model.Config;
    var ready = cfg.Configured && Model.ScopeLabel is not null;
    var mid = Model.SelectedMerchant;
    var conn = Model.Connection;
    var rule = Model.Bank is not null && Model.AccountType is not null ? Model.Bank.Rule(Model.AccountType) : null;
    var b = Model.BankInput;
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal v) => v.ToString("#,##0", vn) + "đ";
    var linkOtp = Model.LinkResult?.Otp;
    var unlink = Model.Unlink;
    var linkOpen = Model.Dialog == TingeeSandboxDialogs.Link;
    var unlinkOpen = Model.Dialog == TingeeSandboxDialogs.Unlink;
    // Errors of an open dialog are shown inside it; otherwise at the top of the page.
    var errors = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? [];
}

<style>
    .tg-otp { display: flex; gap: .875rem; align-items: center; padding: .875rem 1rem; margin-bottom: 1rem; border-radius: .5rem;
        background: rgba(245, 159, 0, .12); border: 1px solid #f59f00; }
    .tg-otp__icon { flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; background: #f59f00; color: #fff;
        animation: tg-otp-pulse 1.6s ease-out infinite; }
    .tg-otp__title { font-weight: 700; font-size: 1.05rem; }
    .tg-otp__input { font-size: 1.5rem !important; letter-spacing: .35em; font-variant-numeric: tabular-nums; }
    .tg-step { display: inline-block; padding: .1rem .5rem; margin-left: .5rem; border-radius: 1rem; font-size: .75rem; font-weight: 600; background: #f59f00; color: #fff; vertical-align: middle; }
    .tg-countdown{display:inline-block;margin-left:.35rem;padding:0 .5rem;border-radius:999px;background:#e7f1ff;color:#1c5fb8;font-weight:600;font-variant-numeric:tabular-nums}
    .tg-countdown.is-low{background:#fff4e5;color:#b35c00}.tg-countdown.is-over{background:#fdecec;color:#c92a2a}.tg-countdown.is-paid{background:#e6f6ea;color:#2b8a3e}
    .tg-qr{position:relative}.tg-qr__lock{display:none;position:absolute;inset:0;flex-direction:column;align-items:center;justify-content:center;gap:.35rem;background:rgba(255,255,255,.82);color:#c92a2a;font-weight:700;text-align:center;border-radius:8px}
    .tg-qr.is-locked svg{filter:blur(4px) grayscale(1);opacity:.35}.tg-qr.is-locked .tg-qr__lock{display:flex}.tg-qr.is-paid .tg-qr__lock{color:#2b8a3e}
    @@keyframes tg-otp-pulse { 0% { box-shadow: 0 0 0 0 rgba(245, 159, 0, .55); } 100% { box-shadow: 0 0 0 .9rem rgba(245, 159, 0, 0); } }
    @@media (prefers-reduced-motion: reduce) { .tg-otp__icon { animation: none; } }
    .tg-hook { display: flex; align-items: center; gap: .5rem; margin-bottom: .375rem; }
    .tg-hook__label { flex: none; width: 6.5rem; font-size: .8125rem; color: var(--tblr-secondary, #667382); }
    .tg-hook__url { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tg-copy { flex: none; padding: .25rem .4rem; line-height: 1; }
    .tg-copy .tg-copy__done { display: none; }
    .tg-copy.is-copied { color: #2fb344; border-color: #2fb344; }
    .tg-copy.is-copied .tg-copy__idle { display: none; }
    .tg-copy.is-copied .tg-copy__done { display: inline-block; }
</style>

@if (Model.Dialog is null && errors.Count > 0)
{
    <div class="ta-alert ta-alert--danger mb-3" role="alert" data-ta-sandbox-errors>@UiIcon.Render("alert-circle")<div class="ta-alert__body">@foreach (var e in errors) {<div>@e</div>}</div></div>
}

@if (cfg.Production)
{
    <div class="ta-alert ta-alert--warning" role="note" data-ta-sandbox-production>@UiIcon.Render("alert-triangle")<div class="ta-alert__body">Đang kết nối <strong>Tingee production</strong> (@cfg.BaseUrl): liên kết ngân hàng và QR là thật, tiền chuyển vào là tiền thật. Chỉ dùng tài khoản của T.A và số tiền nhỏ.</div></div>
}

@if (linkOtp is not null || unlink?.ConfirmId is not null)
{
    <div class="tg-otp" role="status" data-ta-sandbox-otp-pending>
        <div class="tg-otp__icon">@UiIcon.Render("key")</div>
        <div class="flex-grow-1"><div class="tg-otp__title">Đang chờ mã OTP</div><div>@(linkOtp?.BankName ?? unlink!.BankName) đã gửi mã OTP. Nhập mã trong cửa sổ xác thực để hoàn tất.</div></div>
        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="@(linkOtp is not null ? "#tgLink" : "#tgUnlink")">@UiIcon.Render("key")<span>Nhập OTP</span></button>
    </div>
}

<div class="ta-ws-grid">
    <section class="card" aria-labelledby="sbConfig" data-ta-sandbox-config>
        <div class="card-header"><h2 class="card-title" id="sbConfig">@UiIcon.Render("settings")1. Cấu hình</h2></div>
        <div class="card-body">
            <dl class="ta-dl">
                <dt>Khóa API</dt><dd>@if (cfg.Configured) {<span class="ta-badge ta-badge--success">Đã cấu hình</span>} else {<span class="ta-badge ta-badge--danger" data-ta-sandbox-unconfigured>Chưa cấu hình</span>}</dd>
                <dt>Chế độ</dt><dd>@if (cfg.Direct) {<span class="ta-badge ta-badge--neutral">Direct (Merchant thường)</span>} else {<span class="ta-badge ta-badge--success" data-ta-sandbox-master>Master Merchant</span>}</dd>
                @if (cfg.Direct)
                {
                    <dt>Merchant ID</dt><dd>@if (cfg.MerchantId is long own) {<span class="ta-code" data-ta-sandbox-merchant>#@own</span>} else {<span class="ta-badge ta-badge--danger" data-ta-sandbox-no-merchant>Chưa cấu hình — cần để liên kết ngân hàng</span>}</dd>
                }
                else
                {
                    <dt>Merchant con</dt><dd>@if (Model.ScopeLabel is not null) {<span data-ta-sandbox-scope>@Model.ScopeLabel</span>} else {<span class="ta-badge ta-badge--danger" data-ta-sandbox-scope-missing>Chưa chọn</span>}</dd>
                }
                <dt>Môi trường</dt><dd><span class="ta-badge @(cfg.Production ? "ta-badge--warning" : "ta-badge--neutral")">@(cfg.Production ? "Production" : "UAT / khác")</span> <code>@cfg.BaseUrl</code></dd>
                <dt>Hộp thư webhook</dt><dd>@(cfg.InboxAvailable ? "Sẵn sàng (dbo.TingeeWebhookInbox)" : "Chưa có kết nối cơ sở dữ liệu")</dd>
            </dl>
            @if (!cfg.Direct && cfg.Configured && Model.Merchants.Count > 0)
            {
                <form asp-action="Index" method="get" class="mt-3" data-ta-sandbox-merchant-picker>
                    <label class="form-label" for="merchant">Merchant con để test</label>
                    <select class="form-select" id="merchant" name="merchant" onchange="this.form.submit()">
                        <option value="">— Chọn —</option>
                        @foreach (var m in Model.Merchants) { <option value="@m.MerchantId" selected="@(m.MerchantId == mid)">@m.CustomerName (@m.CustomerCode) — #@m.MerchantId</option> }
                    </select>
                    <noscript><button class="btn btn-sm mt-2" type="submit">Chọn</button></noscript>
                </form>
            }
            @if (Model.ScopeError is not null && cfg.Configured)
            {
                <div class="ta-alert ta-alert--warning mt-3 mb-0" role="note" data-ta-sandbox-scope-error>@UiIcon.Render("alert-triangle")<div class="ta-alert__body">@Model.ScopeError</div></div>
            }
            @if (!cfg.Configured || (cfg.Direct && cfg.MerchantId is null))
            {
                <div class="form-hint mt-3" data-ta-sandbox-howto>
                    Thêm vào <code>appsettings.json</code> của site Portal trên server (mục <code>"Tingee"</code>), điền ClientId và SecretKey vào giữa hai dấu ngoặc kép đang để trống (key Master Merchant dùng <code>"Mode": "Master"</code>; key Merchant thường dùng <code>"Direct"</code> kèm <code>"MerchantId"</code>), rồi recycle app pool <code>TA.Portal</code>:
                    <pre class="mt-2 mb-0"><code>"Tingee": {
  "BaseUrl": "@TingeeOptions.ProductionBaseUrl",
  "Mode": "Master",
  "ClientId": "",
  "SecretKey": "",
  "VaStatusWebhookUrl": "@cfg.VaStatusWebhookUrl"
}</code></pre>
                </div>
            }
            <p class="form-hint mt-3 mb-2">Khai báo địa chỉ nhận webhook trên trang quản trị Tingee (biến động số dư):</p>
            <div data-ta-sandbox-hooks>
                @foreach (var (label, url) in new[] { ("Thanh toán", cfg.PaymentWebhookUrl), ("Trạng thái VA", cfg.VaStatusWebhookUrl), ("Liên kết NH", cfg.BankLinkWebhookUrl) })
                {
                    var shown = Uri.TryCreate(url, UriKind.Absolute, out var u) ? "…" + u.AbsolutePath : url;
                    <div class="tg-hook">
                        <span class="tg-hook__label">@label</span>
                        <code class="tg-hook__url" title="@url">@shown</code>
                        <button type="button" class="btn btn-sm tg-copy" data-ta-copy-text="@url" title="Chép địa chỉ" aria-label="Chép địa chỉ webhook @label">@UiIcon.Render("copy", "tg-copy__idle")@UiIcon.Render("check", "tg-copy__done")</button>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer d-flex gap-2 flex-wrap">
            <a class="btn" asp-action="Index" asp-route-merchant="@mid">@UiIcon.Render("refresh")<span>Kiểm tra kết nối</span></a>
            <form asp-action="SelfTestWebhook" method="post"><input type="hidden" name="merchant" value="@mid" /><button class="btn" type="submit" disabled="@(!cfg.Configured || !cfg.InboxAvailable)" data-ta-loading data-ta-loading-text="Đang gửi...">@UiIcon.Render("inbox")<span>Gửi webhook thử</span></button></form>
        </div>
    </section>

    <section class="card" aria-labelledby="sbConn" data-ta-sandbox-connection>
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <h2 class="card-title" id="sbConn">@UiIcon.Render("building-bank")2. Kết nối và tài khoản nhận tiền</h2>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#tgLink" disabled="@(!ready)" data-ta-sandbox-add-link>@UiIcon.Render("plus")<span>Thêm liên kết</span></button>
        </div>
        <div class="card-body">
            @if (conn is null)
            {
                <p class="text-secondary mb-0">Cấu hình khóa API@(cfg.Direct ? "" : " và chọn merchant con") để kiểm tra kết nối.</p>
            }
            else if (!conn.Ok)
            {
                <div class="ta-alert ta-alert--danger mb-0" role="alert" data-ta-sandbox-conn-failed>@UiIcon.Render("alert-circle")<div class="ta-alert__body">Kết nối Tingee lỗi: @conn.Error</div></div>
            }
            else if (conn.Accounts.Count == 0)
            {
                <p class="mb-0" data-ta-sandbox-conn-ok><span class="ta-badge ta-badge--success">Kết nối OK</span> Chưa có tài khoản ngân hàng nào được liên kết. Bấm "Thêm liên kết".</p>
            }
            else
            {
                <p data-ta-sandbox-conn-ok><span class="ta-badge ta-badge--success">Kết nối OK</span> @conn.Accounts.Count tài khoản đã liên kết.</p>
                <div class="table-responsive">
                    <table class="table table-sm mb-0" data-ta-sandbox-accounts>
                        <thead><tr><th>Ngân hàng</th><th>Loại</th><th>Số tài khoản</th><th>Tài khoản nhận (VA)</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var a in conn.Accounts)
                            {
                                var bankName = TingeeBankCatalog.Find(a.BankBin)?.Name ?? a.BankBin;
                                <tr>
                                    <td>@bankName</td><td>@TingeeAccountTypes.Label(a.AccountType)</td><td>@a.AccountNumber</td><td><span class="ta-code">@a.VaAccountNumber</span></td><td>@a.Status</td>
                                    <td class="text-end">@if (!string.IsNullOrWhiteSpace(a.VaAccountNumber) && a.BankBin is not null)
                                    {<button type="button" class="btn btn-outline-danger btn-sm" title="Xóa liên kết" data-bs-toggle="modal" data-bs-target="#tgUnlink"
                                        data-ta-unlink-bin="@a.BankBin" data-ta-unlink-va="@a.VaAccountNumber" data-ta-unlink-bank="@bankName">@UiIcon.Render("trash")<span>Xóa</span></button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card" aria-labelledby="sbQr" data-ta-sandbox-qr>
        <div class="card-header"><h2 class="card-title" id="sbQr">@UiIcon.Render("qrcode")3. Tạo QR thử và chuyển tiền</h2></div>
        <div class="card-body">
            @if (Model.Qr is { } qr)
            {
                <div class="d-flex gap-3 flex-wrap mb-3" data-ta-sandbox-qr-result>
                    <div class="tg-qr" style="width:200px;max-width:100%" data-ta-qr-image>@Html.Raw(qr.Svg)<div class="tg-qr__lock" aria-hidden="true">@UiIcon.Render("clock")<span data-ta-qr-lock-text>QR đã hết hạn</span></div></div>
                    <dl class="ta-dl">
                        <dt>Loại</dt><dd>@(qr.Type == "dynamic" ? "QR động (Tingee theo dõi)" : "QR tĩnh VietQR")</dd>
                        <dt>Ngân hàng</dt><dd>@qr.BankName</dd>
                        <dt>Tài khoản nhận</dt><dd><span class="ta-code">@qr.Account</span></dd>
                        <dt>Số tiền</dt><dd>@Money(qr.Amount)</dd>
                        <dt>Nội dung</dt><dd>@(qr.Purpose ?? "—")</dd>
                        @if (qr.ExpiresAtUtc is DateTime exp) {
                            var left = (int)Math.Max(0, Math.Ceiling((exp - Clock.GetUtcNow().UtcDateTime).TotalSeconds));
                            <dt>Hết hạn</dt><dd>@exp.AddHours(7).ToString("HH:mm dd/MM") <span class="tg-countdown" data-ta-qr-countdown data-seconds-left="@left" aria-live="off">còn @(left / 60):@((left % 60).ToString("00"))</span></dd>}
                    </dl>
                </div>
                @if (qr.Type == "dynamic" && qr.QrAccount is not null && qr.BillId is not null)
                {
                    <div class="ta-alert ta-alert--info" role="status" aria-live="polite" data-ta-sandbox-qr-status data-url="@Url.Action("QrStatus", new { qrAccount = qr.QrAccount, billId = qr.BillId, merchant = mid })">@UiIcon.Render("clock")<div class="ta-alert__body" data-ta-sandbox-qr-status-text>Đang chờ thanh toán… (tự kiểm tra mỗi 5 giây)</div></div>
                    <form asp-action="DeleteQr" method="post"><input type="hidden" name="merchant" value="@mid" /><input type="hidden" name="qrAccount" value="@qr.QrAccount" /><input type="hidden" name="billId" value="@qr.BillId" /><button class="btn btn-outline-danger btn-sm" type="submit">@UiIcon.Render("x")<span>Hủy QR</span></button></form>
                }
                else
                {
                    <p class="form-hint">QR tĩnh không có trạng thái riêng: tiền vào sẽ hiện ở mục 4 khi Tingee gửi webhook.</p>
                }
            }
            <form asp-action="CreateQr" method="post">
                <input type="hidden" name="merchant" value="@mid" />
                <div class="row g-2 mb-3">
                    <div class="col-12"><label class="form-label required" for="Qr_Account">Tài khoản nhận tiền</label>
                        <select class="form-select" id="Qr_Account" name="Qr.Account" required>
                            <option value="">— Chọn —</option>
                            @foreach (var a in conn?.Accounts ?? [])
                            {
                                var number = a.VaAccountNumber ?? a.AccountNumber;
                                if (string.IsNullOrWhiteSpace(number)) { continue; }
                                var key = $"{a.BankBin}|{number}|{a.AccountType}";
                                <option value="@key" selected="@(key == Model.QrInput.Account)">@(TingeeBankCatalog.Find(a.BankBin)?.Name ?? a.BankBin) — @number</option>
                            }
                        </select></div>
                    <div class="col-sm-6"><label class="form-label required" for="Qr_Amount">Số tiền (đ)</label><div class="ta-input-icon">@UiIcon.Render("report-money")<input class="form-control" id="Qr_Amount" name="Qr.Amount" type="number" min="1000" max="10000000" step="1000" value="@Model.QrInput.Amount.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" required /></div></div>
                    <div class="col-12 order-last"><label class="form-label" for="Qr_Purpose">Nội dung</label><div class="ta-input-icon">@UiIcon.Render("file-text")<input class="form-control" id="Qr_Purpose" name="Qr.Purpose" value="@Model.QrInput.Purpose" maxlength="50" /></div></div>
                    <div class="col-sm-6"><label class="form-label" for="Qr_Type">Loại QR</label>
                        <select class="form-select" id="Qr_Type" name="Qr.Type">
                            <option value="dynamic" selected="@(Model.QrInput.Type != "static")">QR động (theo dõi trạng thái)</option>
                            <option value="static" selected="@(Model.QrInput.Type == "static")">QR tĩnh VietQR</option>
                        </select></div>
                </div>
                <button class="btn btn-primary" type="submit" disabled="@(!ready || conn is not { Ok: true } || conn.Accounts.Count == 0)" data-ta-loading data-ta-loading-text="Đang tạo...">@UiIcon.Render("qrcode")<span>Tạo QR</span></button>
            </form>
        </div>
    </section>
</div>

<section class="card mt-3" aria-labelledby="sbHooks">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title" id="sbHooks">@UiIcon.Render("report-money")4. Biến động nhận được (webhook)</h2>
        <span class="form-hint">Tự làm mới mỗi 10 giây</span>
    </div>
    <div class="card-body" data-ta-sandbox-webhooks data-url="@Url.Action("Webhooks")">
        <partial name="_Webhooks" model="(Model.Webhooks, Model.WebhookError)" />
    </div>
</section>

<section class="card mt-3" aria-labelledby="sbSdk" data-ta-sandbox-sdk>
    <div class="card-header"><h2 class="card-title" id="sbSdk">@UiIcon.Render("switch-horizontal")5. Thử Bank Link SDK (màn hình liên kết của Tingee)</h2></div>
    <div class="card-body">
        <p class="form-hint">Tingee tự hiển thị chọn ngân hàng, nhập thông tin và OTP. Kết quả về qua callback (bên dưới) và webhook <code>bank-link</code> (mục 4).
            Dùng để kiểm tra: màn hình có lộ tên/logo Tingee không, và cấu hình tài khoản doanh nghiệp (<code>bank-config</code>).</p>
        <form asp-action="BankLinkSession" method="post" data-ta-banklink-form>
            <input type="hidden" name="merchant" value="@mid" />
            <div class="row g-2 mb-3">
                <div class="col-sm-6 col-lg-3"><label class="form-label" for="sdkKind">Loại phiên</label>
                    <select class="form-select" id="sdkKind" name="kind">
                        <option value="@TingeeBankLinkTypes.Link">Liên kết tài khoản (bank-link)</option>
                        <option value="@TingeeBankLinkTypes.Config">Cấu hình tài khoản DN (bank-config)</option>
                    </select></div>
                <div class="col-sm-6 col-lg-3"><label class="form-label" for="sdkBank">Ngân hàng</label>
                    <select class="form-select" id="sdkBank" name="bank">
                        <option value="">Tất cả (khách tự chọn)</option>
                        @foreach (var bk in TingeeBankCatalog.Banks) {<option value="@bk.Code">@bk.Name</option>}
                    </select></div>
                <div class="col-sm-6 col-lg-3"><label class="form-label" for="sdkType">Loại tài khoản</label>
                    <select class="form-select" id="sdkType" name="accountType">
                        <option value="">Khách tự chọn</option>
                        @foreach (var t in TingeeAccountTypes.All) {<option value="@t">@TingeeAccountTypes.Label(t)</option>}
                    </select></div>
                <div class="col-sm-6 col-lg-3"><label class="form-label" for="sdkMode">Cách hiển thị</label>
                    <select class="form-select" id="sdkMode" data-ta-banklink-mode>
                        <option value="popup">Popup</option>
                        <option value="inline">Nhúng trong trang</option>
                    </select></div>
            </div>
            <button class="btn btn-primary" type="submit" disabled="@(!ready)" data-ta-banklink-open>@UiIcon.Render("building-bank")<span>Mở SDK</span></button>
        </form>
        <div class="ta-alert ta-alert--info mt-3 mb-0" role="status" aria-live="polite" hidden data-ta-banklink-status>@UiIcon.Render("info-circle")<div class="ta-alert__body" data-ta-banklink-status-text></div></div>
        <div id="tgSdkInline" class="mt-3" style="width:100%;height:760px" hidden data-ta-banklink-inline></div>
        <ol class="mt-3 mb-0 small" hidden data-ta-banklink-log></ol>
    </div>
</section>

@* ---- Popup: link a bank account (OTP step included) ---- *@
<div class="modal modal-blur fade" id="tgLink" tabindex="-1" aria-labelledby="tgLinkTitle" aria-hidden="true" data-ta-open="@(linkOpen ? "true" : "false")" data-ta-sandbox-link>
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
        @if (linkOtp is not null) {<div class="modal-status bg-warning"></div>}
        <div class="modal-header">
            <h2 class="modal-title" id="tgLinkTitle">@if (linkOtp is not null) {@UiIcon.Render("key")<span>Xác thực OTP</span><span class="tg-step">Bước 2/2</span>} else {@UiIcon.Render("arrows-exchange")<span>Liên kết tài khoản ngân hàng</span><span class="tg-step" style="background:#206bc4">Bước 1/2</span>}</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
            @if (linkOpen && errors.Count > 0)
            {
                <div class="ta-alert ta-alert--danger mb-3" role="alert" data-ta-sandbox-errors>@UiIcon.Render("alert-circle")<div class="ta-alert__body">@foreach (var e in errors) {<div>@e</div>}</div></div>
            }
            @if (Model.LinkResult is { } lr)
            {
                @if (lr.Otp is { } otp)
                {
                    <div class="tg-otp" role="alert" aria-live="assertive" data-ta-sandbox-link-result>
                        <div class="tg-otp__icon">@UiIcon.Render("key")</div>
                        <div><div class="tg-otp__title">Nhập mã OTP để hoàn tất liên kết @otp.BankName</div><div>@lr.Message Mã được gửi tới số điện thoại đăng ký với ngân hàng@(otp.OtpMethod is null ? "" : $" ({otp.OtpMethod})") và chỉ có hiệu lực trong thời gian ngắn.</div></div>
                    </div>
                    @if (lr.ActionLink is not null) {<p><a class="btn btn-sm" href="@lr.ActionLink" target="_blank" rel="noopener noreferrer">Mở trang xác thực của ngân hàng</a></p>}
                    <form asp-action="ConfirmOtp" method="post" data-ta-sandbox-otp>
                        <input type="hidden" name="merchant" value="@mid" />
                        <input type="hidden" name="bankBin" value="@otp.BankBin" />
                        <input type="hidden" name="confirmId" value="@otp.ConfirmId" />
                        <label class="form-label required" for="otp">Mã OTP @otp.BankName</label>
                        <div class="d-flex gap-2"><div class="ta-input-icon flex-grow-1">@UiIcon.Render("key")<input class="form-control tg-otp__input" id="otp" name="otp" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" autocomplete="one-time-code" required data-ta-otp-input /></div><button class="btn btn-primary btn-lg" type="submit" data-ta-loading data-ta-loading-text="Đang xác nhận...">@UiIcon.Render("check")<span>Xác nhận</span></button></div>
                    </form>
                }
                else
                {
                    <div class="ta-alert ta-alert--info mb-3" role="status" data-ta-sandbox-link-result>@UiIcon.Render("info-circle")<div class="ta-alert__body">@lr.Message
                        @if (lr.ActionLink is not null) {<div class="mt-2"><a class="btn btn-sm" href="@lr.ActionLink" target="_blank" rel="noopener noreferrer">Mở trang xác thực của ngân hàng</a></div>}</div></div>
                }
            }
            @if (linkOtp is null)
            {
                <form asp-action="Index" method="get" class="row g-2 mb-3">
                    <input type="hidden" name="merchant" value="@mid" />
                    <div class="col-sm-6"><label class="form-label" for="bin">Ngân hàng</label>
                        <select class="form-select" id="bin" name="bin" onchange="this.form.submit()">
                            <option value="">— Chọn —</option>
                            @foreach (var bank in TingeeBankCatalog.Banks) { <option value="@bank.Bin" selected="@(bank.Bin == Model.Bank?.Bin)">@bank.Name</option> }
                        </select></div>
                    <div class="col-sm-6"><label class="form-label" for="type">Loại tài khoản</label>
                        <select class="form-select" id="type" name="type" onchange="this.form.submit()" disabled="@(Model.Bank is null)">
                            <option value="">— Chọn —</option>
                            @foreach (var t in Model.Bank?.AccountTypes ?? []) { <option value="@t" selected="@(t == Model.AccountType)">@TingeeAccountTypes.Label(t)</option> }
                        </select></div>
                    <noscript><button class="btn btn-sm" type="submit">Chọn</button></noscript>
                </form>
                @if (rule is not null)
                {
                    @if (rule.Note is not null) {<p class="form-hint">@rule.Note</p>}
                    <form asp-action="LinkBank" method="post" id="tgLinkForm" data-ta-sandbox-link-form>
                        <input type="hidden" name="merchant" value="@mid" />
                        <input type="hidden" name="Bank.Bin" value="@Model.Bank!.Bin" />
                        <input type="hidden" name="Bank.AccountType" value="@Model.AccountType" />
                        @foreach (var field in rule.Required)
                        {
                            var name = field.ToString();
                            var value = field switch { TingeeBankField.AccountNumber => b.AccountNumber, TingeeBankField.AccountName => b.AccountName, TingeeBankField.Identity => b.Identity, TingeeBankField.Mobile => b.Mobile, TingeeBankField.VaSuffix => b.VaSuffix, TingeeBankField.MerchantName => b.MerchantName, TingeeBankField.VaAccountNumber => b.VaAccountNumber, _ => b.AcbUserId };
                            var label = field == TingeeBankField.Identity && rule.TaxCodeAsIdentity(Model.AccountType) ? "mã số thuế doanh nghiệp" : TingeeSandboxController.FieldLabel(field);
                            <div class="mb-2"><label class="form-label required" for="Bank_@name">@(char.ToUpper(label[0]) + label[1..])</label><div class="ta-input-icon">@UiIcon.Render("hash")<input class="form-control" id="Bank_@name" name="Bank.@name" value="@value" required /></div></div>
                        }
                        @if (Model.AccountType != TingeeAccountTypes.Personal && !rule.TaxCodeAsIdentity(Model.AccountType))
                        {
                            <div class="mb-2"><label class="form-label" for="Bank_TaxCode">Mã số thuế</label><div class="ta-input-icon">@UiIcon.Render("receipt-tax")<input class="form-control" id="Bank_TaxCode" name="Bank.TaxCode" value="@b.TaxCode" inputmode="numeric" maxlength="14" /></div><div class="form-hint">Mã số thuế của doanh nghiệp/hộ kinh doanh chủ tài khoản (Tingee dùng cho tài khoản doanh nghiệp).</div></div>
                        }
                        @if (rule.Required.Count == 0) {<p class="form-hint">Ngân hàng này không cần nhập thêm thông tin; khách hàng xác thực trên ứng dụng ngân hàng.</p>}
                        @if (rule.SupportsRootNotify && rule.VaSupported)
                        {
                            <label class="form-check mb-0"><input class="form-check-input" type="checkbox" name="Bank.NotifyRootAccount" value="true" checked="@b.NotifyRootAccount" /><input type="hidden" name="Bank.NotifyRootAccount" value="false" /><span class="form-check-label">Nhận biến động trên số tài khoản gốc</span></label>
                        }
                    </form>
                }
                else
                {
                    <p class="text-secondary mb-0">Chọn ngân hàng và loại tài khoản để hiện các thông tin cần nhập.</p>
                }
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">@UiIcon.Render("x")<span>Đóng</span></button>
            @if (linkOtp is null && rule is not null)
            {
                <button class="btn btn-primary" type="submit" form="tgLinkForm" disabled="@(!ready)" data-ta-loading data-ta-loading-text="Đang gửi...">@UiIcon.Render("check")<span>Liên kết</span></button>
            }
        </div>
    </div></div>
</div>

@* ---- Popup: remove a bank link (confirm, then OTP when the bank asks for one) ---- *@
<div class="modal modal-blur fade" id="tgUnlink" tabindex="-1" aria-labelledby="tgUnlinkTitle" aria-hidden="true" data-ta-open="@(unlinkOpen ? "true" : "false")" data-ta-sandbox-unlink>
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-status @(unlink?.ConfirmId is not null ? "bg-warning" : "bg-danger")"></div>
        <div class="modal-header">
            <h2 class="modal-title" id="tgUnlinkTitle">@if (unlink?.ConfirmId is not null) {@UiIcon.Render("key")<span>Xác thực OTP xóa liên kết</span><span class="tg-step">Bước 2/2</span>} else {@UiIcon.Render("trash")<span>Xóa liên kết ngân hàng</span>}</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
            @if (unlinkOpen && errors.Count > 0)
            {
                <div class="ta-alert ta-alert--danger mb-3" role="alert" data-ta-sandbox-errors>@UiIcon.Render("alert-circle")<div class="ta-alert__body">@foreach (var e in errors) {<div>@e</div>}</div></div>
            }
            @if (unlink?.ConfirmId is not null)
            {
                <div class="tg-otp" role="alert" aria-live="assertive" data-ta-sandbox-unlink-otp>
                    <div class="tg-otp__icon">@UiIcon.Render("key")</div>
                    <div><div class="tg-otp__title">Nhập mã OTP để xóa liên kết @unlink.BankName</div><div>Ngân hàng đã gửi mã OTP tới số điện thoại đăng ký. Tài khoản nhận <strong>@unlink.VaAccountNumber</strong> sẽ ngừng nhận biến động sau khi xác nhận.</div></div>
                </div>
                <form asp-action="ConfirmDeleteVa" method="post" id="tgUnlinkOtpForm">
                    <input type="hidden" name="merchant" value="@mid" />
                    <input type="hidden" name="bankBin" value="@unlink.BankBin" />
                    <input type="hidden" name="vaAccountNumber" value="@unlink.VaAccountNumber" />
                    <input type="hidden" name="confirmId" value="@unlink.ConfirmId" />
                    <label class="form-label required" for="unlinkOtp">Mã OTP @unlink.BankName</label>
                    <div class="ta-input-icon">@UiIcon.Render("key")<input class="form-control tg-otp__input" id="unlinkOtp" name="otp" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" autocomplete="one-time-code" required data-ta-otp-input /></div>
                </form>
            }
            else
            {
                @if (unlink?.Link is not null)
                {
                    <div class="ta-alert ta-alert--info mb-3" role="status" data-ta-sandbox-unlink-link>@UiIcon.Render("info-circle")<div class="ta-alert__body">Mở trang xác thực của @unlink.BankName để hoàn tất xóa liên kết, sau đó bấm "Kiểm tra kết nối".<div class="mt-2"><a class="btn btn-sm" href="@unlink.Link" target="_blank" rel="noopener noreferrer">Mở trang xác thực của ngân hàng</a></div></div></div>
                }
                <form asp-action="DeleteVa" method="post" id="tgUnlinkForm">
                    <input type="hidden" name="merchant" value="@mid" />
                    <input type="hidden" name="bankBin" value="@unlink?.BankBin" data-ta-unlink-field="bin" />
                    <input type="hidden" name="vaAccountNumber" value="@unlink?.VaAccountNumber" data-ta-unlink-field="va" />
                    <p class="mb-0">Xóa liên kết <strong data-ta-unlink-field="bank">@unlink?.BankName</strong>, tài khoản nhận <strong class="ta-code" data-ta-unlink-field="va-text">@unlink?.VaAccountNumber</strong>? Tài khoản này sẽ không nhận biến động số dư qua Tingee nữa. Một số ngân hàng sẽ gửi OTP để xác nhận.</p>
                </form>
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">@UiIcon.Render("x")<span>Đóng</span></button>
            @if (unlink?.ConfirmId is not null)
            {
                <button class="btn btn-primary" type="submit" form="tgUnlinkOtpForm" data-ta-loading data-ta-loading-text="Đang xác nhận...">@UiIcon.Render("check")<span>Xác nhận</span></button>
            }
            else
            {
                <button class="btn btn-danger" type="submit" form="tgUnlinkForm" disabled="@(!ready)" data-ta-loading data-ta-loading-text="Đang gửi...">@UiIcon.Render("trash")<span>Xóa liên kết</span></button>
            }
        </div>
    </div></div>
</div>

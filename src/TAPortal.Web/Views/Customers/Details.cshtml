@model CustomerOverviewVm
@inject IContractStore Contracts
@inject ICustomerStaffStore Staff
@{
    var ws = (CustomerWorkspaceHeader)ViewData["Workspace"]!;
    ViewData["Title"] = ws.Code;
    ViewData["ParentTitle"] = "Khách hàng";
    ViewData["ParentController"] = "Customers";
    ViewData["HideHeader"] = true;
    var c = Model.Customer;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<partial name="_Workspace" model="ws" />
<div class="ta-ws-grid">
    <section class="card" aria-labelledby="idTitle">
        <div class="card-header"><h2 class="card-title" id="idTitle">@UiIcon.Render("id")Thông tin nhận diện</h2></div>
        <div class="card-body">
            <dl class="ta-dl">
                <dt>Mã khách hàng</dt><dd><span class="ta-code">@c.Code</span></dd>
                <dt>Tên khách hàng</dt><dd>@c.Name</dd>
                <dt>Mã số thuế</dt><dd>@(c.TaxCode ?? "—")</dd>
                <dt>Trạng thái</dt><dd><span class="ta-badge @(ws.Operational ? "ta-badge--success" : "ta-badge--danger")">@(ws.Operational ? "Hoạt động" : "Ngừng hoạt động")</span> <span class="ta-code ms-1" title="Trạng thái hệ thống">@c.Status</span></dd>
            </dl>
        </div>
    </section>
    <section class="card" aria-labelledby="contactTitle">
        <div class="card-header"><h2 class="card-title" id="contactTitle">@UiIcon.Render("mail")Liên hệ</h2></div>
        <div class="card-body">
            <dl class="ta-dl">
                <dt>Email</dt><dd>@(c.Email ?? "—")</dd>
                <dt>Điện thoại</dt><dd>@(c.Phone ?? "—")</dd>
                <dt>Địa chỉ</dt><dd>@(c.Address ?? "—")</dd>
            </dl>
        </div>
    </section>
    @{
        // Nhân sự phụ trách (migration 041): read here like the contracts card; unreadable => a short notice.
        CustomerStaffView? staff = null;
        try { staff = await Staff.GetAsync(c.Id); } catch (Exception) { staff = null; }
        var canEditStaff = AdminPermissions.Has(User, AdminPermissions.CustomersUpdate);
    }
    <section class="card" aria-labelledby="staffTitle" data-ta-customer-staff>
        <div class="card-header"><h2 class="card-title" id="staffTitle">@UiIcon.Render("users")Nhân sự phụ trách</h2></div>
        <div class="card-body">
            @if (staff is null)
            {
                <p class="text-secondary mb-0">Không đọc được nhân sự phụ trách (chi tiết đã ghi vào nhật ký ứng dụng).</p>
            }
            else
            {
                <dl class="ta-dl">
                    <dt>Quản lý</dt><dd>@(staff.Manager?.Name ?? "—")</dd>
                    <dt>Thực hiện</dt><dd>@(staff.Executors.Any() ? string.Join(", ", staff.Executors.Select(e => e.Name)) : "—")</dd>
                </dl>
                @if (canEditStaff)
                {
                    <details class="ta-staff-edit mt-3">
                        <summary class="btn btn-sm">@UiIcon.Render("pencil")<span>Phân công</span></summary>
                        <form class="mt-3" method="post" asp-action="Staff" asp-route-id="@c.Id">
                            <label class="form-label" for="staffManager">Quản lý (một người)</label>
                            <select class="form-select" id="staffManager" name="manager">
                                <option value="">— Chưa có —</option>
                                @foreach (var e in staff.Employees) {<option value="@e.Id" selected="@(e.Id == staff.Manager?.EmployeeId)">@e.Name</option>}
                            </select>
                            <div class="form-label mt-3">Nhân viên thực hiện</div>
                            <div class="ta-check-list" role="group" aria-label="Nhân viên thực hiện">
                                @foreach (var e in staff.Employees)
                                {
                                    <label class="form-check"><input class="form-check-input" type="checkbox" name="executors" value="@e.Id" checked="@staff.Executors.Any(x => x.EmployeeId == e.Id)" /><span class="form-check-label">@e.Name</span></label>
                                }
                            </div>
                            <button class="btn btn-ta-gold mt-3" type="submit">@UiIcon.Render("device-floppy")<span>Lưu phân công</span></button>
                        </form>
                    </details>
                }
            }
        </div>
    </section>
    <section class="card" aria-labelledby="portalTitle" data-ta-portal-summary>
        <div class="card-header"><h2 class="card-title" id="portalTitle">@UiIcon.Render("users-group")Customer Portal</h2></div>
        <div class="card-body">
            @if (Model.PortalAccounts is not { } s)
            {
                <p class="text-secondary mb-0">Không đọc được danh sách tài khoản Portal (chi tiết đã ghi vào nhật ký ứng dụng).</p>
            }
            else if (s.Total == 0)
            {
                <p class="text-secondary mb-0">Chưa có tài khoản nào được cấp quyền truy cập Customer Portal cho khách hàng này.</p>
            }
            else
            {
                <dl class="ta-dl">
                    <dt>Đang có hiệu lực</dt><dd><span class="ta-metric__value" data-ta-metric="effective">@s.Effective.ToString("N0", vi)</span></dd>
                    <dt>Tổng tài khoản</dt><dd><span class="ta-metric__value" data-ta-metric="total">@s.Total.ToString("N0", vi)</span></dd>
                    <dt>Đã thu hồi</dt><dd><span class="ta-metric__value" data-ta-metric="revoked">@s.Revoked.ToString("N0", vi)</span></dd>
                </dl>
            }
        </div>
        <div class="card-footer"><a asp-action="PortalAccounts" asp-route-id="@c.Id">Quản lý quyền truy cập →</a></div>
    </section>
    @if (AdminPermissions.Has(User, AdminPermissions.ContractsView))
    {
        // Hợp đồng (migration 031): read here so the customer controller keeps its dependencies; unreadable => a short notice.
        IReadOnlyList<ContractListItem>? contracts = null;
        try { contracts = await Contracts.ListAsync(new ContractFilter { CustomerId = c.Id }, DateTime.Today); } catch (Exception) { contracts = null; }
        <section class="card" aria-labelledby="contractsTitle" data-ta-customer-contracts>
            <div class="card-header"><h2 class="card-title" id="contractsTitle">@UiIcon.Render("file-text")Hợp đồng</h2>@if (contracts is not null) {<span class="ta-badge ta-badge--neutral ta-badge--plain ms-auto">@contracts.Count</span>}</div>
            <div class="card-body">
                @if (contracts is null)
                {
                    <p class="text-secondary mb-0">Không đọc được danh sách hợp đồng (chi tiết đã ghi vào nhật ký ứng dụng).</p>
                }
                else if (contracts.Count == 0)
                {
                    <p class="text-secondary mb-0">Chưa có hợp đồng nào cho khách hàng này.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        @foreach (var k in contracts.Take(5))
                        {
                            <li><a asp-controller="Contracts" asp-action="Details" asp-route-id="@k.Id"><span class="ta-code">@k.ContractNo</span> @k.Title</a>
                                <span class="ta-badge @ContractPolicy.StatusBadge(k.Status) ta-badge--plain ms-1">@ContractPolicy.StatusLabel(k.Status)</span>@if (k.IsExpiringSoon(DateTime.Today)) {<span class="ta-badge ta-badge--warning ta-badge--plain ms-1">Sắp hết hạn</span>}</li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer d-flex flex-wrap gap-2 align-items-center">
                <a asp-controller="Contracts" asp-action="Index" asp-route-customerId="@c.Id">Xem tất cả hợp đồng →</a>
                @if (AdminPermissions.Has(User, AdminPermissions.ContractsCreate)) {<a class="btn btn-sm btn-soft-primary ms-auto" asp-controller="Contracts" asp-action="Create" asp-route-customerId="@c.Id" data-ta-customer-contract-create>@UiIcon.Render("plus")<span>Thêm hợp đồng</span></a>}
            </div>
        </section>
    }
</div>

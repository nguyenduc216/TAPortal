@model CustomerAccountsOverviewVm
@{
    ViewData["Title"] = "Tài khoản Portal";
    ViewData["Heading"] = "Quản lý khách hàng";
    ViewData["Subtitle"] = "Tổng hợp tài khoản Customer Portal của mọi khách hàng. Cấp quyền, đổi vai trò và thu hồi được thực hiện trong hồ sơ từng khách hàng.";
    ViewData["PageIcon"] = "building";
    var byId = Model.Customers.ToDictionary(c => c.Id);
}
@section PageActions {
    <a class="btn btn-ta-gold" asp-action="Create">@UiIcon.Render("plus")<span>Thêm khách hàng</span></a>
}
<partial name="_CustomersTabs" model="@("accounts")" />
<section class="card ta-table-card" aria-label="Tài khoản Customer Portal của mọi khách hàng">
    <div class="ta-table-toolbar">
        <div class="ta-search">@UiIcon.Render("search")<input class="form-control" type="search" aria-label="Tìm tài khoản" placeholder="Tìm theo họ tên, tên đăng nhập, khách hàng, vai trò..." oninput="taFilterRows(this.value,'allAccountsTable')" /></div>
    </div>
    @if (Model.Accounts is null)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("database-off")</span><p class="ta-empty__title">Không tải được danh sách tài khoản Portal</p><p class="ta-empty__text">Chi tiết đã được ghi vào nhật ký ứng dụng; vui lòng thử lại hoặc liên hệ quản trị hệ thống.</p></div>
    }
    else if (Model.Accounts.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("users-group")</span><p class="ta-empty__title">Chưa có tài khoản Customer Portal nào</p><p class="ta-empty__text">Mở hồ sơ một khách hàng, chọn tab "Tài khoản Portal" để cấp quyền.</p></div>
    }
    else
    {
        <div class="ta-table-wrap">
            <table class="ta-table ta-table-stack" id="allAccountsTable" data-ta-pager="10">
                <thead><tr><th scope="col">Tài khoản</th><th scope="col">Khách hàng</th><th scope="col">Vai trò</th><th scope="col">Quyền truy cập</th><th scope="col">Đăng nhập gần nhất (UTC)</th><th scope="col" class="ta-col-actions">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Accounts)
                {
                    var customer = byId.GetValueOrDefault(r.CustomerId);
                    var effect = MembershipDisplay.Evaluate(r.Active, r.Status, customer);
                    <tr data-ta-row>
                        <td class="ta-cell-strong"><div>@r.DisplayName</div><div class="ta-cell-sub">@r.Username</div></td>
                        <td data-label="Khách hàng">@if (customer is not null) {<span class="ta-code me-1">@customer.Code</span>}@r.CustomerName</td>
                        <td data-label="Vai trò"><span class="ta-badge ta-badge--info ta-badge--plain">@PortalRoleText.Label(r.Role)</span></td>
                        <td data-label="Quyền truy cập"><span class="ta-badge @(effect.Effective ? "ta-badge--success" : r.Active ? "ta-badge--warning" : "ta-badge--neutral")">@effect.Label</span>@if (effect.Reason is not null) {<div class="small mt-1" style="color:var(--ta-danger-text)">Lý do: @effect.Reason</div>}</td>
                        <td class="ta-nowrap" data-label="Đăng nhập gần nhất">@(r.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="ta-col-actions"><a class="btn btn-sm btn-soft-primary" asp-action="PortalAccounts" asp-route-id="@r.CustomerId" aria-label="Quản lý tài khoản Portal của @r.CustomerName">@UiIcon.Render("user-cog")<span>Quản lý</span></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="ta-empty d-none" data-ta-no-results><span class="ta-empty__icon">@UiIcon.Render("search-off")</span><p class="ta-empty__title">Không tìm thấy kết quả phù hợp</p></div>
        <div class="ta-table-footer" data-ta-pager-for="allAccountsTable" data-ta-unit="tài khoản"></div>
    }
</section>

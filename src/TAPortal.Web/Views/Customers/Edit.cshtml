@model CustomerEditVm
@{
    var isNew = Model.Id == Guid.Empty;
    var ws = ViewData["Workspace"] as CustomerWorkspaceHeader;
    ViewData["ParentTitle"] = "Khách hàng";
    ViewData["ParentController"] = "Customers";
    if (isNew || ws is null)
    {
        ViewData["Title"] = "Thêm khách hàng";
        ViewData["Subtitle"] = "Tạo hồ sơ khách hàng mới.";
        ViewData["PageIcon"] = "plus";
    }
    else
    {
        ViewData["Title"] = ws.Code;
        ViewData["HideHeader"] = true;
    }
}
@if (!isNew && ws is not null)
{
    <partial name="_Workspace" model="ws" />
}
<form class="card" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
    <div class="card-header"><h2 class="card-title">@UiIcon.Render("building")Thông tin khách hàng</h2></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="ta-alert ta-alert--danger" role="alert"></div>
        <div class="ta-form-grid ta-form-grid--3">
            <div>
                <label asp-for="Code" class="form-label @(isNew ? "required" : "")">Mã khách hàng</label>
                @if (isNew) {<div class="ta-input-icon">@UiIcon.Render("hash")<input asp-for="Code" class="form-control text-uppercase" maxlength="50" autocomplete="off" required /></div>} else {<div class="ta-input-icon">@UiIcon.Render("hash")<input class="form-control" value="@Model.Code" readonly disabled /></div>}
                <span asp-validation-for="Code" class="invalid-feedback d-block"></span>
                @if (!isNew) {<div class="form-hint">Mã khách hàng không thể thay đổi.</div>}
            </div>
            <div class="ta-ws-span-2">
                <label asp-for="Name" class="form-label required">Tên khách hàng</label>
                <div class="ta-input-icon">@UiIcon.Render("building")<input asp-for="Name" class="form-control" maxlength="250" required placeholder="Nhập tên khách hàng" /></div>
                <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
            </div>
            <div>
                <label asp-for="TaxCode" class="form-label">Mã số thuế</label>
                <div class="ta-input-icon">@UiIcon.Render("receipt-tax")<input asp-for="TaxCode" class="form-control" maxlength="50" inputmode="numeric" placeholder="0101234567 hoặc 0101234567-001" /></div>
                <span asp-validation-for="TaxCode" class="invalid-feedback d-block"></span>
                <div class="form-hint">10 chữ số; đơn vị phụ thuộc/chi nhánh: 10 chữ số + "-" + 3 chữ số. Không trùng với khách hàng khác.</div>
            </div>
            <div>
                <label asp-for="Email" class="form-label">Email</label>
                <div class="ta-input-icon">@UiIcon.Render("mail")<input asp-for="Email" class="form-control" type="email" maxlength="256" placeholder="ten@congty.vn" /></div>
                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
            </div>
            <div>
                <label asp-for="Phone" class="form-label">Điện thoại</label>
                <div class="ta-input-icon">@UiIcon.Render("phone")<input asp-for="Phone" class="form-control" maxlength="50" inputmode="tel" /></div>
                <span asp-validation-for="Phone" class="invalid-feedback d-block"></span>
            </div>
            <div class="ta-ws-span-2">
                <label asp-for="Address" class="form-label">Địa chỉ</label>
                <div class="ta-input-icon ta-input-icon--top">@UiIcon.Render("map-pin")<textarea asp-for="Address" class="form-control" rows="3" maxlength="1000" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea></div>
                <span asp-validation-for="Address" class="invalid-feedback d-block"></span>
            </div>
            <div>
                <span class="form-label d-block">Trạng thái</span>
                <div class="ta-switch-row">
                    <label class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><span class="form-check-label">Đang hoạt động</span></label>
                </div>
                <div class="form-hint">Tắt sẽ chặn mọi tài khoản Customer Portal truy cập doanh nghiệp này; dữ liệu và membership được giữ nguyên.</div>
                @if (!isNew) {<div class="form-hint">Trạng thái hệ thống: <span class="ta-code">@Model.Status</span></div>}
            </div>
        </div>
    </div>
    <div class="card-footer ta-form-actions">
        @if (isNew) {<a asp-action="Index" class="btn">@UiIcon.Render("arrow-left")<span>Quay lại</span></a>}
        else {<a asp-action="Details" asp-route-id="@Model.Id" class="btn">@UiIcon.Render("x")<span>Hủy</span></a>}
        <button type="submit" class="btn btn-primary ms-auto" data-ta-loading data-ta-loading-text="Đang lưu...">@UiIcon.Render("device-floppy")<span>@(isNew ? "Tạo khách hàng" : "Lưu thay đổi")</span></button>
    </div>
</form>

@model CustomerWorkspaceHeader
@inject TAPortal.Integrations.Branding.ILogoStore Logos
@* Customer Workspace header + tabs. Tabs come from CustomerWorkspace.Tabs; every link carries the customer id. *@
@{
    // The company's logo (Customer Portal / Hồ sơ doanh nghiệp tab); the building icon when there is none or it cannot be read.
    string? logoVersion = null;
    try { logoVersion = await Logos.LogoVersionAsync(Model.Id, null) is { } at ? TAPortal.Integrations.Branding.LogoImage.Version(at) : null; } catch (Exception) { logoVersion = null; }
}
<div class="ta-ws-head">
    @if (logoVersion is not null) {<img class="ta-ws-head__icon ta-ws-head__logo" src="@Url.Action("Logo", new { id = Model.Id })?v=@logoVersion" alt="Logo @Model.Name" data-ta-customer-logo />}
    else {<span class="ta-ws-head__icon" aria-hidden="true">@UiIcon.Render("building")</span>}
    <div class="ta-ws-head__text">
        <h1 class="ta-page-title">@Model.Name</h1>
        <div class="ta-ws-head__meta">
            <span class="ta-code" title="Mã khách hàng">@Model.Code</span>
            <span class="ta-badge @(Model.Operational ? "ta-badge--success" : "ta-badge--danger")">@(Model.Operational ? "Hoạt động" : "Ngừng hoạt động")</span>
            @if (Model.Status != "ACTIVE") {<span class="ta-badge ta-badge--neutral ta-badge--plain" title="Trạng thái hệ thống">@Model.Status</span>}
        </div>
    </div>
    <div class="ta-ws-head__actions">
        <a class="btn" asp-action="Index">@UiIcon.Render("arrow-left")<span>Danh sách khách hàng</span></a>
        @if (Model.ActiveTab != CustomerWorkspace.Info && AdminPermissions.Has(User, AdminPermissions.CustomersUpdate)) {<a class="btn btn-soft-primary" asp-action="Edit" asp-route-id="@Model.Id">@UiIcon.Render("pencil")<span>Sửa thông tin</span></a>}
    </div>
</div>
<nav aria-label="Hồ sơ khách hàng @Model.Code">
    <ul class="ta-tabs">
        @foreach (var tab in CustomerWorkspace.Tabs)
        {
            // Tabs whose page needs a permission the account lacks are hidden (the page itself still answers 403).
            var needs = tab.Key == CustomerWorkspace.Info ? AdminPermissions.CustomersUpdate : tab.Key == CustomerWorkspace.Portal ? AdminPermissions.CustomerPortalManage : null;
            if (needs is not null && !AdminPermissions.Has(User, needs)) { continue; }
            <li><a class="ta-tabs__link" data-ta-keep-scroll asp-action="@tab.Action" asp-route-id="@Model.Id" aria-current="@(tab.Key == Model.ActiveTab ? "page" : null)" data-ta-tab="@tab.Key">@UiIcon.Render(tab.Icon)<span>@tab.Label</span></a></li>
        }
    </ul>
</nav>
@if (!Model.Operational)
{
    <div class="ta-alert ta-alert--warning" role="note">@UiIcon.Render("alert-triangle")<div class="ta-alert__body">Khách hàng đang ngừng hoạt động: mọi tài khoản Customer Portal bị chặn truy cập doanh nghiệp này (dữ liệu và quyền được giữ nguyên) và không thể cấp quyền mới.</div></div>
}

@model IReadOnlyList<CustomerRow>
@{ ViewData["Title"]="Khách hàng"; }
<div class="page-header"><div class="row align-items-center"><div class="col"><h2 class="page-title">Danh sách khách hàng</h2><div class="text-secondary">Quản lý hồ sơ khách hàng T.A.</div></div><div class="col-auto ms-auto"><button class="btn btn-ta-gold" disabled title="CRUD khách hàng sẽ mở ở bước kế tiếp"><i class="ti ti-plus me-1"></i>Thêm khách hàng</button></div></div></div>
<div class="card ta-table-card mt-3"><div class="card-header"><div class="input-icon"><span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span><input class="form-control" type="search" aria-label="Tìm khách hàng" placeholder="Tìm khách hàng..." oninput="taFilterRows(this.value,'customersTable')" /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="customersTable"><thead><tr><th>Mã KH</th><th>Tên khách hàng</th><th>MST</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr data-ta-row><td><code>@x.Code</code></td><td class="fw-medium">@x.Name</td><td>@x.TaxCode</td><td>@x.Email</td><td>@x.Phone</td><td><span class="badge badge-ta-active">@x.Status</span></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty"><i class="ti ti-building-store" aria-hidden="true"></i>Chưa có khách hàng.</div>}<div class="ta-table-empty d-none" data-ta-no-results><i class="ti ti-search-off" aria-hidden="true"></i>Không tìm thấy kết quả phù hợp.</div></div>

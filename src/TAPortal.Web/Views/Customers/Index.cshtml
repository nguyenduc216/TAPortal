@model IReadOnlyList<CustomerRow>
@{ ViewData["Title"]="Khách hàng"; var canCreate = ViewData["CanCreate"] is true; }
@* CHANGE_ID: TAPORTAL-20261012-CUSTOMERS-001 — MVC retains ownership with current permission-aware actions and shared customer validation. *@
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">CRM / Khách hàng</div><h1 class="ta-page-title">Danh sách khách hàng</h1><p class="ta-page-subtitle">Tra cứu hồ sơ và thông tin liên hệ khách hàng T.A.</p></div><div class="ta-page-actions"><button class="btn btn-ta-secondary" type="button" data-customer-export><i class="ti ti-file-export" aria-hidden="true"></i>Xuất dữ liệu</button><button class="btn btn-ta-gold" type="button" data-customer-create disabled="@(!canCreate)" aria-disabled="@(!canCreate)" title="Thêm khách hàng"><i class="ti ti-user-plus" aria-hidden="true"></i>Thêm khách hàng</button></div></div>
<div data-customer-feedback role="alert" class="alert alert-danger d-none"></div>
@if(ViewData["LoadError"] is string loadError){<div class="alert alert-danger" role="alert">@loadError</div>}else{
<div class="ta-table-card ta-customers-table"><div class="card-header ta-toolbar"><div class="input-icon ta-search-compact"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input class="form-control" type="search" aria-label="Tìm khách hàng" placeholder="Tìm mã, tên, MST, email..." oninput="taFilterRows(this.value,'customersTable')" data-customer-search /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="customersTable"><thead><tr><th>Mã KH</th><th>Tên khách hàng</th><th>MST</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr data-ta-row><td><code class="ta-code">@x.Code</code></td><td class="fw-semibold">@x.Name</td><td>@(x.TaxCode??"—")</td><td>@(x.Email??"—")</td><td>@(x.Phone??"—")</td><td><span class="badge badge-ta-active">@x.Status</span></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty ta-customer-empty" role="status"><span class="ta-empty-icon"><i class="ti ti-users-group" aria-hidden="true"></i></span><span>Chưa có khách hàng.</span></div>}@if(Model.Count > 0){<div class="ta-table-empty ta-customer-empty d-none" data-ta-no-results role="status"><span class="ta-empty-icon"><i class="ti ti-users-group" aria-hidden="true"></i></span><span>Không tìm thấy kết quả phù hợp.</span></div>}</div>

}
@if(canCreate){
<dialog id="ta-customer-dialog" class="ta-customer-dialog" aria-labelledby="customer-create-title">
<form asp-controller="Customers" asp-action="Create" method="post" data-customer-form>
<div class="modal-header"><h2 id="customer-create-title" class="modal-title">Thêm khách hàng</h2><button type="button" class="btn-close" data-customer-close aria-label="Đóng"></button></div>
<div class="modal-body"><div data-customer-error role="alert" class="alert alert-danger d-none"></div><div class="ta-customer-fields">
<label class="form-label">Mã khách hàng *<input name="Code" class="form-control" required maxlength="50" aria-label="Mã khách hàng" /></label>
<label class="form-label">Tên khách hàng *<input name="Name" class="form-control" required maxlength="250" aria-label="Tên khách hàng" /></label>
<label class="form-label">Mã số thuế<input name="TaxCode" class="form-control" maxlength="50" aria-label="Mã số thuế" /></label>
<label class="form-label">Email<input name="Email" type="email" class="form-control" maxlength="256" aria-label="Email" /></label>
<label class="form-label">Điện thoại<input name="Phone" class="form-control" maxlength="50" aria-label="Điện thoại" /></label>
<label class="form-label">Trạng thái<select name="Status" class="form-select" aria-label="Trạng thái"><option value="ACTIVE">Hoạt động</option><option value="INACTIVE">Ngừng hoạt động</option></select></label>
</div></div><div class="modal-footer"><button type="button" class="btn btn-ta-secondary" data-customer-close>Hủy</button><button class="btn btn-ta-gold" type="submit">Lưu khách hàng</button></div>
</form></dialog>}
@section Scripts { <script src="~/js/taportal-customers.js" asp-append-version="true"></script> }

@model IReadOnlyList<CustomerRow>
@{ ViewData["Title"]="Khách hàng"; }
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">CRM / Khách hàng</div><h1 class="ta-page-title">Danh sách khách hàng</h1><p class="ta-page-subtitle">Tra cứu hồ sơ và thông tin liên hệ khách hàng T.A.</p></div><div class="ta-page-actions"><button class="btn btn-outline-secondary" disabled title="Chức năng sẽ được bổ sung ở phase sau"><i class="ti ti-file-export"></i>Xuất dữ liệu</button><button class="btn btn-ta-gold" disabled title="CRUD khách hàng nằm ngoài phạm vi Phase 6B"><i class="ti ti-plus"></i>Thêm khách hàng</button></div></div>
<div class="card ta-table-card"><div class="card-header ta-toolbar"><div class="input-icon ta-search-compact"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input class="form-control" type="search" aria-label="Tìm khách hàng" placeholder="Tìm theo mã, tên, MST..." oninput="taFilterRows(this.value,'customersTable')" /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="customersTable"><thead><tr><th>Mã KH</th><th>Tên khách hàng</th><th>MST</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr data-ta-row><td><code class="ta-code">@x.Code</code></td><td class="fw-semibold">@x.Name</td><td>@(x.TaxCode??"—")</td><td>@(x.Email??"—")</td><td>@(x.Phone??"—")</td><td><span class="badge badge-ta-active">@x.Status</span></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty"><i class="ti ti-building-store"></i>Chưa có khách hàng.</div>}<div class="ta-table-empty d-none" data-ta-no-results><i class="ti ti-search-off"></i>Không tìm thấy kết quả phù hợp.</div></div>

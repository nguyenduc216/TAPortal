@model IReadOnlyList<CustomerRow>
@{ ViewData["Title"]="Khách hàng"; }
<div class="page-header"><div class="row align-items-center g-2"><div class="col"><h2 class="page-title">Danh sách khách hàng</h2><div class="text-secondary">Quản lý hồ sơ khách hàng T.A.</div></div><div class="col-auto ms-auto d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" asp-controller="CustomerPortalAccounts" asp-action="Index"><i class="ti ti-user-shield me-1" aria-hidden="true"></i>Tài khoản Customer Portal</a><a class="btn btn-ta-gold" asp-action="Create"><i class="ti ti-plus me-1" aria-hidden="true"></i>Thêm khách hàng</a></div></div></div>
<div class="card ta-table-card mt-3"><div class="card-header"><div class="input-icon"><span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span><input class="form-control" type="search" aria-label="Tìm khách hàng" placeholder="Tìm khách hàng..." oninput="taFilterRows(this.value,'customersTable')" /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="customersTable"><thead><tr><th>Mã KH</th><th>Tên khách hàng</th><th>MST</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th class="w-1">Thao tác</th></tr></thead><tbody>@foreach(var x in Model){var active = x.IsActive && x.Status == "ACTIVE";<tr data-ta-row><td><code>@x.Code</code></td><td class="fw-medium text-break">@x.Name</td><td>@x.TaxCode</td><td class="text-break">@x.Email</td><td>@x.Phone</td><td><span class="badge @(active?"badge-ta-active":"bg-secondary-lt")">@(active?"Hoạt động":"Ngừng")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id" aria-label="Sửa @x.Code"><i class="ti ti-edit" aria-hidden="true"></i>Sửa</a> <a class="btn btn-sm" asp-controller="CustomerPortalAccounts" asp-action="Index" asp-route-customerId="@x.Id" aria-label="Tài khoản portal của @x.Code"><i class="ti ti-users" aria-hidden="true"></i>Tài khoản</a></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty"><i class="ti ti-building-store" aria-hidden="true"></i>Chưa có khách hàng.</div>}<div class="ta-table-empty d-none" data-ta-no-results><i class="ti ti-search-off" aria-hidden="true"></i>Không tìm thấy kết quả phù hợp.</div></div>

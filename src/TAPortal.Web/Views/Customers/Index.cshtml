@model IReadOnlyList<CustomerRow>
@{ ViewData["Title"]="Khách hàng"; var canCreate = ViewData["CanCreate"] is true; var canUpdate = ViewData["CanUpdate"] is true; var canDelete = ViewData["CanDelete"] is true; }
@* CHANGE_ID: TAPORTAL-20261012-CUSTOMERS-001 — MVC retains ownership with current permission-aware actions and shared customer validation. *@
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">CRM / Khách hàng</div><h1 class="ta-page-title">Danh sách khách hàng</h1><p class="ta-page-subtitle">Tra cứu hồ sơ và thông tin liên hệ khách hàng T.A.</p></div><div class="ta-page-actions"><button class="btn btn-ta-secondary" type="button" data-customer-export><i class="ti ti-file-export" aria-hidden="true"></i>Xuất dữ liệu</button><button class="btn btn-ta-gold" type="button" data-customer-create disabled="@(!canCreate)" aria-disabled="@(!canCreate)" title="Thêm khách hàng"><i class="ti ti-user-plus" aria-hidden="true"></i>Thêm khách hàng</button></div></div>
<div data-customer-feedback role="alert" class="alert alert-danger d-none"></div>
@if(ViewData["LoadError"] is string loadError){<div class="alert alert-danger" role="alert">@loadError</div>}else{
<div class="ta-table-card ta-customers-table"><div class="card-header ta-toolbar"><div class="input-icon ta-search-compact"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input class="form-control" type="search" aria-label="Tìm khách hàng" placeholder="Tìm mã, tên, MST, email..." data-customer-search /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="customersTable"><thead><tr><th>Mã KH</th><th>Tên khách hàng</th><th>MST</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model){<tr data-ta-row><td><code class="ta-code">@x.Code</code></td><td class="fw-semibold">@if(!string.IsNullOrWhiteSpace(x.LogoUrl)){<img class="ta-customer-logo" src="@x.LogoUrl" alt="" />}@x.Name</td><td>@(x.TaxCode??"—")</td><td>@(x.Email??"—")</td><td>@(x.Phone??"—")</td><td><span class="badge badge-ta-active">@x.Status</span></td><td class="ta-customer-actions"><button type="button" class="btn btn-ta-edit btn-sm" data-customer-edit="@x.Id" disabled="@(!canUpdate)" title="@(!canUpdate ? "Bạn chưa có quyền sửa" : "Sửa khách hàng")"><i class="ti ti-edit" aria-hidden="true"></i> Sửa</button><button type="button" class="btn btn-ta-delete btn-sm" data-customer-delete="@x.Id" data-customer-name="@x.Name" disabled="@(!canDelete)" title="@(!canDelete ? "Bạn chưa có quyền xóa" : "Xóa khách hàng")"><i class="ti ti-trash" aria-hidden="true"></i> Xóa</button><script type="application/json" id="customer-@x.Id">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(x, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }).Replace("<", "\\u003c"))</script></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty ta-customer-empty" role="status"><span class="ta-empty-icon"><i class="ti ti-users-group" aria-hidden="true"></i></span><span>Chưa có khách hàng.</span></div>}@if(Model.Count > 0){<div class="ta-table-empty ta-customer-empty d-none" data-ta-no-results role="status"><span class="ta-empty-icon"><i class="ti ti-users-group" aria-hidden="true"></i></span><span>Không tìm thấy kết quả phù hợp.</span></div>}<div class="ta-customer-pagination"><span data-customer-page-info></span><div><button type="button" class="btn btn-ta-secondary btn-sm" data-page-prev><i class="ti ti-chevron-left"></i> Trước</button> <button type="button" class="btn btn-ta-secondary btn-sm" data-page-next>Sau <i class="ti ti-chevron-right"></i></button></div></div></div>

}
@if(canCreate || canUpdate){
<dialog id="ta-customer-dialog" class="ta-customer-dialog" aria-labelledby="customer-create-title">
<form asp-controller="Customers" asp-action="Create" method="post" data-customer-form>
@Html.AntiForgeryToken()
<div class="modal-header"><h2 id="customer-create-title" class="modal-title">Thêm khách hàng</h2><button type="button" class="btn-close" data-customer-close aria-label="Đóng"></button></div>
<div class="ta-customer-tabs" role="tablist" aria-label="Hồ sơ khách hàng"><button type="button" role="tab" id="customer-info-tab" aria-controls="customer-info-panel" aria-selected="true" data-customer-tab="info"><i class="ti ti-building"></i> Thông tin</button><button type="button" role="tab" id="customer-contacts-tab" aria-controls="customer-contacts-panel" aria-selected="false" tabindex="-1" data-customer-tab="contacts"><i class="ti ti-address-book"></i> Người liên hệ</button></div>
<div class="modal-body"><div data-customer-error role="alert" class="alert alert-danger d-none"></div><div id="customer-info-panel" role="tabpanel" aria-labelledby="customer-info-tab" data-customer-panel="info"><div class="ta-customer-fields">
<label class="form-label">Mã khách hàng *<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-hash"></i></span><input name="Code" class="form-control" required minlength="6" maxlength="6" pattern="[A-Za-z0-9]{6}" aria-label="Mã khách hàng" /></span></label>
<label class="form-label">Tên khách hàng *<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-building"></i></span><input name="Name" class="form-control" required maxlength="250" aria-label="Tên khách hàng" /></span></label>
<label class="form-label">Mã số thuế<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-file-invoice"></i></span><input name="TaxCode" class="form-control" maxlength="50" aria-label="Mã số thuế" /></span></label>
<label class="form-label">Email<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-mail"></i></span><input name="Email" type="email" class="form-control" maxlength="256" aria-label="Email" /></span></label>
<label class="form-label">Điện thoại<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-phone"></i></span><input name="Phone" class="form-control" maxlength="50" aria-label="Điện thoại" /></span></label>
<label class="form-label">Địa chỉ công ty<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-map-pin"></i></span><input name="Address" class="form-control" maxlength="1000" aria-label="Địa chỉ công ty" /></span></label>
<label class="form-label">URL logo công ty<span class="input-icon"><span class="input-icon-addon"><i class="ti ti-photo"></i></span><input name="LogoUrl" type="url" class="form-control" maxlength="500" aria-label="URL logo công ty" /></span></label>
<label class="form-label">Trạng thái<select name="Status" class="form-select" aria-label="Trạng thái"><option value="ACTIVE">Hoạt động</option><option value="INACTIVE">Ngừng hoạt động</option></select></label>
</div></div><div id="customer-contacts-panel" role="tabpanel" aria-labelledby="customer-contacts-tab" data-customer-panel="contacts" hidden><div class="ta-contact-section"><div class="ta-contact-heading"><h3>Danh sách người liên hệ</h3><button type="button" class="btn btn-ta-secondary btn-sm" data-add-contact><i class="ti ti-user-plus"></i> Thêm người liên hệ</button></div><div class="table-responsive"><table class="table table-vcenter ta-contact-table"><thead><tr><th>Họ tên *</th><th>Chức vụ</th><th>Email</th><th>Điện thoại</th><th aria-label="Thao tác"></th></tr></thead><tbody data-contact-list></tbody></table></div><p data-contact-empty class="ta-contact-empty">Chưa có người liên hệ. Nhấn “Thêm người liên hệ” để bắt đầu.</p></div></div></div><div class="modal-footer"><button type="button" class="btn btn-ta-secondary" data-customer-close><i class="ti ti-x"></i> Hủy</button><button class="btn btn-ta-gold" type="submit"><i class="ti ti-device-floppy"></i> Lưu khách hàng</button></div>
</form></dialog>}
@section Scripts { <script src="~/js/taportal-customers.js" asp-append-version="true"></script> }

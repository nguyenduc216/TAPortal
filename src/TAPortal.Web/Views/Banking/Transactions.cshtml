@model IReadOnlyList<BankTransactionListRow>
@{ViewData["Title"]="Giao dịch ngân hàng";}<div class="page-header"><h2 class="page-title">Giao dịch ngân hàng</h2><div class="text-secondary">Tối đa 500 giao dịch mới nhất từ IPN/đối soát.</div></div><div class="card ta-table-card mt-2"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Thời gian</th><th>Tài khoản</th><th>Chiều</th><th class="text-end">Số tiền</th><th>Mã thanh toán</th><th>Nội dung</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td><td>@x.AccountNumber</td><td><span class="badge @(x.Direction=="CREDIT"?"bg-green-lt":"bg-orange-lt")">@x.Direction</span></td><td class="text-end fw-semibold">@x.Amount.ToString("N0")</td><td><code class="ta-code">@(x.PaymentCode??"—")</code></td><td class="text-truncate" style="max-width:300px">@(x.Content??"—")</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="ta-table-empty"><i class="ti ti-arrows-exchange"></i>Chưa có giao dịch.</div>}</div>
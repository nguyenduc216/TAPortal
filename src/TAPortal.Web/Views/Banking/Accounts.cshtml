@model IReadOnlyList<BankAccountListRow>
@{ViewData["Title"]="Tài khoản ngân hàng";}<div class="page-header"><h2 class="page-title">Tài khoản ngân hàng</h2><div class="text-secondary">Các tài khoản đã liên kết qua provider.</div></div><div class="card ta-table-card mt-2"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Ngân hàng</th><th>Số tài khoản</th><th>Chủ tài khoản</th><th>Kết nối API</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.BankCode</strong></td><td>@x.AccountNumber</td><td>@(x.AccountHolderName??"—")</td><td><i class="ti @(x.Connected?"ti-circle-check text-success":"ti-circle-x text-secondary")"></i></td><td>@x.Status</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="ta-table-empty"><i class="ti ti-building-bank"></i>Chưa có tài khoản ngân hàng.</div>}</div>
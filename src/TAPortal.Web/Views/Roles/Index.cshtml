@model IReadOnlyList<PortalRole>
@{ ViewData["Title"]="Vai trò & phân quyền"; }
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Quản trị hệ thống</div><h1 class="ta-page-title">Vai trò &amp; phân quyền</h1><p class="ta-page-subtitle">Danh mục vai trò trong cấu trúc User → Role → Permission.</p></div><div class="ta-page-actions"><span class="badge bg-blue-lt"><i class="ti ti-shield me-1"></i>@Model.Count vai trò</span></div></div>
<div class="card ta-table-card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Mã vai trò</th><th>Tên vai trò</th><th>Mô tả</th><th>Loại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><code class="ta-code">@x.Code</code></td><td class="fw-semibold">@x.Name</td><td class="text-secondary">@(x.Description??"—")</td><td><span class="badge @(x.IsSystem?"bg-indigo-lt":"bg-azure-lt")">@(x.IsSystem?"Hệ thống":"Tùy chỉnh")</span></td><td><span class="badge @(x.IsActive?"badge-ta-active":"bg-secondary-lt")">@(x.IsActive?"Hoạt động":"Ngừng")</span></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty"><i class="ti ti-shield-lock"></i>Chưa có vai trò.</div>}</div>

@model DepartmentCreateVm
<div class="row g-3">
    @* CHANGE_ID: TAPORTAL-20261013-CRM-PHASE0-001 — branch ownership is selected on create and immutable on edit. *@
    @if (ViewData["HrSchema"] is HrSchemaOptions schema && schema.DepartmentHasBranch && ViewData["HrDepartmentEditing"] is not true)
    {
        <div class="col-12"><label class="form-label">Chi nhánh <span class="text-danger">*</span></label><select class="form-select" name="BranchId" required aria-label="Chi nhánh phòng ban"><option value="">Chọn chi nhánh</option>@foreach(var branch in schema.Branches){<option value="@branch.Id" selected="@(branch.Id==Model.BranchId)">@branch.Code – @branch.Name</option>}</select></div>
    }
    <div class="col-sm-5"><label class="form-label" for="Code-@ViewData.TemplateInfo.HtmlFieldPrefix">Mã phòng ban <span class="text-danger">*</span></label><input class="form-control text-uppercase" name="Code" value="@Model.Code" maxlength="50" required autocomplete="off" placeholder="VD: KT" /></div>
    <div class="col-sm-7"><label class="form-label">Tên phòng ban <span class="text-danger">*</span></label><input class="form-control" name="Name" value="@Model.Name" maxlength="250" required placeholder="VD: Kế toán dịch vụ" /></div>
    <div class="col-12"><label class="form-label">Mô tả</label><textarea class="form-control" name="Description" rows="3" maxlength="1000" placeholder="Mô tả ngắn về chức năng phòng ban">@Model.Description</textarea></div>
    <div class="col-sm-5"><label class="form-label">Thứ tự</label><input class="form-control" name="SortOrder" type="number" min="0" max="9999" value="@Model.SortOrder" /></div>
    <div class="col-sm-7 d-flex align-items-end"><label class="form-check form-switch mb-2"><input type="hidden" name="IsActive" value="false"/>@if(Model.IsActive){<input class="form-check-input" name="IsActive" type="checkbox" value="true" checked/>}else{<input class="form-check-input" name="IsActive" type="checkbox" value="true"/>}<span class="form-check-label">Đang hoạt động</span></label></div>
</div>

@model WebsiteMediaVm
@{
    ViewData["ParentTitle"] = "Website TA";
    ViewData["ParentController"] = "Website";
    ViewData["Title"] = "Thư viện ảnh";
    ViewData["Heading"] = "Thư viện ảnh website";
    ViewData["Subtitle"] = "Ảnh dùng trong các section và bài viết. PNG, JPEG, WEBP hoặc GIF, tối đa 5 MB mỗi ảnh.";
    ViewData["PageIcon"] = "photo";
    var canEdit = AdminPermissions.Has(User, AdminPermissions.WebsiteMediaEdit);
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
@if (Model.Error is not null) {<div class="ta-alert ta-alert--danger" role="alert">@UiIcon.Render("alert-circle")<div class="ta-alert__body">@Model.Error</div></div>}
@if (canEdit)
{
    <form class="card ta-web-upload" asp-action="Upload" method="post" enctype="multipart/form-data">
        <div class="card-body d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1"><label class="form-label" for="mediaFile">Tải ảnh lên</label><div class="ta-input-icon">@UiIcon.Render("upload")<input class="form-control" id="mediaFile" name="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" required /></div></div>
            <div class="flex-grow-1"><label class="form-label" for="mediaAlt">Mô tả ảnh (alt)</label><div class="ta-input-icon">@UiIcon.Render("photo")<input class="form-control" id="mediaAlt" name="alt" maxlength="300" placeholder="VD: Chuyên viên T.A tư vấn kế toán" /></div></div>
            <button class="btn btn-ta-gold" type="submit">@UiIcon.Render("upload")<span>Tải lên</span></button>
        </div>
    </form>
}
<section class="card ta-table-card mt-3" aria-label="Danh sách ảnh">
    <form class="ta-table-toolbar d-flex gap-2" method="get" asp-action="Index">
        <div class="ta-search">@UiIcon.Render("search")<input class="form-control" type="search" name="q" value="@Model.Search" maxlength="100" aria-label="Tìm ảnh" placeholder="Tên file hoặc mô tả..." /></div>
        <button class="btn" type="submit">Tìm</button>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("photo")</span><p class="ta-empty__title">Chưa có ảnh</p><p class="ta-empty__text">Các section đang dùng ảnh mặc định của bản mockup. Tải ảnh thật của T.A lên để thay.</p></div>
    }
    else
    {
        <div class="ta-web-media-grid">
            @foreach (var m in Model.Items)
            {
                <figure class="ta-web-media">
                    <a href="@WebsiteUi.ImageUrl(m.Id)" target="_blank" rel="noopener"><img src="@WebsiteUi.ImageUrl(m.Id)" alt="@m.AltText" loading="lazy" /></a>
                    <figcaption>
                        <b title="@m.FileName">@m.FileName</b>
                        <small>@(m.Width is null ? "" : $"{m.Width}×{m.Height} · ")@WebsiteUi.Size(m.ByteSize) · @WebsiteUi.Local(m.CreatedAt).ToString("dd/MM/yyyy", vi)</small>
                        @if (canEdit)
                        {
                            <form asp-action="Alt" asp-route-id="@m.Id" asp-route-q="@Model.Search" method="post" class="d-flex gap-1 mt-1">
                                <div class="ta-input-icon">@UiIcon.Render("photo")<input class="form-control form-control-sm" name="alt" value="@m.AltText" maxlength="300" aria-label="Mô tả ảnh" placeholder="Mô tả ảnh" /></div>
                                <button class="btn btn-sm btn-icon" type="submit" aria-label="Lưu mô tả">@UiIcon.Render("check")</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@m.Id" asp-route-q="@Model.Search" method="post" data-ta-confirm="Xóa ảnh @m.FileName? Nơi nào đang dùng ảnh sẽ không hiện ảnh nữa.">
                                <button class="btn btn-sm btn-ghost-danger mt-1" type="submit">@UiIcon.Render("trash")<span>Xóa</span></button>
                            </form>
                        }
                        else if (m.AltText is not null) {<small>@m.AltText</small>}
                    </figcaption>
                </figure>
            }
        </div>
    }
</section>

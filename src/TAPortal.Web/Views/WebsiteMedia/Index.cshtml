@model WebsiteMediaVm
@using TAWebsite.Core
@{
    var kind = Model.Kind;
    var key = TAPortal.Web.Controllers.WebsiteMediaController.KindKey(kind);
    ViewData["ParentTitle"] = "Website TA";
    ViewData["ParentController"] = "Website";
    ViewData["Title"] = "Media";
    ViewData["Heading"] = "Media website";
    ViewData["Subtitle"] = kind switch
    {
        MediaKind.Video => "Video chèn vào bài viết: dán link YouTube (khuyên dùng) hoặc tải file MP4 tối đa 25 MB.",
        MediaKind.File => "Tệp PDF cho khách tải về từ bài viết (biểu mẫu, văn bản), tối đa 10 MB mỗi tệp.",
        _ => "Ảnh dùng trong các section và bài viết. PNG, JPEG, WEBP hoặc GIF, tối đa 5 MB mỗi ảnh."
    };
    ViewData["PageIcon"] = "photo";
    var canEdit = AdminPermissions.Has(User, AdminPermissions.WebsiteMediaEdit);
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var noun = kind switch { MediaKind.Video => "video", MediaKind.File => "tệp", _ => "ảnh" };
}
@if (Model.Error is not null) {<div class="ta-alert ta-alert--danger" role="alert">@UiIcon.Render("alert-circle")<div class="ta-alert__body">@Model.Error</div></div>}
<nav class="ta-web-media-tabs" aria-label="Loại media">
    <a asp-action="Index" asp-route-kind="image" aria-current="@(kind == MediaKind.Image ? "page" : null)">@UiIcon.Render("photo")<span>Ảnh</span></a>
    <a asp-action="Index" asp-route-kind="video" aria-current="@(kind == MediaKind.Video ? "page" : null)">@UiIcon.Render("movie")<span>Video</span></a>
    <a asp-action="Index" asp-route-kind="file" aria-current="@(kind == MediaKind.File ? "page" : null)">@UiIcon.Render("file-text")<span>Tệp PDF</span></a>
</nav>
@if (canEdit)
{
    @if (kind == MediaKind.Video)
    {
        <form class="card ta-web-upload" asp-action="AddVideoLink" method="post">
            <div class="card-body d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1"><label class="form-label" for="ytUrl">Link YouTube</label><div class="ta-input-icon">@UiIcon.Render("link")<input class="form-control" id="ytUrl" name="url" type="url" maxlength="500" required placeholder="https://www.youtube.com/watch?v=..." /></div></div>
                <div class="flex-grow-1"><label class="form-label" for="ytTitle">Tên video</label><div class="ta-input-icon">@UiIcon.Render("movie")<input class="form-control" id="ytTitle" name="title" maxlength="250" placeholder="VD: Hướng dẫn quyết toán thuế TNCN" /></div></div>
                <button class="btn btn-ta-gold" type="submit">@UiIcon.Render("plus")<span>Thêm video YouTube</span></button>
            </div>
        </form>
    }
    <form class="card ta-web-upload @(kind == MediaKind.Video ? "mt-2" : "")" asp-action="Upload" asp-route-kind="@key" method="post" enctype="multipart/form-data">
        <div class="card-body d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1"><label class="form-label" for="mediaFile">@(kind switch { MediaKind.Video => "Hoặc tải file MP4 (tối đa 25 MB)", MediaKind.File => "Tải tệp PDF lên", _ => "Tải ảnh lên" })</label>
                <div class="ta-input-icon">@UiIcon.Render("upload")<input class="form-control" id="mediaFile" name="file" type="file" required
                    accept="@(kind switch { MediaKind.Video => "video/mp4", MediaKind.File => "application/pdf", _ => "image/png,image/jpeg,image/webp,image/gif" })" /></div></div>
            <div class="flex-grow-1"><label class="form-label" for="mediaAlt">@(kind == MediaKind.Image ? "Mô tả ảnh (alt)" : "Tên hiển thị")</label><div class="ta-input-icon">@UiIcon.Render("pencil")<input class="form-control" id="mediaAlt" name="alt" maxlength="300"
                placeholder="@(kind switch { MediaKind.Video => "VD: Giới thiệu dịch vụ kế toán T.A", MediaKind.File => "VD: Mẫu tờ khai thuế GTGT", _ => "VD: Chuyên viên T.A tư vấn kế toán" })" /></div></div>
            <button class="btn btn-ta-gold" type="submit">@UiIcon.Render("upload")<span>Tải lên</span></button>
        </div>
    </form>
}
<section class="card ta-table-card mt-3" aria-label="Danh sách @noun">
    <form class="ta-table-toolbar d-flex gap-2" method="get" asp-action="Index">
        <input type="hidden" name="kind" value="@key" />
        <div class="ta-search">@UiIcon.Render("search")<input class="form-control" type="search" name="q" value="@Model.Search" maxlength="100" aria-label="Tìm @noun" placeholder="Tên file hoặc mô tả..." /></div>
        <button class="btn" type="submit">Tìm</button>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render(kind == MediaKind.Image ? "photo" : kind == MediaKind.Video ? "movie" : "file-text")</span><p class="ta-empty__title">Chưa có @noun</p>
            <p class="ta-empty__text">@(kind switch { MediaKind.Video => "Thêm link YouTube hoặc tải MP4 lên, rồi chèn vào bài viết bằng nút ▶ Video.", MediaKind.File => "Tải PDF lên, rồi chèn vào bài viết bằng nút 📄 PDF để khách tải về.", _ => "Các section đang dùng ảnh mặc định của bản mockup. Tải ảnh thật của T.A lên để thay." })</p></div>
    }
    else
    {
        <div class="ta-web-media-grid">
            @foreach (var m in Model.Items)
            {
                var publicUrl = m.YouTubeId is string ytId ? MediaKinds.YouTubeWatchUrl(ytId) : "/media/" + m.Id.ToString("N");
                <figure class="ta-web-media">
                    @if (m.Kind == MediaKind.Image)
                    {
                        <a href="@WebsiteUi.ImageUrl(m.Id)" target="_blank" rel="noopener"><img src="@WebsiteUi.ImageUrl(m.Id)" alt="@m.AltText" loading="lazy" /></a>
                    }
                    else if (m.YouTubeId is string yt)
                    {
                        <a class="ta-web-media__tile" href="@MediaKinds.YouTubeWatchUrl(yt)" target="_blank" rel="noopener"><img src="@MediaKinds.YouTubeThumbUrl(yt)" alt="" loading="lazy" referrerpolicy="no-referrer" /><span class="ta-web-media__play">▶ YouTube</span></a>
                    }
                    else if (m.Kind == MediaKind.Video)
                    {
                        <div class="ta-web-media__tile"><video src="@WebsiteUi.ImageUrl(m.Id)" preload="metadata" controls muted playsinline></video></div>
                    }
                    else
                    {
                        <a class="ta-web-media__tile ta-web-media__tile--pdf" href="@WebsiteUi.ImageUrl(m.Id)" target="_blank" rel="noopener">PDF</a>
                    }
                    <figcaption>
                        <b title="@m.FileName">@m.FileName</b>
                        <small>@(m.Width is null ? "" : $"{m.Width}×{m.Height} · ")@(m.ByteSize > 0 ? WebsiteUi.Size(m.ByteSize) + " · " : "YouTube · ")@WebsiteUi.Local(m.CreatedAt).ToString("dd/MM/yyyy", vi)</small>
                        @if (m.Kind != MediaKind.Image) {<small class="ta-web-media__copy" title="Link dùng trong bài viết">@publicUrl</small>}
                        @if (canEdit)
                        {
                            <form asp-action="Alt" asp-route-id="@m.Id" asp-route-q="@Model.Search" asp-route-kind="@key" method="post" class="d-flex gap-1 mt-1">
                                <div class="ta-input-icon">@UiIcon.Render("pencil")<input class="form-control form-control-sm" name="alt" value="@m.AltText" maxlength="300" aria-label="Mô tả" placeholder="@(kind == MediaKind.Image ? "Mô tả ảnh" : "Tên hiển thị")" /></div>
                                <button class="btn btn-sm btn-icon" type="submit" aria-label="Lưu mô tả">@UiIcon.Render("check")</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@m.Id" asp-route-q="@Model.Search" asp-route-kind="@key" method="post" data-ta-confirm="Xóa @noun @m.FileName? Nơi nào đang dùng sẽ không hiện nữa.">
                                <button class="btn btn-sm btn-ghost-danger mt-1" type="submit">@UiIcon.Render("trash")<span>Xóa</span></button>
                            </form>
                        }
                        else if (m.AltText is not null) {<small>@m.AltText</small>}
                    </figcaption>
                </figure>
            }
        </div>
    }
</section>

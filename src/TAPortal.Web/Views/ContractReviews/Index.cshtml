@model ContractReviewsIndexVm
@{
    ViewData["Title"] = "Hợp đồng dịch vụ";
    ViewData["Heading"] = "Hợp đồng dịch vụ";
    ViewData["Subtitle"] = "Yêu cầu chỉnh lý hợp đồng của khách hàng: AI rà soát, nhân viên duyệt từng góp ý, mỗi vòng sửa là một phiên bản mới.";
    ViewData["PageIcon"] = "file-text";
    var f = Model.Filter;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
@section PageActions {
    <a class="btn" asp-controller="LegalLibrary" asp-action="Index">@UiIcon.Render("list-tree")<span>Kho văn bản pháp luật</span></a>
    @if (AdminPermissions.Has(User, AdminPermissions.ContractReviewCreate)) {<a class="btn btn-ta-gold" asp-action="Create" asp-route-customerId="@f.CustomerId" data-ta-review-create>@UiIcon.Render("plus")<span>Tạo yêu cầu chỉnh lý</span></a>}
}
@if (Model.Error is not null) {<div class="ta-alert ta-alert--danger" role="alert">@UiIcon.Render("alert-circle")<div class="ta-alert__body">@Model.Error</div></div>}
<section class="card ta-table-card" aria-label="Danh sách yêu cầu chỉnh lý">
    <form class="ta-table-toolbar d-flex flex-wrap gap-2 align-items-center" method="get" asp-action="Index">
        <div class="ta-search">@UiIcon.Render("search")<input class="form-control" type="search" name="q" value="@f.Q" maxlength="100" aria-label="Tìm yêu cầu" placeholder="Mã, tên hợp đồng, khách hàng..." /></div>
        <select class="form-select w-auto" name="customerId" aria-label="Khách hàng">
            <option value="">Tất cả khách hàng</option>
            @foreach (var c in Model.Lookups.Customers) {<option value="@c.Id" selected="@(c.Id == f.CustomerId)">@c.Name@(c.Code is null ? "" : " (" + c.Code + ")")</option>}
        </select>
        <select class="form-select w-auto" name="status" aria-label="Trạng thái">
            <option value="">Tất cả trạng thái</option>
            @foreach (var s in ContractReviewPolicy.Statuses) {<option value="@s.Code" selected="@(s.Code == f.StatusOrNull)">@s.Label</option>}
        </select>
        <button class="btn" type="submit">@UiIcon.Render("search")<span>Lọc</span></button>
    </form>
    @if (Model.Items is null)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("database-off")</span><p class="ta-empty__title">Không tải được dữ liệu</p></div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("file-text")</span><p class="ta-empty__title">Chưa có yêu cầu chỉnh lý</p><p class="ta-empty__text">Bấm "Tạo yêu cầu chỉnh lý" và tải file Word hợp đồng của khách hàng.</p></div>
    }
    else
    {
        <div class="ta-table-wrap">
            <table class="ta-table ta-table-stack" id="reviewsTable" data-ta-pager="20">
                <thead><tr><th scope="col">Mã</th><th scope="col">Hợp đồng</th><th scope="col">Khách hàng</th><th scope="col">Rà soát cho</th><th scope="col">Phiên bản</th><th scope="col">Trạng thái</th><th scope="col">Tạo lúc</th><th scope="col" class="ta-col-actions">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var x in Model.Items)
                {
                    <tr data-ta-row data-ta-review="@x.Code">
                        <td data-label="Mã"><span class="ta-code">@x.Code</span></td>
                        <td class="ta-cell-strong"><a class="text-reset" asp-action="Details" asp-route-id="@x.Id">@x.Title</a>@if (x.OpenFindings > 0) {<div class="ta-cell-sub">@x.OpenFindings góp ý chưa xử lý</div>}</td>
                        <td data-label="Khách hàng">@x.CustomerName@if (x.CustomerCode is not null) {<div class="ta-cell-sub">@x.CustomerCode</div>}</td>
                        <td data-label="Rà soát cho">@ContractReviewPolicy.Label(ContractReviewPolicy.Roles, x.Role)</td>
                        <td data-label="Phiên bản">@(x.CurrentVersionNo == 0 ? "Bản gốc" : "v" + x.CurrentVersionNo)</td>
                        <td data-label="Trạng thái"><span class="ta-badge @ContractReviewPolicy.StatusBadge(x.Status)">@if (x.Status == ContractReviewPolicy.Analyzing) {<span class="ta-rv-spinner ta-rv-spinner--sm" aria-hidden="true"></span>}@ContractReviewPolicy.Label(ContractReviewPolicy.Statuses, x.Status)</span></td>
                        <td class="ta-nowrap" data-label="Tạo lúc">@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm", vi)@if (x.CreatedByName is not null) {<div class="ta-cell-sub">@x.CreatedByName</div>}</td>
                        <td class="ta-col-actions"><div class="ta-actions"><a class="btn btn-sm btn-soft-primary" asp-action="Details" asp-route-id="@x.Id" aria-label="Mở yêu cầu @x.Code">@UiIcon.Render("eye")<span>Mở</span></a></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="ta-table-footer" data-ta-pager-for="reviewsTable" data-ta-unit="yêu cầu"></div>
    }
</section>

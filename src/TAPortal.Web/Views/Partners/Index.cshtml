@model IReadOnlyList<PartnerListRow>
@{ViewData["Title"]="Đối tác";}
<div class="page-header"><h2 class="page-title">Đối tác</h2><div class="text-secondary">Tenant sử dụng T.A Portal.</div></div><div class="card ta-table-card mt-2"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Mã</th><th>Tên đối tác</th><th>Loại</th><th>MST</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><code class="ta-code">@x.Code</code></td><td><strong>@x.Name</strong>@if(x.IsPlatformOwner){<span class="badge bg-yellow-lt ms-1">Platform</span>}</td><td>@x.PartnerType</td><td>@(x.TaxCode??"—")</td><td><span class="badge badge-ta-active">@x.Status</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="ta-table-empty"><i class="ti ti-building-community"></i>Chưa có đối tác.</div>}</div>
@model ErrorVm
@{
    ViewData["Title"] = "Lỗi hệ thống";
    ViewData["HideHeader"] = true;
}
<section class="card mx-auto" style="max-width:560px">
    <div class="ta-empty">
        <span class="ta-empty__icon" style="background:var(--ta-danger-soft);color:var(--ta-danger-text)">@UiIcon.Render("alert-triangle")</span>
        <h1 class="ta-empty__title">Không thể xử lý yêu cầu</h1>
        <p class="ta-empty__text">Hệ thống đã ghi nhận lỗi. Vui lòng thử lại sau hoặc liên hệ quản trị viên.</p>
        @if (!string.IsNullOrWhiteSpace(Model.RequestId))
        {
            <p class="ta-empty__text small">Mã yêu cầu: <span class="ta-code">@Model.RequestId</span></p>
        }
    </div>
</section>

@model DashboardVm
@{ ViewData["Title"] = "Tổng quan"; }
<div class="ta-page-header"><div class="ta-page-heading"><div class="ta-page-pretitle">Dashboard điều hành</div><h1 class="ta-page-title">Tổng quan hệ thống</h1><p class="ta-page-subtitle">Theo dõi nhanh dữ liệu vận hành hiện có của T.A Portal.</p></div><div class="ta-page-actions"><span class="badge bg-azure-lt"><i class="ti ti-clock me-1"></i>Cập nhật theo thời gian thực</span></div></div>
<div class="row row-deck row-cards">
@foreach (var item in new[]{("Khách hàng",Model.CustomerCount,"ti-building-store","#176b87"),("Người dùng",Model.UserCount,"ti-users","#6758c5"),("Đang hoạt động",Model.ActiveUserCount,"ti-user-check","#16845b"),("Vai trò",Model.RoleCount,"ti-shield-lock","#d68b12")}) {
<div class="col-sm-6 col-xl-3"><div class="card ta-stat-card" style="--ta-stat-accent:@item.Item4"><div class="card-body"><div class="d-flex align-items-center"><div class="ta-stat-icon me-3"><i class="ti @item.Item3"></i></div><div><div class="ta-stat-label">@item.Item1</div><div class="ta-stat-value">@item.Item2</div></div></div></div></div></div>}
<div class="col-lg-7"><div class="card h-100"><div class="card-header"><h2 class="card-title"><i class="ti ti-activity me-2 text-azure"></i>Hoạt động gần đây</h2></div><div class="ta-empty-state"><i class="ti ti-history"></i><h3 class="h4 mt-2 mb-1">Nhật ký hoạt động</h3><p class="mb-0">Module audit sẽ hiển thị các thao tác gần nhất tại đây.</p></div></div></div>
<div class="col-lg-5"><div class="card h-100"><div class="card-header"><h2 class="card-title"><i class="ti ti-heart-rate-monitor me-2 text-teal"></i>Trạng thái hệ thống</h2></div><div class="list-group list-group-flush ta-system-list"><div class="list-group-item d-flex justify-content-between"><span><i class="ti ti-browser me-2 text-secondary"></i>Ứng dụng</span><span class="badge badge-ta-active">Hoạt động</span></div><div class="list-group-item d-flex justify-content-between"><span><i class="ti ti-database me-2 text-secondary"></i>Cơ sở dữ liệu</span><span class="badge badge-ta-active">Kết nối</span></div><div class="list-group-item d-flex justify-content-between"><span><i class="ti ti-shield-check me-2 text-secondary"></i>Phân quyền</span><span class="badge bg-blue-lt">RBAC</span></div></div></div></div>
</div>

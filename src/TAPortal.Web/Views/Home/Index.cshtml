@model DashboardPageVm
@{
    ViewData["Title"] = "Tổng quan";
    ViewData["Heading"] = "Tổng quan hệ thống";
    ViewData["PageIcon"] = "layout-dashboard";
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string N(int value) => value.ToString("N0", vi);
    var d = Model.Data;
    if (d is not null) ViewData["Subtitle"] = $"Số liệu đọc trực tiếp từ cơ sở dữ liệu lúc {d.LoadedAtUtc.ToString("HH:mm:ss dd/MM/yyyy", vi)} (UTC).";
    string ActionLabel(string action) => action switch
    {
        "USER_ROLES_UPDATED" => "Cập nhật vai trò người dùng",
        "USER_UPDATED" => "Cập nhật thông tin người dùng",
        "USER_SOFT_DELETED" => "Xóa mềm người dùng",
        _ => action
    };
}
@if (d is null)
{
    <div class="ta-alert ta-alert--danger" role="alert" data-ta-dashboard-error>@UiIcon.Render("database-off")<div class="ta-alert__body"><span class="ta-alert__title">Không tải được số liệu</span>Không tải được số liệu từ cơ sở dữ liệu. Chi tiết đã được ghi vào nhật ký ứng dụng; vui lòng thử lại hoặc liên hệ quản trị hệ thống.</div></div>
}
else
{
<section class="ta-kpi-grid" aria-label="Chỉ số chính">
    <a class="card ta-stat-card" asp-controller="Users" asp-action="Index" data-ta-kpi="users">
        <div class="ta-stat-head"><span class="ta-stat-icon">@UiIcon.Render("users")</span><div><div class="ta-stat-label">Người dùng hiện hành</div><div class="ta-stat-value">@N(d.Users.CurrentTotal)</div></div></div>
        <ul class="ta-stat-list"><li>Được đăng nhập: <strong>@N(d.Users.Active)</strong></li><li>Đã vô hiệu hóa: <strong>@N(d.Users.Disabled)</strong></li><li>Bị khóa theo trạng thái: <strong>@N(d.Users.Locked)</strong></li></ul>
    </a>
    <a class="card ta-stat-card" asp-controller="Customers" asp-action="Index" data-ta-kpi="customers">
        <div class="ta-stat-head"><span class="ta-stat-icon ta-stat-icon--gold">@UiIcon.Render("building")</span><div><div class="ta-stat-label">Khách hàng hiện hành</div><div class="ta-stat-value">@N(d.Customers.CurrentTotal)</div></div></div>
        <ul class="ta-stat-list"><li>Đang hoạt động: <strong>@N(d.Customers.Active)</strong></li><li>Ngừng hoạt động: <strong>@N(d.Customers.Inactive)</strong></li></ul>
    </a>
    <a class="card ta-stat-card" asp-controller="Customers" asp-action="Accounts" data-ta-kpi="memberships">
        <div class="ta-stat-head"><span class="ta-stat-icon ta-stat-icon--green">@UiIcon.Render("users-group")</span><div><div class="ta-stat-label">Quyền Customer Portal có hiệu lực</div><div class="ta-stat-value">@(d.Memberships is null ? "—" : N(d.Memberships.EffectiveMemberships))</div></div></div>
        @if (d.Memberships is null) {<div class="ta-stat-list">Chưa có dữ liệu (bảng membership chưa sẵn sàng).</div>}
        else {<ul class="ta-stat-list"><li>Tài khoản có quyền: <strong>@N(d.Memberships.UsersWithAccess)</strong></li><li>Đã thu hồi / không hiệu lực: <strong>@N(d.Memberships.RevokedOrIneffective)</strong></li></ul>}
    </a>
    <a class="card ta-stat-card" asp-controller="Roles" asp-action="Index" data-ta-kpi="roles">
        <div class="ta-stat-head"><span class="ta-stat-icon ta-stat-icon--navy">@UiIcon.Render("shield-check")</span><div><div class="ta-stat-label">Vai trò đang hoạt động</div><div class="ta-stat-value">@N(d.ActiveRoles)</div></div></div>
        <div class="ta-stat-list">Tài khoản đã xóa mềm (lịch sử): <strong>@N(d.Users.SoftDeleted)</strong></div>
    </a>
</section>
}
<div class="ta-dash-grid">
    <section class="card" aria-labelledby="recentTitle">
        <div class="card-header"><h2 class="card-title" id="recentTitle">@UiIcon.Render("history")Thay đổi quản trị gần đây</h2></div>
        @if (d is null) {<div class="card-body text-secondary">Không có dữ liệu do không tải được cơ sở dữ liệu.</div>}
        else if (!d.AuditTableVisible) {<div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("history")</span><p class="ta-empty__title">Nhật ký audit chưa sẵn sàng</p><p class="ta-empty__text">Không tìm thấy bảng dbo.AuditLogs. Operator cần chạy script kiểm tra database/scripts/007-verify-audit-logs.sql.</p></div>}
        else if (d.RecentAudit is null) {<div class="card-body text-secondary">Không đọc được nhật ký audit (tài khoản ứng dụng chỉ có quyền ghi). Thay đổi vẫn được ghi nhận.</div>}
        else if (d.RecentAudit.Count == 0) {<div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("inbox")</span><p class="ta-empty__text">Chưa có thay đổi nào được ghi nhận.</p></div>}
        else {<ul class="ta-list">@foreach (var a in d.RecentAudit) {<li><span><strong>@ActionLabel(a.Action)</strong><span class="text-secondary"> — @(a.ActorName ?? "không xác định")</span></span><time class="text-secondary small" datetime="@a.CreatedAtUtc.ToString("o")">@a.CreatedAtUtc.ToString("HH:mm dd/MM/yyyy", vi) UTC</time></li>}</ul>}
    </section>
    <section class="card" aria-labelledby="statusTitle">
        <div class="card-header"><h2 class="card-title" id="statusTitle">@UiIcon.Render("info-circle")Trạng thái hệ thống</h2></div>
        <div class="ta-list">
            <div><span>Cơ sở dữ liệu</span>@if (d is null) {<span class="ta-badge ta-badge--danger" data-ta-db-status="down">Không đọc được</span>} else {<span class="ta-badge ta-badge--success" data-ta-db-status="up">Đọc được dữ liệu</span>}</div>
            <div><span>Bảng nhật ký audit</span>@if (d is null) {<span class="ta-badge ta-badge--neutral">Không xác định</span>} else if (d.AuditTableVisible) {<span class="ta-badge ta-badge--success">Có</span>} else {<span class="ta-badge ta-badge--warning">Chưa có</span>}</div>
            <div><span>Bắt buộc audit bền vững</span><span class="ta-badge @(Model.RequireDurableAudit ? "ta-badge--success" : "ta-badge--warning")">@(Model.RequireDurableAudit ? "Bật" : "Tắt (chờ xác minh)")</span></div>
            <div><span>Giới hạn đăng nhập</span><span class="text-secondary small">@Model.LoginAccountLimit lần/tài khoản, @Model.LoginIpLimit lần/IP mỗi @Model.LoginWindow.TotalMinutes.ToString("0", vi) phút</span></div>
        </div>
    </section>
</div>

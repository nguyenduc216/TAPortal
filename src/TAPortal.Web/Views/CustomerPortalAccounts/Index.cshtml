@model List<MembershipAdminRow>
@{
    ViewData["Title"] = "Tài khoản Customer Portal";
    ViewData["Subtitle"] = "Cấp quyền truy cập Customer Portal theo từng doanh nghiệp. Vai trò OWNER/ADMIN/VIEWER chỉ có hiệu lực trong Customer Portal, không cấp quyền quản trị TAPortal.";
    ViewData["PageIcon"] = "users-group";
    ViewData["ParentTitle"] = "Khách hàng";
    ViewData["ParentController"] = "Customers";
    var customers = (List<CustomerRow>)ViewBag.Customers;
    var users = (List<PortalUser>)ViewBag.Users;
    var selected = ViewBag.CustomerId as Guid?;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<div class="row g-4">
<div class="col-12">
<form class="card" asp-action="Save" method="post">
    <div class="card-header"><h2 class="card-title">@UiIcon.Render("user-plus")Tạo / gán tài khoản</h2></div>
    <div class="card-body">
        <div class="ta-form-grid ta-form-grid--3">
            <div><label class="form-label required" for="cpCustomer">Doanh nghiệp</label><select id="cpCustomer" name="CustomerId" class="form-select" required><option value="">-- Chọn doanh nghiệp --</option>@foreach (var c in customers) {var ok = c.IsActive && c.Status == "ACTIVE";<option value="@c.Id" selected="@(selected == c.Id)" disabled="@(!ok)">@c.Code — @c.Name@(ok ? "" : " (ngừng hoạt động)")</option>}</select></div>
            <div><label class="form-label" for="cpUser">Tài khoản</label><select id="cpUser" name="UserId" class="form-select" onchange="document.getElementById('cpNewUser').hidden = this.value !== ''"><option value="">+ Tạo tài khoản mới</option><optgroup label="Tài khoản hiện có">@foreach (var u in users) {var ok = u.IsActive && u.Status == "ACTIVE";<option value="@u.Id" disabled="@(!ok)">@u.Username — @u.DisplayName@(ok ? "" : " (ngừng)")</option>}</optgroup></select><div class="form-hint">Một tài khoản có thể được gán cho nhiều doanh nghiệp.</div></div>
            <div><label class="form-label" for="cpRole">Vai trò trong doanh nghiệp</label><select id="cpRole" name="PortalRole" class="form-select"><option value="VIEWER">VIEWER — chỉ xem</option><option value="ADMIN">ADMIN — quản trị doanh nghiệp</option><option value="OWNER">OWNER — chủ sở hữu</option></select></div>
            <fieldset id="cpNewUser" class="ta-fieldset ta-span-all"><legend>Thông tin tài khoản mới</legend>
                <div class="ta-form-grid">
                    <div><label class="form-label required" for="cpUsername">Tên đăng nhập</label><input id="cpUsername" class="form-control" name="Username" maxlength="100" autocomplete="off" /></div>
                    <div><label class="form-label required" for="cpDisplay">Họ tên</label><input id="cpDisplay" class="form-control" name="DisplayName" maxlength="200" /></div>
                    <div><label class="form-label" for="cpEmail">Email</label><input id="cpEmail" class="form-control" name="Email" type="email" maxlength="256" /></div>
                    <div><label class="form-label required" for="cpPassword">Mật khẩu ban đầu</label><input id="cpPassword" class="form-control" name="Password" type="password" maxlength="256" autocomplete="new-password" oninput="taCheckPassword(this.value,'cpRules')" />
                        <ul id="cpRules" class="password-rules"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div>
                </div>
            </fieldset>
        </div>
    </div>
    <div class="card-footer ta-form-actions"><button type="submit" class="btn btn-primary ms-auto" data-ta-loading data-ta-loading-text="Đang lưu...">@UiIcon.Render("device-floppy")<span>Lưu và kích hoạt</span></button></div>
</form>
</div>
<div class="col-12">
<section class="card ta-table-card" aria-label="Danh sách quyền truy cập Customer Portal">
    <div class="ta-table-toolbar">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap flex-grow-1" style="max-width:360px"><label class="ta-visually-hidden" for="cpFilter">Lọc theo doanh nghiệp</label><select id="cpFilter" name="customerId" class="form-select" onchange="this.form.submit()"><option value="">Tất cả doanh nghiệp</option>@foreach (var c in customers) {<option value="@c.Id" selected="@(selected == c.Id)">@c.Code — @c.Name</option>}</select><noscript><button class="btn" type="submit">Lọc</button></noscript></form>
        <div class="ta-search">@UiIcon.Render("search")<input class="form-control" type="search" aria-label="Tìm tài khoản" placeholder="Tìm tài khoản, doanh nghiệp..." oninput="taFilterRows(this.value,'membershipTable')" /></div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("users-group")</span><p class="ta-empty__title">Chưa có tài khoản Customer Portal@(selected.HasValue ? " cho doanh nghiệp này" : "").</p><p class="ta-empty__text">Dùng biểu mẫu "Tạo / gán tài khoản" để cấp quyền truy cập.</p></div>
    }
    else
    {
        <div class="ta-table-wrap">
            <table class="ta-table ta-table-stack" id="membershipTable">
                <thead><tr><th scope="col">Tài khoản</th><th scope="col">Doanh nghiệp</th><th scope="col">Vai trò</th><th scope="col">Quyền truy cập</th><th scope="col">Đăng nhập gần nhất (UTC)</th><th scope="col" class="ta-col-actions">Thu hồi</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    var effect = TAPortal.Web.Services.MembershipDisplay.Evaluate(r.Active, r.Status, customers.FirstOrDefault(c => c.Id == r.CustomerId));
                    <tr data-ta-row>
                        <td class="ta-cell-strong"><div>@r.DisplayName</div><div class="ta-cell-sub">@r.Username</div>@if (!string.IsNullOrEmpty(r.Email)) {<div class="ta-cell-sub text-break">@r.Email</div>}</td>
                        <td data-label="Doanh nghiệp">@r.CustomerName</td>
                        <td data-label="Vai trò"><form asp-action="Save" method="post" class="d-flex gap-1 justify-content-end justify-content-md-start"><input type="hidden" name="UserId" value="@r.UserId" /><input type="hidden" name="CustomerId" value="@r.CustomerId" /><select name="PortalRole" class="form-select form-select-sm" style="width:auto" aria-label="Vai trò của @r.Username">@foreach (var role in new[] { "OWNER", "ADMIN", "VIEWER" }) {<option selected="@(r.Role == role)" value="@role">@role</option>}</select><button type="submit" class="btn btn-sm ta-btn-icon" title="Lưu vai trò (đồng thời kích hoạt quyền truy cập)" aria-label="Lưu vai trò của @r.Username">@UiIcon.Render("check")</button></form></td>
                        <td data-label="Quyền truy cập"><span class="ta-badge @(effect.Effective ? "ta-badge--success" : r.Active ? "ta-badge--warning" : "ta-badge--neutral")">@effect.Label</span>@if (effect.Reason is not null) {<div class="small mt-1" style="color:var(--ta-danger-text)">Lý do: @effect.Reason</div>}</td>
                        <td class="ta-nowrap" data-label="Đăng nhập gần nhất">@(r.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="ta-col-actions"><form asp-action="SetActive" method="post"><input type="hidden" name="userId" value="@r.UserId" /><input type="hidden" name="customerId" value="@r.CustomerId" /><input type="hidden" name="active" value="@((!r.Active).ToString())" /><button type="submit" class="btn btn-sm @(r.Active ? "btn-outline-danger" : "btn-outline-primary")">@UiIcon.Render(r.Active ? "lock" : "lock-open")<span>@(r.Active ? "Thu hồi" : "Kích hoạt lại")</span></button></form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="ta-empty d-none" data-ta-no-results><span class="ta-empty__icon">@UiIcon.Render("search-off")</span><p class="ta-empty__title">Không tìm thấy kết quả phù hợp</p></div>
        <div class="ta-table-footer"><span>Hiển thị <strong data-ta-visible-count>@Model.Count.ToString("N0", vi)</strong> / @Model.Count.ToString("N0", vi) quyền truy cập</span></div>
    }
    <div class="card-footer text-secondary small">"Thu hồi" chỉ gỡ quyền truy cập doanh nghiệp tương ứng, không khóa tài khoản dùng chung. Để khóa tài khoản, dùng màn hình Người dùng.</div>
</section>
</div>
</div>

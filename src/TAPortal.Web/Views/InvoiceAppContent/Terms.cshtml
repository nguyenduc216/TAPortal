@model TAPortal.Web.Controllers.InvoiceAppTermsVm
@{
    ViewData["Title"] = "Điều khoản dịch vụ";
    ViewData["Heading"] = "Điều khoản sử dụng dịch vụ Hóa đơn tự động";
    ViewData["Subtitle"] = "Hiện trong hộp thoại khi khách bấm \"điều khoản sử dụng\" lúc đăng ký và tại trang /account/terms của Hóa đơn tự động.";
    ViewData["PageIcon"] = "file-text";
    var canEdit = AdminPermissions.Has(User, AdminPermissions.InvoiceAppContentEdit);
    var articles = PortalTerms.Parse(Model.Body);
    var placeholders = System.Text.RegularExpressions.Regex.Matches(Model.Body, @"\[[^\]\r\n]{2,40}\]").Select(m => m.Value).Distinct().ToList();
}
@if (Model.Errors.Count > 0) {<div class="ta-alert ta-alert--danger" role="alert">@UiIcon.Render("alert-circle")<div class="ta-alert__body">@foreach (var e in Model.Errors) {<div>@e</div>}</div></div>}
@if (placeholders.Count > 0) {<div class="ta-alert ta-alert--warning" role="status">@UiIcon.Render("alert-triangle")<div class="ta-alert__body">Còn @placeholders.Count chỗ cần điền: @string.Join(", ", placeholders). Khách hàng đang thấy nguyên các chỗ này.</div></div>}
<div class="ta-content-split">
    <form class="card" asp-action="Terms" method="post">
        <div class="card-header"><h2 class="card-title">@UiIcon.Render("pencil")Nội dung</h2><span class="ta-cell-sub ms-auto">@(Model.Saved is null ? "Đang dùng bản soạn sẵn" : "Sửa lần cuối " + Model.Saved.UpdatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm"))</span></div>
        <div class="card-body">
            <fieldset disabled="@(!canEdit)">
                <div class="ta-input-icon">@UiIcon.Render("file-text")<textarea class="form-control ta-mono-area" name="body" rows="30" maxlength="200000" required aria-label="Nội dung điều khoản">@Model.Body</textarea></div>
                <small class="form-hint">Mỗi điều bắt đầu bằng một dòng "## " (ví dụ "## Điều 1. Phạm vi áp dụng"); dòng bắt đầu bằng "- " là gạch đầu dòng; dòng trống tách đoạn. Bản soạn sẵn dựa trên pháp luật hiện hành tháng 11/2026 và cần luật sư rà soát trước khi áp dụng chính thức.</small>
            </fieldset>
        </div>
        @if (canEdit)
        {
            <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
                @if (Model.Saved is not null) {<button class="btn" type="submit" name="command" value="reset" formnovalidate data-ta-confirm="Bỏ nội dung đã sửa và dùng lại bản soạn sẵn?">@UiIcon.Render("refresh")<span>Khôi phục bản soạn sẵn</span></button>}
                <button class="btn" type="submit" name="command" value="preview">@UiIcon.Render("eye")<span>Xem trước</span></button>
                <button class="btn btn-ta-gold" type="submit" name="command" value="save">@UiIcon.Render("device-floppy")<span>Lưu điều khoản</span></button>
            </div>
        }
    </form>
    <section class="card" aria-label="Xem trước điều khoản">
        <div class="card-header"><h2 class="card-title">@UiIcon.Render("eye")Xem trước (@articles.Count(a => a.Title.Length > 0) điều)</h2></div>
        <div class="card-body ta-terms-preview">
            @foreach (var a in articles)
            {
                <details open>
                    <summary>@(a.Title.Length > 0 ? a.Title : "Giới thiệu")</summary>
                    @foreach (var p in a.Paragraphs.SelectMany(b => PortalEmailRenderer.Runs(b.ToList())))
                    {
                        if (p.All(l => l.StartsWith("- ", StringComparison.Ordinal))) {<ul>@foreach (var l in p) {<li>@l[2..]</li>}</ul>}
                        else {<p>@for (var k = 0; k < p.Count; k++) {@if (k > 0) {<br />}@p[k]}</p>}
                    }
                </details>
            }
        </div>
    </section>
</div>

@model IReadOnlyList<InvoiceListRow>
@{ViewData["Title"]="Hóa đơn";}<div class="page-header"><h2 class="page-title">Hóa đơn</h2><div class="text-secondary">Hàng đợi và trạng thái phát hành hóa đơn.</div></div><div class="card ta-table-card mt-2"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Thời gian</th><th>Khách hàng</th><th>IKey</th><th class="text-end">Số tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@x.CustomerName</strong></td><td><code class="ta-code">@x.Ikey</code></td><td class="text-end">@x.RequestedAmount.ToString("N0")</td><td><span class="badge @(x.Status=="ISSUED"?"bg-green-lt":x.Status=="FAILED"?"bg-red-lt":"bg-blue-lt")">@x.Status</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="ta-table-empty"><i class="ti ti-receipt-2"></i>Chưa có yêu cầu hóa đơn.</div>}</div>
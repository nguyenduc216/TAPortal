@model IReadOnlyList<PaymentRequestListRow>
@{ViewData["Title"]="Yêu cầu thanh toán";}<div class="page-header"><h2 class="page-title">Yêu cầu thanh toán</h2><div class="text-secondary">Theo dõi gạch nợ và thanh toán nhiều lần.</div></div><div class="card ta-table-card mt-2"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Mã chuyển khoản</th><th class="text-end">Phải thu</th><th class="text-end">Đã thu</th><th class="text-end">Còn lại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){var remain=Math.Max(0,x.AmountDue-x.AmountPaid);<tr><td><strong>@x.Code</strong></td><td>@(x.CustomerName??"—")</td><td><code class="ta-code">@x.PaymentCode</code></td><td class="text-end">@x.AmountDue.ToString("N0")</td><td class="text-end">@x.AmountPaid.ToString("N0")</td><td class="text-end fw-semibold">@remain.ToString("N0")</td><td><span class="badge @(x.Status=="PAID"?"bg-green-lt":x.Status=="PARTIALLY_PAID"?"bg-yellow-lt":"bg-blue-lt")">@x.Status</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="ta-table-empty"><i class="ti ti-qrcode"></i>Chưa có yêu cầu thanh toán.</div>}</div>
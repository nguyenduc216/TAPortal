@model UserRoleSnapshot
@{
    ViewData["Title"] = "Vai trò người dùng";
    ViewData["Heading"] = "Vai trò: " + Model.DisplayName;
    ViewData["Subtitle"] = "Tài khoản " + Model.Username + " — vai trò quản trị TAPortal.";
    ViewData["PageIcon"] = "shield-lock";
    ViewData["ParentTitle"] = "Người dùng";
    ViewData["ParentController"] = "Users";
    var actorId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isSelf = string.Equals(actorId, Model.UserId.ToString(), StringComparison.OrdinalIgnoreCase);
    var adminCount = Model.SystemAdminIds.Count;
    var active = Model.UserActive && Model.Status == "ACTIVE";
    // Only a SYS_ADMIN may grant/revoke SYS_ADMIN or change the roles of an account holding it (re-checked on the server).
    var actorIsSystemAdmin = AdminPermissions.IsSystemAdmin(User);
    var targetIsSystemAdmin = Model.Roles.Any(r => r.Code == RoleChangePolicy.SystemAdminCode && Model.AssignedRoleIds.Contains(r.Id));
    var locked = !actorIsSystemAdmin && targetIsSystemAdmin;
}
<div class="row g-4">
<div class="col-xl-7">
<form class="card" asp-action="Roles" asp-route-id="@Model.UserId" method="post">
    <input type="hidden" name="stamp" value="@Model.Stamp" />
    <div class="card-header"><h2 class="card-title">@UiIcon.Render("shield-check")Vai trò quản trị TAPortal</h2><span class="ms-auto d-flex gap-2"><span class="ta-badge @(active ? "ta-badge--success" : "ta-badge--danger")">@(active ? "Hoạt động" : "Ngừng")</span>@if (isSelf) {<span class="ta-badge ta-badge--warning ta-badge--plain">Tài khoản của bạn</span>}</span></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="ta-alert ta-alert--danger" role="alert"></div>
        @if (locked) {<div class="ta-alert ta-alert--warning" role="note" data-ta-sysadmin-locked>@UiIcon.Render("lock")<div class="ta-alert__body">Tài khoản này có vai trò Quản trị hệ thống (SYS_ADMIN): chỉ quản trị hệ thống mới được thay đổi vai trò của tài khoản này.</div></div>}
        <fieldset disabled="@locked">
            <legend class="ta-visually-hidden">Vai trò quản trị TAPortal</legend>
            <div class="ta-check-list">
            @foreach (var role in Model.Roles)
            {
                var assigned = Model.AssignedRoleIds.Contains(role.Id);
                if (!role.IsActive)
                {
                    if (assigned) {<label class="ta-check-card" for="role-@role.Id"><input class="form-check-input" type="checkbox" checked disabled id="role-@role.Id" /><span data-ta-role-code="@role.Code"><span class="text-secondary">@role.Name</span><span class="d-block form-hint mt-1">Vai trò đã ngừng hoạt động, được giữ nguyên</span></span></label>}
                    continue;
                }
                var sysAdminRole = role.Code == RoleChangePolicy.SystemAdminCode;
                if (sysAdminRole && !actorIsSystemAdmin)
                {
                    <label class="ta-check-card" for="role-@role.Id"><input class="form-check-input" type="checkbox" checked="@assigned" disabled id="role-@role.Id" /><span data-ta-role-code="@role.Code"><span class="fw-semibold">@role.Name</span><span class="d-block form-hint mt-1">Chỉ quản trị hệ thống mới được gán hoặc gỡ vai trò này</span></span></label>
                    continue;
                }
                <label class="ta-check-card" for="role-@role.Id">
                    <input class="form-check-input" type="checkbox" name="roleIds" value="@role.Id" id="role-@role.Id" checked="@assigned" />
                    <span data-ta-role-code="@role.Code"><span class="fw-semibold">@role.Name</span>@if (role.Code == RoleChangePolicy.SystemAdminCode) {<span class="ta-badge ta-badge--danger ta-badge--plain ms-2">Toàn quyền hệ thống</span>}</span>
                </label>
            }
            </div>
        </fieldset>
        <div class="form-hint mt-3">
            Cần quyền "Tạo, sửa, xóa vai trò; gán vai trò cho người dùng"; chỉ SYS_ADMIN được gán hoặc gỡ vai trò SYS_ADMIN. Không thể gỡ SYS_ADMIN khỏi quản trị viên hoạt động cuối cùng (hiện có @adminCount quản trị viên hoạt động).
            Thay đổi có hiệu lực từ request kế tiếp của người dùng; mật khẩu, tên đăng nhập và quyền Customer Portal (OWNER/ADMIN/VIEWER) không bị ảnh hưởng.
        </div>
        @if (Model.IsLastSystemAdmin) {<div class="ta-alert ta-alert--info mt-3 mb-0" role="note" data-ta-last-admin>@UiIcon.Render("info-circle")<div class="ta-alert__body">Đây là quản trị viên hệ thống (SYS_ADMIN) hoạt động cuối cùng: không thể gỡ vai trò SYS_ADMIN của tài khoản này.</div></div>}
        @if (isSelf) {<div class="ta-alert ta-alert--warning mt-3 mb-0" role="note">@UiIcon.Render("alert-triangle")<div class="ta-alert__body">Bạn đang sửa vai trò của chính mình. Gỡ SYS_ADMIN sẽ làm bạn mất quyền quản trị ngay ở request kế tiếp.</div></div>}
    </div>
    <div class="card-footer ta-form-actions">
        <a asp-action="Index" class="btn">@UiIcon.Render("arrow-left")<span>Quay lại</span></a>
        <button type="submit" class="btn btn-primary ms-auto" disabled="@locked" data-ta-loading data-ta-loading-text="Đang lưu...">@UiIcon.Render("device-floppy")<span>Lưu vai trò</span></button>
    </div>
</form>
</div>
<div class="col-xl-5">
<section class="card ta-table-card" aria-labelledby="directPermTitle" data-ta-direct-permissions>
    <div class="card-header"><h2 class="card-title" id="directPermTitle">@UiIcon.Render("key")Quyền gán trực tiếp (chỉ xem)</h2></div>
    @if (Model.DirectPermissions is not { Count: > 0 }) {<div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("key")</span><p class="ta-empty__text">Không có quyền gán trực tiếp; quyền của người dùng đến từ vai trò.</p></div>}
    else
    {
        <div class="ta-table-wrap"><table class="ta-table ta-table-stack"><thead><tr><th scope="col">Mã quyền</th><th scope="col">Tên quyền</th><th scope="col">Hiệu lực</th></tr></thead><tbody>
        @foreach (var p in Model.DirectPermissions)
        {
            <tr><td data-label="Mã quyền"><span class="ta-code">@p.Code</span></td><td data-label="Tên quyền">@p.Name</td><td data-label="Hiệu lực">@if (p.Effect == "DENY") {<span class="ta-badge ta-badge--danger">@UiIcon.Render("ban") Từ chối (ghi đè vai trò)</span>} else {<span class="ta-badge ta-badge--success">@UiIcon.Render("check") Cho phép</span>}</td></tr>
        }
        </tbody></table></div>
    }
    <div class="card-footer text-secondary small">Quyền gán trực tiếp không chỉnh sửa được tại đây (chờ phê duyệt chính sách phân quyền). Lưu ý: SYS_ADMIN luôn có mọi quyền.</div>
</section>
</div>
</div>

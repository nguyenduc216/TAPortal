@model IReadOnlyList<PortalUser>
@inject TAPortal.Web.Services.PortalDb Db
@{ ViewData["Title"]="Người dùng"; var roles = await Db.GetRolesAsync(); }
<div class="page-header"><div class="row align-items-center"><div class="col"><h2 class="page-title">Quản lý người dùng</h2><div class="text-secondary">Tài khoản, trạng thái và quyền truy cập hệ thống.</div></div><div class="col-auto ms-auto"><button class="btn btn-ta-gold" data-bs-toggle="modal" data-bs-target="#createUser"><i class="ti ti-plus me-1"></i>Thêm người dùng</button></div></div></div>
<div class="card ta-table-card mt-3"><div class="card-header"><div class="input-icon"><span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span><input id="userSearch" class="form-control" type="search" aria-label="Tìm người dùng" placeholder="Tìm người dùng..." oninput="taFilterRows(this.value,'usersTable')" /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="usersTable"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr data-ta-row><td class="fw-medium">@x.Username</td><td>@x.DisplayName</td><td>@x.Email</td><td>@x.Phone</td><td><span class="badge @(x.IsActive?"badge-ta-active":"bg-secondary-lt")">@(x.IsActive?"Hoạt động":"Ngừng")</span></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty"><i class="ti ti-users" aria-hidden="true"></i>Chưa có người dùng.</div>}<div class="ta-table-empty d-none" data-ta-no-results><i class="ti ti-search-off" aria-hidden="true"></i>Không tìm thấy kết quả phù hợp.</div></div>
<div class="modal modal-blur fade" id="createUser" tabindex="-1" aria-labelledby="createUserTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post"><div class="modal-header"><h5 class="modal-title" id="createUserTitle"><i class="ti ti-user-plus" aria-hidden="true"></i>Tạo tài khoản</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Tên đăng nhập</label><input class="form-control" name="Username" required /></div><div class="mb-3"><label class="form-label">Họ và tên</label><input class="form-control" name="DisplayName" required /></div><div class="row"><div class="col"><div class="mb-3"><label class="form-label">Email</label><input class="form-control" name="Email" type="email" /></div></div><div class="col"><div class="mb-3"><label class="form-label">Điện thoại</label><input class="form-control" name="Phone" /></div></div></div><div class="mb-3"><label class="form-label">Vai trò</label><select class="form-select" name="RoleId"><option value="">-- Chọn vai trò --</option>@foreach(var r in roles){<option value="@r.Id">@r.Name</option>}</select></div><div class="mb-2"><label class="form-label">Mật khẩu</label><input id="newUserPassword" class="form-control" name="Password" type="password" required oninput="taCheckPassword(this.value,'newUserRules')" /></div><ul id="newUserRules" class="password-rules ps-3"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div><div class="modal-footer"><button type="button" class="btn me-auto" data-bs-dismiss="modal"><i class="ti ti-x" aria-hidden="true"></i>Hủy</button><button class="btn btn-primary" type="submit" data-ta-loading data-ta-loading-text="Đang tạo..."><i class="ti ti-user-plus" aria-hidden="true"></i><span>Tạo tài khoản</span></button></div></form></div></div></div>

@model IReadOnlyList<PortalUser>
@inject TAPortal.Web.Services.PortalDb Db
@{
    ViewData["Title"]="Người dùng";
    var roles = await Db.GetRolesAsync();
    var draft = ViewData["CreateUser"] as UserCreateVm;
    var draftErrors = ViewData["CreateUserErrors"] as List<string>;
    var roleMap = await Db.GetUserRoleMapAsync();
}
<div class="page-header"><div class="row align-items-center"><div class="col"><h2 class="page-title">Quản lý người dùng</h2><div class="text-secondary">Tài khoản, trạng thái và quyền truy cập hệ thống.</div></div><div class="col-auto ms-auto"><button type="button" class="btn btn-ta-gold" data-bs-toggle="modal" data-bs-target="#createUser"><i class="ti ti-plus me-1"></i>Thêm người dùng</button></div></div></div>
<div class="card ta-table-card mt-3"><div class="card-header"><div class="input-icon"><span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span><input id="userSearch" class="form-control" type="search" aria-label="Tìm người dùng" placeholder="Tìm người dùng..." oninput="taFilterRows(this.value,'usersTable')" /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="usersTable"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Vai trò</th><th>Trạng thái</th><th class="w-1">Thao tác</th></tr></thead><tbody>@foreach(var x in Model){var active = x.IsActive && x.Status == "ACTIVE"; var userRoles = roleMap.TryGetValue(x.Id, out var rl) ? rl : new List<string>();<tr data-ta-row><td class="fw-medium">@x.Username</td><td>@x.DisplayName</td><td class="text-break">@x.Email</td><td>@x.Phone</td><td>@if(userRoles.Count == 0){<span class="text-secondary">—</span>}else{foreach(var rn in userRoles){<span class="badge bg-blue-lt me-1">@rn</span>}}</td><td><span class="badge @(active?"badge-ta-active":"bg-secondary-lt")">@(active?"Hoạt động":"Ngừng")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id" aria-label="Sửa @x.Username"><i class="ti ti-edit" aria-hidden="true"></i>Sửa</a> <a class="btn btn-sm" asp-action="Roles" asp-route-id="@x.Id" aria-label="Vai trò của @x.Username"><i class="ti ti-shield-lock" aria-hidden="true"></i>Vai trò</a></td></tr>}</tbody></table></div>@if(Model.Count == 0){<div class="ta-table-empty"><i class="ti ti-users" aria-hidden="true"></i>Chưa có người dùng.</div>}<div class="ta-table-empty d-none" data-ta-no-results><i class="ti ti-search-off" aria-hidden="true"></i>Không tìm thấy kết quả phù hợp.</div></div>
<div class="modal modal-blur fade" id="createUser" tabindex="-1" aria-labelledby="createUserTitle" aria-hidden="true" data-ta-open="@(draft is null ? "false" : "true")"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post"><div class="modal-header"><h5 class="modal-title" id="createUserTitle"><i class="ti ti-user-plus" aria-hidden="true"></i>Tạo tài khoản</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body">
@if (draftErrors is { Count: > 0 }) { <div class="alert alert-danger" role="alert">@foreach (var e in draftErrors) { <div>@e</div> }</div> }
<div class="mb-3"><label class="form-label required" for="newUsername">Tên đăng nhập</label><input id="newUsername" class="form-control" name="Username" value="@draft?.Username" maxlength="100" autocomplete="off" required /></div><div class="mb-3"><label class="form-label required" for="newDisplayName">Họ và tên</label><input id="newDisplayName" class="form-control" name="DisplayName" value="@draft?.DisplayName" maxlength="200" required /></div><div class="row"><div class="col-sm"><div class="mb-3"><label class="form-label" for="newEmail">Email</label><input id="newEmail" class="form-control" name="Email" type="email" value="@draft?.Email" maxlength="256" /></div></div><div class="col-sm"><div class="mb-3"><label class="form-label" for="newPhone">Điện thoại</label><input id="newPhone" class="form-control" name="Phone" value="@draft?.Phone" maxlength="50" /></div></div></div><div class="mb-3"><label class="form-label" for="newRole">Vai trò</label><select id="newRole" class="form-select" name="RoleId"><option value="">-- Chọn vai trò --</option>@foreach(var r in roles.Where(r => r.IsActive)){<option value="@r.Id" selected="@(draft?.RoleId == r.Id)">@r.Name@(r.Code == "SYS_ADMIN" ? " (toàn quyền hệ thống)" : "")</option>}</select><div class="form-hint">Chỉ chọn "Quản trị hệ thống" cho người được phép toàn quyền.</div></div><div class="mb-2"><label class="form-label required" for="newUserPassword">Mật khẩu</label><input id="newUserPassword" class="form-control" name="Password" type="password" autocomplete="new-password" required oninput="taCheckPassword(this.value,'newUserRules')" /></div><ul id="newUserRules" class="password-rules ps-3"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div><div class="modal-footer"><button type="button" class="btn me-auto" data-bs-dismiss="modal"><i class="ti ti-x" aria-hidden="true"></i>Hủy</button><button class="btn btn-primary" type="submit" data-ta-loading data-ta-loading-text="Đang tạo..."><i class="ti ti-user-plus" aria-hidden="true"></i><span>Tạo tài khoản</span></button></div></form></div></div></div>

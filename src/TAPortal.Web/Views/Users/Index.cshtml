@model IReadOnlyList<PortalUser>
@functions {
    private static string Initial(string? name)
    {
        var last = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        return string.IsNullOrEmpty(last) ? "?" : last[..1].ToUpperInvariant();
    }
}
@{
    ViewData["Title"] = "Người dùng";
    ViewData["Heading"] = "Quản lý người dùng";
    ViewData["Subtitle"] = "Tài khoản, trạng thái và quyền truy cập hệ thống.";
    ViewData["PageIcon"] = "users";
    var roles = ViewData["Roles"] as List<PortalRole> ?? [];
    var draft = ViewData["CreateUser"] as UserCreateVm;
    var draftErrors = ViewData["CreateUserErrors"] as List<string>;
    var roleMap = ViewData["RoleMap"] as Dictionary<Guid, List<string>> ?? [];
    var actorId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
@section PageActions {
    <button type="button" class="btn btn-ta-gold" data-bs-toggle="modal" data-bs-target="#createUser">@UiIcon.Render("user-plus")<span>Thêm người dùng</span></button>
}
<section class="card ta-table-card" aria-label="Danh sách người dùng">
    <div class="ta-table-toolbar">
        <div class="ta-search">@UiIcon.Render("search")<input id="userSearch" class="form-control" type="search" aria-label="Tìm người dùng" placeholder="Tìm theo tài khoản, họ tên, email, vai trò..." oninput="taFilterRows(this.value,'usersTable')" /></div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="ta-empty"><span class="ta-empty__icon">@UiIcon.Render("users")</span><p class="ta-empty__title">Chưa có người dùng</p></div>
    }
    else
    {
        <div class="ta-table-wrap">
            <table class="ta-table ta-table-stack" id="usersTable" data-ta-pager="10">
                <thead><tr><th scope="col">Người dùng</th><th scope="col">Email</th><th scope="col">Điện thoại</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col" class="ta-col-actions">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var x in Model)
                {
                    var eligible = AccountStatusPolicy.IsLoginEligible(x.IsActive, x.Status, false);
                    var badge = eligible ? "ta-badge--success" : !x.IsActive ? "ta-badge--danger" : "ta-badge--warning";
                    var userRoles = roleMap.TryGetValue(x.Id, out var rl) ? rl : new List<string>();
                    var isSelf = string.Equals(actorId, x.Id.ToString(), StringComparison.OrdinalIgnoreCase);
                    <tr data-ta-row>
                        <td class="ta-cell-strong">
                            <div class="d-flex align-items-center gap-3">
                                <span class="ta-avatar" aria-hidden="true">@Initial(x.DisplayName)</span>
                                <div class="min-w-0"><div>@x.DisplayName @if (isSelf) {<span class="ta-badge ta-badge--info ta-badge--plain ms-1">Bạn</span>}</div><div class="ta-cell-sub">@x.Username</div></div>
                            </div>
                        </td>
                        <td class="ta-nowrap" data-label="Email">@x.Email</td>
                        <td class="ta-nowrap" data-label="Điện thoại">@x.Phone</td>
                        <td data-label="Vai trò">@if (userRoles.Count == 0) {<span class="text-secondary">—</span>} else {<span class="d-inline-flex flex-wrap gap-1 justify-content-end">@foreach (var rn in userRoles) {<span class="ta-badge ta-badge--info ta-badge--plain">@rn</span>}</span>}</td>
                        <td data-label="Trạng thái"><span class="ta-badge @badge">@AccountStatusPolicy.Describe(x.IsActive, x.Status, false)</span></td>
                        <td class="ta-col-actions">
                            <div class="ta-actions">
                                <a class="btn btn-sm btn-soft-primary" asp-action="Edit" asp-route-id="@x.Id" aria-label="Sửa @x.Username">@UiIcon.Render("pencil")<span>Sửa</span></a>
                                <a class="btn btn-sm" asp-action="Roles" asp-route-id="@x.Id" aria-label="Phân quyền @x.Username">@UiIcon.Render("shield-lock")<span>Vai trò</span></a>
                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm ta-btn-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thao tác khác cho @x.Username" title="Thao tác khác">@UiIcon.Render("dots-vertical")</button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@x.Id" asp-fragment="IsActive">@UiIcon.Render("lock")<span>Khóa / mở đăng nhập</span></a>
                                        @if (isSelf) {<span class="dropdown-item disabled" aria-disabled="true">@UiIcon.Render("trash")<span>Không thể tự xóa</span></span>}
                                        else {<a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@x.Id">@UiIcon.Render("trash")<span>Xóa người dùng</span></a>}
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="ta-empty d-none" data-ta-no-results><span class="ta-empty__icon">@UiIcon.Render("search-off")</span><p class="ta-empty__title">Không tìm thấy kết quả phù hợp</p></div>
        <div class="ta-table-footer" data-ta-pager-for="usersTable" data-ta-unit="người dùng"></div>
        <div class="card-footer text-secondary small">Khóa/mở đăng nhập thực hiện trong màn hình Sửa (mục "Cho phép đăng nhập").</div>
    }
</section>
<div class="modal modal-blur fade" id="createUser" tabindex="-1" aria-labelledby="createUserTitle" aria-hidden="true" data-ta-open="@(draft is null ? "false" : "true")">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="Create" method="post">
        <div class="modal-header"><h2 class="modal-title" id="createUserTitle">@UiIcon.Render("user-plus")Tạo tài khoản</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body">
            @if (draftErrors is { Count: > 0 }) {<div class="ta-alert ta-alert--danger" role="alert">@UiIcon.Render("alert-circle")<div class="ta-alert__body">@foreach (var e in draftErrors) {<div>@e</div>}</div></div>}
            <div class="ta-form-grid">
                <div><label class="form-label required" for="newUsername">Tên đăng nhập</label><div class="ta-input-icon">@UiIcon.Render("user")<input id="newUsername" class="form-control" name="Username" value="@draft?.Username" maxlength="100" autocomplete="off" required /></div></div>
                <div><label class="form-label required" for="newDisplayName">Họ và tên</label><div class="ta-input-icon">@UiIcon.Render("id")<input id="newDisplayName" class="form-control" name="DisplayName" value="@draft?.DisplayName" maxlength="200" required /></div></div>
                <div><label class="form-label" for="newEmail">Email</label><div class="ta-input-icon">@UiIcon.Render("mail")<input id="newEmail" class="form-control" name="Email" type="email" value="@draft?.Email" maxlength="256" /></div></div>
                <div><label class="form-label" for="newPhone">Điện thoại</label><div class="ta-input-icon">@UiIcon.Render("phone")<input id="newPhone" class="form-control" name="Phone" value="@draft?.Phone" maxlength="50" inputmode="tel" /></div></div>
                <div class="ta-span-2"><label class="form-label" for="newRole">Vai trò</label><select id="newRole" class="form-select" name="RoleId"><option value="">-- Chọn vai trò --</option>@foreach (var r in roles.Where(r => r.IsActive)) {<option value="@r.Id" selected="@(draft?.RoleId == r.Id)">@r.Name@(r.Code == "SYS_ADMIN" ? " (toàn quyền hệ thống)" : "")</option>}</select><div class="form-hint">Chỉ chọn "Quản trị hệ thống" cho người được phép toàn quyền.</div></div>
                <div class="ta-span-2"><label class="form-label required" for="newUserPassword">Mật khẩu</label><div class="ta-input-icon">@UiIcon.Render("lock")<input id="newUserPassword" class="form-control" name="Password" type="password" autocomplete="new-password" required oninput="taCheckPassword(this.value,'newUserRules')" /><button class="ta-password-toggle" type="button" onclick="taTogglePassword('newUserPassword',this)" aria-label="Hiện mật khẩu" aria-pressed="false">@UiIcon.Render("eye", "ta-icon-show")@UiIcon.Render("eye-off", "ta-icon-hide")</button></div>
                    <ul id="newUserRules" class="password-rules"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div>
            </div>
        </div>
        <div class="modal-footer"><button type="button" class="btn me-auto" data-bs-dismiss="modal">@UiIcon.Render("x")<span>Hủy</span></button><button class="btn btn-primary" type="submit" data-ta-loading data-ta-loading-text="Đang tạo...">@UiIcon.Render("device-floppy")<span>Tạo tài khoản</span></button></div>
    </form></div></div>
</div>

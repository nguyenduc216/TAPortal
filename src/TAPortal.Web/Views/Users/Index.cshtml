@model IReadOnlyList<PortalUser>
@inject TAPortal.Web.Services.PortalDb Db
@{ ViewData["Title"]="Người dùng"; var roles = await Db.GetRolesAsync(); }
<div class="page-header"><div class="row align-items-center"><div class="col"><h2 class="page-title">Quản lý người dùng</h2><div class="text-secondary">Tài khoản, trạng thái và quyền truy cập hệ thống.</div></div><div class="col-auto ms-auto"><button class="btn btn-ta-gold" data-bs-toggle="modal" data-bs-target="#createUser"><i class="ti ti-plus me-1"></i>Thêm người dùng</button></div></div></div>
<div class="card mt-3"><div class="card-header"><div class="input-icon"><span class="input-icon-addon"><i class="ti ti-search"></i></span><input id="userSearch" class="form-control" placeholder="Tìm người dùng..." oninput="filterRows(this.value,'usersTable')" /></div></div><div class="table-responsive"><table class="table table-vcenter card-table" id="usersTable"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="fw-medium">@x.Username</td><td>@x.DisplayName</td><td>@x.Email</td><td>@x.Phone</td><td><span class="badge @(x.IsActive?"badge-ta-active":"bg-secondary-lt")">@(x.IsActive?"Hoạt động":"Ngừng")</span></td></tr>}</tbody></table></div></div>
<div class="modal modal-blur fade" id="createUser" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post"><div class="modal-header"><h5 class="modal-title">Tạo tài khoản</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Tên đăng nhập</label><input class="form-control" name="Username" required /></div><div class="mb-3"><label class="form-label">Họ và tên</label><input class="form-control" name="DisplayName" required /></div><div class="row"><div class="col"><div class="mb-3"><label class="form-label">Email</label><input class="form-control" name="Email" type="email" /></div></div><div class="col"><div class="mb-3"><label class="form-label">Điện thoại</label><input class="form-control" name="Phone" /></div></div></div><div class="mb-3"><label class="form-label">Vai trò</label><select class="form-select" name="RoleId"><option value="">-- Chọn vai trò --</option>@foreach(var r in roles){<option value="@r.Id">@r.Name</option>}</select></div><div class="mb-2"><label class="form-label">Mật khẩu</label><input id="newUserPassword" class="form-control" name="Password" type="password" required oninput="checkPassword(this.value,'newUserRules')" /></div><ul id="newUserRules" class="password-rules ps-3"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div><div class="modal-footer"><button type="button" class="btn me-auto" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit">Tạo tài khoản</button></div></form></div></div></div>
@section Scripts{<script>function filterRows(q,id){q=q.toLowerCase();document.querySelectorAll('#'+id+' tbody tr').forEach(r=>r.style.display=r.innerText.toLowerCase().includes(q)?'':'none');}function checkPassword(v,id){const box=document.getElementById(id),rules={len:v.length>=8,letter:/[A-Za-z]/.test(v),digit:/\d/.test(v),special:/[^A-Za-z0-9]/.test(v)};Object.entries(rules).forEach(([k,ok])=>box.querySelector('[data-rule="'+k+'"]').classList.toggle('ok',ok));}</script>}

@model UserEditVm
@{
    ViewData["Title"]="Sửa người dùng";
    var roles = ViewBag.Roles as List<string> ?? new();
}
<div class="page-header"><div class="row align-items-center"><div class="col"><div class="page-pretitle"><a asp-action="Index">Người dùng</a> / Chỉnh sửa</div><h2 class="page-title">Sửa người dùng: @Model.Username</h2></div></div></div>
<div class="row mt-3"><div class="col-lg-8"><div class="card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
<div class="card-body">
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="mb-3"><label class="form-label">Tên đăng nhập</label><input class="form-control" value="@Model.Username" readonly disabled /><div class="form-hint">Tên đăng nhập không thể thay đổi.</div></div>
<div class="mb-3"><label asp-for="DisplayName" class="form-label required">Họ và tên</label><input asp-for="DisplayName" class="form-control" maxlength="200" required /><span asp-validation-for="DisplayName" class="invalid-feedback d-block"></span></div>
<div class="row"><div class="col-sm"><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" type="email" maxlength="256" /><span asp-validation-for="Email" class="invalid-feedback d-block"></span></div></div>
<div class="col-sm"><div class="mb-3"><label asp-for="Phone" class="form-label">Điện thoại</label><input asp-for="Phone" class="form-control" maxlength="50" /><span asp-validation-for="Phone" class="invalid-feedback d-block"></span></div></div></div>
<div class="mb-3"><label class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><span class="form-check-label">Cho phép đăng nhập (hoạt động)</span></label><span asp-validation-for="IsActive" class="invalid-feedback d-block"></span><div class="form-hint">Tắt sẽ chặn đăng nhập ở cả TAPortal và Customer Portal; phiên hiện tại bị từ chối ở request kế tiếp.</div></div>
<dl class="row mb-0"><dt class="col-sm-4">Trạng thái hệ thống</dt><dd class="col-sm-8"><code>@Model.Status</code></dd><dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@(roles.Count == 0 ? "—" : string.Join(", ", roles)) <a asp-action="Roles" asp-route-id="@Model.Id" class="ms-2"><i class="ti ti-shield-lock" aria-hidden="true"></i>Quản lý vai trò</a></dd></dl>
<div class="form-hint">Chỉnh sửa hồ sơ không thay đổi mật khẩu hay vai trò.</div>
</div>
<div class="card-footer d-flex gap-2"><a asp-action="Index" class="btn"><i class="ti ti-arrow-left" aria-hidden="true"></i>Quay lại</a><button type="submit" class="btn btn-primary ms-auto" data-ta-loading data-ta-loading-text="Đang lưu..."><i class="ti ti-device-floppy" aria-hidden="true"></i><span>Lưu thay đổi</span></button></div>
</form></div></div></div>

@model CustomerMembership
@{
    ViewData["Title"] = "Tổng quan";
    ViewData["HideHeader"] = true;
}
<section class="cp-hero" aria-label="Doanh nghiệp đang truy cập">
    <div>
        <p class="cp-hero__greet">Xin chào, @User.FindFirst("display_name")?.Value</p>
        <h1 class="cp-hero__name">@Model.Name</h1>
        <div class="cp-hero__chips">
            <span class="cp-glass">@UiIcon.Render("hash")@Model.Code</span>
            <span class="cp-glass">@UiIcon.Render("receipt-tax")MST: @(Model.TaxCode ?? "Chưa cập nhật")</span>
        </div>
    </div>
    <div class="cp-hero__side">
        <span class="cp-hero__role">@UiIcon.Render("shield-check")@PortalRoleText.Label(Model.Role)</span>
        <span class="cp-hero__status">Customer Portal đã kích hoạt</span>
    </div>
</section>

<div class="cp-section"><h2>Tóm tắt</h2></div>
<div class="cp-grid">
    <a class="cp-card cp-stat" asp-controller="Profile" asp-action="Company" style="color:inherit;text-decoration:none">
        <div class="cp-stat__top"><span class="cp-stat__label">Doanh nghiệp</span><span class="cp-blob">@UiIcon.Render("building")</span></div>
        <div class="cp-stat__value">@Model.Code</div>
        <div class="cp-stat__hint">Xem hồ sơ doanh nghiệp →</div>
    </a>
    <section class="cp-card cp-stat">
        <div class="cp-stat__top"><span class="cp-stat__label">Vai trò của bạn</span><span class="cp-blob cp-blob--gold">@UiIcon.Render("shield-check")</span></div>
        <div class="cp-stat__value">@PortalRoleText.Label(Model.Role)</div>
        <div class="cp-stat__hint">Trong doanh nghiệp hiện tại</div>
    </section>
    <a class="cp-card cp-stat" asp-controller="Profile" asp-action="Personal" style="color:inherit;text-decoration:none">
        <div class="cp-stat__top"><span class="cp-stat__label">Tài khoản</span><span class="cp-blob cp-blob--ink">@UiIcon.Render("user-circle")</span></div>
        <div class="cp-stat__value">Đang hoạt động</div>
        <div class="cp-stat__hint">@User.Identity?.Name</div>
    </a>
</div>

<div class="cp-section"><h2>Dịch vụ tài chính</h2><p>Thanh toán qua Tingee do T.A kích hoạt cho doanh nghiệp.</p></div>
<div class="cp-grid">
@foreach (var (label, icon, controller, hint) in new[] { ("Đơn hàng & QR", "qrcode", "Orders", "Tạo đơn, mã QR có thời hạn"), ("Khách hàng", "users", "Contacts", "Danh sách khách hàng của bạn"), ("Tài khoản ngân hàng", "building-bank", "Banks", "Liên kết tài khoản nhận tiền") })
{
    <a class="cp-card cp-service" asp-controller="@controller" asp-action="Index" style="color:inherit;text-decoration:none"><span class="cp-blob" aria-hidden="true">@UiIcon.Render(icon)</span><div><h3>@label</h3><p><span class="cp-badge cp-badge--blue">Sẵn sàng</span></p><p>@hint</p></div></a>
}
@foreach (var (label, icon) in new[] { ("Đối soát", "checks"), ("Hóa đơn điện tử", "file-text"), ("Zalo OA", "mail") })
{
    <section class="cp-card cp-service"><span class="cp-blob cp-blob--ink" aria-hidden="true">@UiIcon.Render(icon)</span><div><h3>@label</h3><p><span class="cp-badge cp-badge--gold">Sắp ra mắt</span></p><p>Giai đoạn tiếp theo</p></div></section>
}
</div>

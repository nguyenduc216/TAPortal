@model MemberCreateVm
@{
    ViewData["Title"] = "Thêm tài khoản";
    ViewData["Eyebrow"] = "Tài khoản & phân quyền";
    ViewData["Subtitle"] = "Tạo tài khoản đăng nhập cho nhân viên và chọn chức năng tài khoản được xem hoặc quản lý.";
    var i = Model.Input;
}
<form class="cp-card" method="post" asp-action="Create" data-cp-member-form data-ta-hard autocomplete="off">
    <div class="cp-card__body">
        <div asp-validation-summary="ModelOnly" class="cp-alert" role="alert"></div>
        <div class="cp-form-grid">
            <div class="cp-form-section">Thông tin tài khoản</div>
            <div class="cp-field"><label for="DisplayName" class="cp-label is-required">Họ tên</label><div class="cp-input-wrap">@UiIcon.Render("user")<input id="DisplayName" name="DisplayName" value="@i.DisplayName" class="cp-input" maxlength="200" required /></div><span class="cp-error">@Html.ValidationMessage("DisplayName")</span></div>
            <div class="cp-field"><label for="Username" class="cp-label is-required">Tên đăng nhập</label><div class="cp-input-wrap">@UiIcon.Render("id")<input id="Username" name="Username" value="@i.Username" class="cp-input" maxlength="100" required autocapitalize="off" spellcheck="false" placeholder="vd: ketoan.lan" /></div><div class="cp-hint">Chữ không dấu, số và . _ - @@; không trùng với tài khoản khác.</div><span class="cp-error">@Html.ValidationMessage("Username")</span></div>
            <div class="cp-field"><label for="Email" class="cp-label">Email</label><div class="cp-input-wrap">@UiIcon.Render("mail")<input id="Email" name="Email" value="@i.Email" class="cp-input" type="email" maxlength="100" /></div><div class="cp-hint">Dùng để lấy lại mật khẩu.</div><span class="cp-error">@Html.ValidationMessage("Email")</span></div>
            <div class="cp-field"><label for="Phone" class="cp-label">Điện thoại</label><div class="cp-input-wrap">@UiIcon.Render("phone")<input id="Phone" name="Phone" value="@i.Phone" class="cp-input" inputmode="tel" maxlength="10" placeholder="0912345678" /></div><span class="cp-error">@Html.ValidationMessage("Phone")</span></div>
            <div class="cp-field"><label for="Password" class="cp-label is-required">Mật khẩu</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input id="Password" name="Password" class="cp-input" type="password" autocomplete="new-password" required /></div><div class="cp-hint">Ít nhất @PasswordPolicy.MinimumLength ký tự, có chữ, số và ký tự đặc biệt. Người dùng đổi mật khẩu ở lần đăng nhập đầu.</div><span class="cp-error">@Html.ValidationMessage("Password")</span></div>
            <div class="cp-field"><label for="ConfirmPassword" class="cp-label is-required">Nhập lại mật khẩu</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input id="ConfirmPassword" name="ConfirmPassword" class="cp-input" type="password" autocomplete="new-password" required /></div><span class="cp-error">@Html.ValidationMessage("ConfirmPassword")</span></div>
            <div class="cp-form-section">Phân quyền</div>
            <div class="cp-field cp-span">@await Html.PartialAsync("_PermissionMatrix", new PermissionMatrixVm(Model.Levels, true))</div>
        </div>
    </div>
    <div class="cp-card__foot">
        <a class="cp-btn cp-btn--ghost" asp-action="Index">@UiIcon.Render("arrow-left")<span>Quay lại</span></a>
        <button class="cp-btn cp-btn--primary" type="submit" style="margin-left:auto">@UiIcon.Render("user-plus")<span>Tạo tài khoản</span></button>
    </div>
</form>

@using TAPortal.Integrations.Tingee
@model EInvoiceVm
@{
    ViewData["Title"] = "Hóa đơn điện tử";
    ViewData["Eyebrow"] = "Thanh toán";
    ViewData["Subtitle"] = "Kết nối MISA meInvoice, Viettel SInvoice hoặc SoftDreams EasyInvoice để xuất hóa đơn điện tử ngay khi đơn hàng QR được thanh toán đủ.";
    var s = Model.Settings;
    var t = Model.Template;
    var p = Model.Provider;
    var canEdit = Model.CanManage && Model.Linked && Model.ServiceReady;
    var picked = CustomerInvoiceProviders.Get(Model.Account.Provider);
}
@if (!Model.Linked) { <partial name="_PaymentsNotLinked" /> }
else if (!Model.ServiceReady) { <aside class="cp-note" style="margin-bottom:14px" data-cp-not-ready>@UiIcon.Render("info-circle")<div><strong>Dịch vụ hóa đơn điện tử đang được cấu hình.</strong> Vui lòng liên hệ bộ phận hỗ trợ Hóa đơn tự động nếu cần gấp.</div></aside> }
<div asp-validation-summary="ModelOnly" class="cp-alert" role="alert"></div>
<div class="cp-grid cp-grid--2">
    <div>
        <section class="cp-card" style="margin-bottom:14px" data-cp-einvoice-account>
            <div class="cp-card__head"><span class="cp-blob">@UiIcon.Render("key")</span><h2>1. Tài khoản phần mềm hóa đơn</h2>
                @if (s.IsConnected) {<span class="cp-badge cp-badge--green" style="margin-left:auto">Đã kết nối</span>} else {<span class="cp-badge cp-badge--soft" style="margin-left:auto">Chưa kết nối</span>}</div>
            @if (s.IsConnected && !Model.ShowConnect)
            {
                <div class="cp-card__body">
                    <dl class="cp-dl">
                        <div><dt>@UiIcon.Render("file-invoice")Phần mềm</dt><dd data-cp-einvoice-provider>@p.Name</dd></div>
                        <div><dt>@UiIcon.Render("receipt-tax")Mã số thuế</dt><dd><span class="cp-code">@s.ProviderTaxCode</span></dd></div>
                        <div><dt>@UiIcon.Render("user")Tên đăng nhập</dt><dd>@s.ProviderUsername</dd></div>
                        @if (!p.ViaPartner) {<div><dt>@UiIcon.Render("server")Hệ thống</dt><dd data-cp-einvoice-env>@(Model.Account.Demo ? "Môi trường thử (demo)" : "Chính thức")</dd></div>}
                        <div><dt>@UiIcon.Render("clock")Kết nối lúc</dt><dd>@PaymentText.VietnamTime(s.ConnectedAt)</dd></div>
                    </dl>
                </div>
                @if (canEdit)
                {
                    <div class="cp-card__foot">
                        <form method="post" asp-action="Disconnect" style="margin-left:auto" onsubmit="return confirm('Gỡ kết nối @p.Name? Xuất hóa đơn tự động sẽ tắt.')"><button class="cp-btn cp-btn--danger" type="submit">@UiIcon.Render("trash")<span>Gỡ kết nối</span></button></form>
                    </div>
                }
            }
            <details class="cp-einvoice-connect" open="@(!s.IsConnected || Model.ShowConnect)" data-cp-einvoice-connect>
            @if (s.IsConnected) {<summary>@UiIcon.Render("pencil")<span>Đổi phần mềm, tài khoản hoặc mật khẩu</span></summary>}
            <form method="post" asp-action="Connect">
                <div class="cp-card__body">
                    <div class="cp-label is-required">Phần mềm hóa đơn điện tử</div>
                    <div class="cp-seg" role="radiogroup" aria-label="Phần mềm hóa đơn điện tử" data-cp-providers>
                        @foreach (var option in CustomerInvoiceProviders.All)
                        {
                            <label><input type="radio" name="Account.Provider" value="@option.Code" checked="@(option.Code == picked.Code)" disabled="@(!canEdit)" /><strong>@option.Name</strong><small>Ký tự động: @option.Signer</small></label>
                        }
                    </div>
                    <span asp-validation-for="Account.Provider" class="cp-error"></span>
                    <div class="cp-field"><label asp-for="Account.TaxCode" class="cp-label is-required">Mã số thuế người bán</label><div class="cp-input-wrap">@UiIcon.Render("receipt-tax")<input asp-for="Account.TaxCode" class="cp-input" inputmode="numeric" maxlength="14" autocomplete="off" required disabled="@(!canEdit)" /></div><span asp-validation-for="Account.TaxCode" class="cp-error"></span></div>
                    <div class="cp-field"><label asp-for="Account.Username" class="cp-label is-required">Tên đăng nhập phần mềm hóa đơn</label><div class="cp-input-wrap">@UiIcon.Render("user")<input asp-for="Account.Username" class="cp-input" maxlength="150" autocomplete="off" required disabled="@(!canEdit)" /></div><span asp-validation-for="Account.Username" class="cp-error"></span>
                        <div class="cp-hint">Dùng tài khoản được cấp quyền gọi API của phần mềm hóa đơn. Với Viettel SInvoice, tài khoản này thường khác tài khoản đăng nhập web: xin Viettel mở nếu chưa có.</div></div>
                    <div class="cp-field"><label asp-for="Account.Password" class="cp-label is-required">Mật khẩu</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input asp-for="Account.Password" type="password" class="cp-input" maxlength="200" autocomplete="new-password" required disabled="@(!canEdit)" value="" /></div><span asp-validation-for="Account.Password" class="cp-error"></span>
                        <div class="cp-hint">MISA, Viettel: mật khẩu chỉ dùng để xác thực lúc kết nối, Hóa đơn tự động không lưu mật khẩu. SoftDreams EasyInvoice cần mật khẩu cho mỗi lần xuất hóa đơn: mật khẩu được mã hóa trước khi lưu và không hiển thị lại.</div></div>
                    <label class="cp-check" data-cp-einvoice-demo><input type="checkbox" name="Account.Demo" value="true" checked="@Model.Account.Demo" disabled="@(!canEdit)" /><span><strong>Dùng môi trường thử (demo) của SoftDreams</strong><span class="cp-muted" style="display:block">Chỉ áp dụng cho SoftDreams EasyInvoice, khi SoftDreams cấp tài khoản demo để kiểm tra. Hóa đơn trên môi trường thử không có giá trị.</span></span></label>
                    <input type="hidden" name="Account.Demo" value="false" />
                </div>
                @if (canEdit) {<div class="cp-card__foot"><button class="cp-btn cp-btn--primary" type="submit" style="margin-left:auto">@UiIcon.Render("lock-open")<span>@(s.IsConnected ? "Kết nối lại" : "Kết nối phần mềm hóa đơn")</span></button></div>}
            </form>
            </details>
        </section>

        <form class="cp-card" method="post" asp-action="Save" data-cp-einvoice-settings>
            <div class="cp-card__head"><span class="cp-blob cp-blob--gold">@UiIcon.Render("file-text")</span><h2>2. Mẫu hóa đơn và xuất tự động</h2>
                @if (s.AutoIssueEnabled && s.IsReady && s.Mode == InvoiceIssueModes.Draft) {<span class="cp-badge cp-badge--blue" style="margin-left:auto" data-cp-auto-on>Tự động xuất nháp</span>}
                else if (s.AutoIssueEnabled && s.IsReady) {<span class="cp-badge cp-badge--green" style="margin-left:auto" data-cp-auto-on>Đang tự động xuất</span>}
                else {<span class="cp-badge cp-badge--soft" style="margin-left:auto">Chưa tự động</span>}</div>
            <div class="cp-card__body">
                @if (Model.Templates is { Count: > 0 } list)
                {
                    <div class="cp-label">Mẫu hóa đơn trên @p.Name</div>
                    <div class="cp-seg" role="radiogroup" aria-label="Mẫu hóa đơn" data-cp-templates>
                        @foreach (var tpl in list)
                        {
                            var value = $"{tpl.InvoicePattern}|{tpl.InvoiceSeries}";
                            <label><input type="radio" name="Template.Choice" value="@value" checked="@(tpl.InvoicePattern == s.InvoicePattern && tpl.InvoiceSeries == s.InvoiceSeries)" /><strong>@tpl.InvoiceSeries</strong><small>@(tpl.InvoicePattern?.Length > 20 ? "Mẫu trên " + p.Short : "Mẫu số " + tpl.InvoicePattern)</small></label>
                        }
                    </div>
                }
                else if (Model.Saved is { Count: > 0 } saved)
                {
                    <div class="cp-label">Mẫu hóa đơn đã lưu trên @p.Name @if (Model.Environment == SavedInvoiceTemplate.Demo) {<span class="cp-badge cp-badge--gold">Môi trường thử (demo)</span>} else {<span class="cp-badge cp-badge--green">Chính thức</span>}</div>
                    <ul class="cp-tpl-list" role="radiogroup" aria-label="Mẫu hóa đơn đã lưu" data-cp-saved-templates>
                        @foreach (var tpl in saved)
                        {
                            var isDefault = tpl.Pattern == s.InvoicePattern && tpl.Series == s.InvoiceSeries;
                            <li class="cp-tpl@(isDefault ? " is-default" : "")">
                                <label><input type="radio" name="Template.Choice" value="@($"{tpl.Pattern}|{tpl.Series}")" checked="@isDefault" disabled="@(!canEdit)" />
                                    <span><strong>@tpl.Pattern@tpl.Series</strong><small>Mẫu số @tpl.Pattern · ký hiệu @tpl.Series</small></span></label>
                                @if (isDefault) {<span class="cp-badge cp-badge--blue">Mặc định</span>}
                                else if (canEdit && tpl.Id != Guid.Empty) {<button type="submit" class="cp-btn cp-btn--ghost cp-btn--sm" formaction="@Url.Action("DeleteTemplate")" formnovalidate name="templateId" value="@tpl.Id" onclick="return confirm('Xóa mẫu @tpl.Pattern@tpl.Series khỏi danh sách?')" aria-label="Xóa mẫu @tpl.Pattern@tpl.Series">@UiIcon.Render("trash")</button>}
                            </li>
                        }
                        @if (canEdit)
                        {
                            <li class="cp-tpl"><label><input type="radio" name="Template.Choice" value="" data-cp-template-new /><span><strong>Thêm mẫu mới</strong><small>Nhập mẫu số và ký hiệu bên dưới, lưu xong mẫu được thêm vào danh sách và dùng làm mặc định.</small></span></label></li>
                        }
                    </ul>
                    <p class="cp-hint" style="margin:6px 0 12px">Mẫu được chọn là mẫu mặc định: mọi hóa đơn xuất tự động dùng mẫu này. Danh sách riêng cho từng nhà cung cấp@(p.ViaPartner ? "" : " và cho môi trường thử / chính thức").</p>
                }
                <div class="cp-form-grid" data-cp-template-fields>
                    <div class="cp-field"><label asp-for="Template.Pattern" class="cp-label">Mẫu số</label><div class="cp-input-wrap">@UiIcon.Render("hash")<input asp-for="Template.Pattern" class="cp-input" maxlength="50" placeholder="Bấm Lấy mẫu hóa đơn" disabled="@(!canEdit || !s.IsConnected)" /></div><span asp-validation-for="Template.Pattern" class="cp-error"></span>
                        @if (p == CustomerInvoiceProviders.Misa) {<div class="cp-hint">MISA dùng mã mẫu riêng (chuỗi dài), không phải số "1": bấm "Lấy mẫu hóa đơn từ MISA", chọn mẫu rồi lưu.</div>}
                        else if (!p.HasTemplates) {<div class="cp-hint" data-cp-template-manual>Nhập mẫu số và ký hiệu đã đăng ký trên @p.Short, VD mẫu số 1 và ký hiệu C26TAA (ghép lại là 1C26TAA).</div>}
                        else {<div class="cp-hint">Bấm "Lấy mẫu hóa đơn từ @p.Short" để chọn đúng mẫu số đã đăng ký.</div>}</div>
                    <div class="cp-field"><label asp-for="Template.Series" class="cp-label">Ký hiệu</label><div class="cp-input-wrap">@UiIcon.Render("hash")<input asp-for="Template.Series" class="cp-input" maxlength="20" placeholder="VD: C26TAA" disabled="@(!canEdit || !s.IsConnected)" /></div><span asp-validation-for="Template.Series" class="cp-error"></span></div>
                </div>
                <div class="cp-note cp-note--warn" data-cp-hsm-warning>@UiIcon.Render("alert-triangle")<div>
                    <strong>Ký số tự động cần @p.Signer</strong>
                    <p>@p.Name chỉ ký và phát hành hóa đơn tự động khi doanh nghiệp có chữ ký số từ xa (HSM) loại cho phép ký tự động, đã liên kết với tài khoản @p.Short và đã đăng ký chứng thư số với cơ quan thuế. Chữ ký số USB token, hoặc gói phải xác nhận trên điện thoại cho từng lần ký, không dùng được cho xuất tự động. Chưa có: chọn xuất hóa đơn nháp và duyệt thủ công trên @p.Short.</p>
                </div></div>
                @{ var mode = t.IssueMode ?? s.Mode; var off = !canEdit || !s.IsConnected; }
                <div class="cp-field" role="radiogroup" aria-label="Cách xuất hóa đơn tự động" data-cp-issue-mode>
                    <div class="cp-label">Xuất hóa đơn khi đơn hàng QR được thanh toán đủ</div>
                    <label class="cp-check cp-check--option"><input type="radio" name="Template.IssueMode" value="@InvoiceIssueModes.Signed" checked="@(mode == InvoiceIssueModes.Signed)" disabled="@off" /><span><strong>Đã có chữ ký số từ xa — ký số và phát hành tự động</strong><span class="cp-muted" style="display:block">Hóa đơn được ký số từ xa và gửi cơ quan thuế ngay khi thanh toán đủ. Chọn mục này là doanh nghiệp xác nhận đã có @p.Signer dùng được cho ký tự động.@if (s.HsmConfirmedAt is DateTime hsmAt) {<text> Đã xác nhận lúc @hsmAt.AddHours(7).ToString("HH:mm dd/MM/yyyy").</text>}</span></span></label>
                    <label class="cp-check cp-check--option"><input type="radio" name="Template.IssueMode" value="@InvoiceIssueModes.Draft" checked="@(mode == InvoiceIssueModes.Draft)" disabled="@off" /><span><strong>Chưa có chữ ký số từ xa — xuất hóa đơn nháp, duyệt thủ công</strong><span class="cp-muted" style="display:block">Hệ thống tạo hóa đơn nháp trên @p.Name khi thanh toán đủ; kế toán duyệt, ký số và phát hành trên @p.Short.</span></span></label>
                    <label class="cp-check cp-check--option"><input type="radio" name="Template.IssueMode" value="@InvoiceIssueModes.None" checked="@(mode == InvoiceIssueModes.None)" disabled="@off" /><span><strong>Không xuất hóa đơn tự động</strong><span class="cp-muted" style="display:block">Xuất hóa đơn từ trang chi tiết đơn hàng khi cần.</span></span></label>
                    <div class="cp-hint">Áp dụng cho đơn có đánh dấu "tự động xuất hóa đơn" và được thanh toán đủ từ lúc bật. Đơn đã thanh toán trước đó: xuất từ trang chi tiết đơn.</div>
                </div>
                @if (p.SendsEmail)
                {
                    <div class="cp-field">
                        <label class="cp-check"><input type="checkbox" name="Template.SendEmail" value="true" checked="@t.SendEmail" disabled="@(!canEdit || !s.IsConnected)" /><span><strong>Gửi hóa đơn qua email cho người mua</strong><span class="cp-muted" style="display:block">Khi khách hàng của đơn có email.</span></span></label>
                        <input type="hidden" name="Template.SendEmail" value="false" />
                    </div>
                }
                else
                {
                    <div class="cp-hint" data-cp-no-email>@p.Name: hóa đơn không được gửi email qua kết nối này. Cài gửi email cho người mua trên @p.Short nếu cần.</div>
                    <input type="hidden" name="Template.SendEmail" value="@(t.SendEmail ? "true" : "false")" />
                }
            </div>
            @if (canEdit && s.IsConnected)
            {
                <div class="cp-card__foot">
                    @if (p.HasTemplates) {<button class="cp-btn cp-btn--ghost" type="submit" formaction="@Url.Action("Templates")" formnovalidate>@UiIcon.Render("refresh")<span>Lấy mẫu hóa đơn từ @p.Short</span></button>}
                    @if (s.IsReady && p.ViaPartner) {<button class="cp-btn cp-btn--ghost" type="submit" formaction="@Url.Action("Preview")" formtarget="_blank" formnovalidate>@UiIcon.Render("eye")<span>Xem thử hóa đơn nháp</span></button>}
                    <button class="cp-btn cp-btn--primary" type="submit" style="margin-left:auto">@UiIcon.Render("device-floppy")<span>Lưu cài đặt</span></button>
                </div>
            }
        </form>
    </div>
    <div style="align-self:start">
        @if (Model.Readiness is { Count: > 0 } checks)
        {
            var ready = InvoiceReadiness.FullyAutomatic(checks);
            <section class="cp-card" style="margin-bottom:14px" data-cp-readiness>
                <div class="cp-card__head"><span class="cp-blob">@UiIcon.Render("shield-check")</span><h2>Sẵn sàng xuất tự động</h2>
                    @if (ready) {<span class="cp-badge cp-badge--green" style="margin-left:auto" data-cp-ready>Tự động hoàn toàn</span>}
                    else {<span class="cp-badge cp-badge--gold" style="margin-left:auto">Còn @checks.Count(c => c.State != InvoiceReadinessItem.Ok) việc</span>}</div>
                <div class="cp-card__body">
                    <ul class="cp-readiness">
                        @foreach (var c in checks)
                        {
                            <li class="cp-readiness__item is-@c.State" data-cp-check="@c.Key" data-cp-state="@c.State">
                                @UiIcon.Render(c.State == InvoiceReadinessItem.Ok ? "circle-check" : c.State == InvoiceReadinessItem.Warn ? "alert-triangle" : "alert-circle")
                                <div><strong>@c.Title</strong><span>@c.Detail</span></div>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }
        <details class="cp-card cp-einvoice-guide" style="margin-bottom:14px" open="@(Model.Readiness is { } r && !InvoiceReadiness.FullyAutomatic(r))" data-cp-einvoice-guide>
            <summary class="cp-card__head"><span class="cp-blob cp-blob--gold">@UiIcon.Render("list-tree")</span><h2>Các bước để xuất hóa đơn tự động</h2></summary>
            <div class="cp-card__body">
                <ol class="cp-steps-list">
                    <li><strong>Có hợp đồng hóa đơn điện tử</strong> với @p.Name, đã được cơ quan thuế chấp nhận đăng ký sử dụng (Mẫu 01/ĐKTĐ-HĐĐT) và đã có mẫu số, ký hiệu.</li>
                    <li><strong>Mua chữ ký số từ xa (HSM)</strong>: @p.Signer. Khi mua, nói rõ cần gói cho tổ chức <em>cho phép ký tự động qua hệ thống, không cần xác nhận từng lần</em>. USB token không dùng được.</li>
                    <li><strong>Đăng ký chứng thư số mới với cơ quan thuế</strong>: nộp tờ khai Mẫu 01/ĐKTĐ-HĐĐT (thay đổi thông tin) khai báo chứng thư số từ xa. Thiếu bước này, cơ quan thuế từ chối cấp mã hóa đơn.</li>
                    <li><strong>Liên kết chữ ký số với tài khoản @p.Short</strong> theo hướng dẫn của @p.Short.</li>
                    <li><strong>Kết nối và chọn mẫu tại đây</strong>, bấm "Xem thử hóa đơn nháp" để kiểm tra nội dung.</li>
                    <li><strong>Chọn "Đã có chữ ký số từ xa"</strong>. Hóa đơn đầu tiên cho biết chữ ký đã dùng được chưa: nếu không ký được, hệ thống tạo bản nháp và báo ở mục "Sẵn sàng xuất tự động".</li>
                    <li><strong>Đầu mỗi năm</strong>: tạo ký hiệu của năm mới (VD C27TAA cho năm 2027) và chọn lại mẫu.</li>
                </ol>
            </div>
        </details>
        <aside class="cp-note">@UiIcon.Render("info-circle")<div>
            <strong>Cách hoạt động</strong>
            <p>Khi đơn hàng thanh toán qua QR nhận đủ tiền, hệ thống xuất hóa đơn trên tài khoản phần mềm hóa đơn của doanh nghiệp, mỗi đơn chỉ một hóa đơn: có chữ ký số từ xa thì hóa đơn được ký và gửi cơ quan thuế ngay; chưa có thì tạo hóa đơn nháp để duyệt và ký trên phần mềm hóa đơn.</p>
            <p>Người mua là doanh nghiệp hoặc tổ chức: hóa đơn ghi tên đơn vị và mã số thuế. Khách lẻ: ghi tên khách; đơn không chọn khách ghi "Người mua không lấy hóa đơn".</p>
            <p>Kết quả xem ở trang chi tiết đơn hàng: số hóa đơn, tải PDF, hoặc xuất lại khi có lỗi.</p>
        </div></aside>
    </div>
</div>

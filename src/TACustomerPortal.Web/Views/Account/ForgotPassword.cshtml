@model ForgotPasswordVm
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="cp-auth">
    <section class="cp-auth__panel" aria-hidden="true">
        <span class="cp-brand"><img src="~/images/logo.png" class="cp-brand__logo" alt="" width="34" height="34" /><span class="cp-brand__text">Hóa đơn tự động<small>Thu tiền &amp; xuất hóa đơn</small></span></span>
        <div class="cp-auth__headline">
            <h1>Khôi phục <em>mật khẩu.</em></h1>
            <p>Nhận liên kết đặt mật khẩu mới qua email đã đăng ký với Hóa đơn tự động.</p>
        </div>
    </section>
    <div class="cp-auth__form">
        <div class="cp-auth__card">
            <div class="cp-eyebrow">Hóa đơn tự động</div>
            <h2>Quên mật khẩu</h2>
            @if (!Model.Enabled)
            {
                <div class="cp-note" role="status" data-cp-forgot-disabled>@UiIcon.Render("info-circle")<div>Khôi phục mật khẩu qua email chưa được bật. Vui lòng liên hệ bộ phận hỗ trợ Hóa đơn tự động để được cấp mật khẩu tạm.</div></div>
            }
            else if (Model.Sent)
            {
                <div class="cp-note" role="status" data-cp-forgot-sent>@UiIcon.Render("mail")<div>Nếu tài khoản tồn tại và có email đăng ký, Hóa đơn tự động đã gửi liên kết đặt lại mật khẩu tới email đó. Liên kết có hiệu lực 30 phút và chỉ dùng được một lần. Không thấy email? Kiểm tra thư mục Spam, hoặc liên hệ bộ phận hỗ trợ Hóa đơn tự động.</div></div>
            }
            else
            {
                <p>Nhập tên đăng nhập hoặc email của tài khoản. Hóa đơn tự động sẽ gửi liên kết đặt mật khẩu mới tới email đã đăng ký.</p>
                <form method="post" asp-action="ForgotPassword">
                    <div asp-validation-summary="All" class="cp-alert" role="alert"></div>
                    <div class="cp-field">
                        <label asp-for="Login" class="cp-label">Tên đăng nhập hoặc email</label>
                        <div class="cp-input-wrap">@UiIcon.Render("user")<input asp-for="Login" class="cp-input" autocomplete="username" required maxlength="256" placeholder="Nhập tên đăng nhập hoặc email" /></div>
                    </div>
                    <button type="submit" class="cp-btn cp-btn--primary cp-btn--block">@UiIcon.Render("mail")<span>Gửi liên kết</span></button>
                </form>
            }
            <p class="cp-auth__foot"><a asp-action="Login">@UiIcon.Render("arrow-left")<span>Quay lại đăng nhập</span></a></p>
        </div>
    </div>
</div>

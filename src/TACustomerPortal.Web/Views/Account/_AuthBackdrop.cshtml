@* Light side backdrop: invoice sheets, QR tiles and receipts drifting slowly behind the sign-in card. Decorative only. *@
@{
    // x (%), size (px), duration (s), delay (s, negative = already on its way), kind
    var items = new (int X, int Size, int Dur, int Delay, string Kind)[]
    {
        (6, 64, 26, -4, "invoice"), (18, 34, 21, -15, "qr"), (30, 46, 30, -9, "receipt"), (44, 28, 19, -2, "coin"),
        (58, 56, 28, -20, "invoice"), (70, 32, 22, -11, "qr"), (82, 50, 27, -6, "receipt"), (92, 30, 20, -17, "coin"),
        (12, 40, 33, -24, "receipt"), (64, 26, 24, -1, "coin"), (38, 58, 35, -28, "invoice"), (88, 38, 25, -13, "qr"),
    };
}
<div class="cp-backdrop" aria-hidden="true">
    <span class="cp-backdrop__glow cp-backdrop__glow--a"></span>
    <span class="cp-backdrop__glow cp-backdrop__glow--b"></span>
    @foreach (var i in items)
    {
        <span class="cp-backdrop__item cp-backdrop__item--@i.Kind" style="left:@(i.X)%;top:@(105 - 117 * -i.Delay / i.Dur)%;width:@(i.Size)px;animation-duration:@(i.Dur)s;animation-delay:@(i.Delay)s">
            @switch (i.Kind)
            {
                case "invoice":
                    <svg viewBox="0 0 48 60"><path d="M6 2h28l12 12v42a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" /><path d="M34 2v12h12" /><path d="M11 22h20M11 30h26M11 38h16M27 48h12" /></svg>
                    break;
                case "qr":
                    <svg viewBox="0 0 40 40"><rect x="2" y="2" width="14" height="14" rx="2" /><rect x="24" y="2" width="14" height="14" rx="2" /><rect x="2" y="24" width="14" height="14" rx="2" /><path d="M24 24h6v6M38 24v14H30M24 34v4" /></svg>
                    break;
                case "receipt":
                    <svg viewBox="0 0 40 56"><path d="M4 2h32v52l-5-4-5 4-5-4-5 4-5-4-7 4z" /><path d="M10 14h20M10 22h20M10 30h12M22 40h8" /></svg>
                    break;
                default:
                    <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" /><path d="M24 12h-6a4 4 0 0 0 0 8h4a4 4 0 0 1 0 8h-7M20 8v4M20 28v4" /></svg>
                    break;
            }
        </span>
    }
</div>

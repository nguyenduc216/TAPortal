@model ChangePasswordVm
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Subtitle"] = "Mật khẩu mới dùng chung với TAPortal. Bạn sẽ đăng nhập lại sau khi đổi.";
    ViewData["PageIcon"] = "key";
}
@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent Toggle(string id) => new Microsoft.AspNetCore.Html.HtmlString(
        $"<button class=\"ta-password-toggle\" type=\"button\" onclick=\"taTogglePassword('{id}',this)\" aria-label=\"Hiện mật khẩu\" aria-pressed=\"false\">{UiIcon.Render("eye", "ta-icon-show")}{UiIcon.Render("eye-off", "ta-icon-hide")}</button>");
}
<div class="row"><div class="col-xl-6 col-lg-8">
<form class="card" method="post" asp-action="ChangePassword">
    <div class="card-body">
        <div asp-validation-summary="All" class="ta-alert ta-alert--danger" role="alert"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><div class="ta-input-icon">@UiIcon.Render("lock")<input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" required />@Toggle("CurrentPassword")</div></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><div class="ta-input-icon">@UiIcon.Render("lock")<input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" required oninput="taCheckPassword(this.value,'newPasswordRules');taCheckConfirm('NewPassword','ConfirmPassword','confirmRule')" />@Toggle("NewPassword")</div>
            <ul id="newPasswordRules" class="password-rules"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul>
            <div class="form-hint">Mật khẩu mới phải khác mật khẩu hiện tại.</div></div>
        <div><label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label><div class="ta-input-icon">@UiIcon.Render("lock")<input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required oninput="taCheckConfirm('NewPassword','ConfirmPassword','confirmRule')" />@Toggle("ConfirmPassword")</div>
            <ul class="password-rules"><li id="confirmRule">Khớp với mật khẩu mới</li></ul></div>
    </div>
    <div class="card-footer ta-form-actions"><button type="submit" class="btn btn-primary ms-auto">@UiIcon.Render("device-floppy")<span>Cập nhật mật khẩu</span></button></div>
</form>
</div></div>

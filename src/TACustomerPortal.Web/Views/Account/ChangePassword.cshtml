@model ChangePasswordVm
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Subtitle"] = "Mật khẩu mới dùng chung với TAPortal. Bạn sẽ đăng nhập lại sau khi đổi.";
    ViewData["PageIcon"] = "key";
}
<div class="row"><div class="col-xl-6 col-lg-8">
<form class="card" method="post" asp-action="ChangePassword">
    <div class="card-body">
        <div asp-validation-summary="All" class="ta-alert ta-alert--danger" role="alert"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" required /></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" required /></div>
        <div><label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required /></div>
    </div>
    <div class="card-footer ta-form-actions"><button type="submit" class="btn btn-primary ms-auto">@UiIcon.Render("device-floppy")<span>Cập nhật mật khẩu</span></button></div>
</form>
</div></div>

@model ChangePasswordVm
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Eyebrow"] = "Bảo mật";
    ViewData["Subtitle"] = "Mật khẩu mới dùng chung với TAPortal. Bạn sẽ đăng nhập lại sau khi đổi.";
}
@functions {
    private static IHtmlContent Toggle(string id) => new HtmlString(
        $"<button class=\"cp-toggle\" type=\"button\" onclick=\"taTogglePassword('{id}',this)\" aria-label=\"Hiện mật khẩu\" aria-pressed=\"false\">{UiIcon.Render("eye", "ta-icon-show")}{UiIcon.Render("eye-off", "ta-icon-hide")}</button>");
}
<div class="cp-grid cp-grid--2">
<form class="cp-card" method="post" asp-action="ChangePassword">
    <div class="cp-card__body">
        <div asp-validation-summary="All" class="cp-alert" role="alert"></div>
        <div class="cp-field"><label asp-for="CurrentPassword" class="cp-label">Mật khẩu hiện tại</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input asp-for="CurrentPassword" class="cp-input" type="password" autocomplete="current-password" required />@Toggle("CurrentPassword")</div></div>
        <div class="cp-field"><label asp-for="NewPassword" class="cp-label">Mật khẩu mới</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input asp-for="NewPassword" class="cp-input" type="password" autocomplete="new-password" required oninput="taCheckPassword(this.value,'newPasswordRules');taCheckConfirm('NewPassword','ConfirmPassword','confirmRule')" />@Toggle("NewPassword")</div>
            <ul id="newPasswordRules" class="password-rules"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div>
        <div class="cp-field" style="margin-bottom:0"><label asp-for="ConfirmPassword" class="cp-label">Xác nhận mật khẩu</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input asp-for="ConfirmPassword" class="cp-input" type="password" autocomplete="new-password" required oninput="taCheckConfirm('NewPassword','ConfirmPassword','confirmRule')" />@Toggle("ConfirmPassword")</div>
            <ul class="password-rules"><li id="confirmRule">Khớp với mật khẩu mới</li></ul></div>
    </div>
    <div class="cp-card__foot"><button type="submit" class="cp-btn cp-btn--primary" style="margin-left:auto">@UiIcon.Render("device-floppy")<span>Cập nhật mật khẩu</span></button></div>
</form>
<aside class="cp-note" style="align-self:start">@UiIcon.Render("info-circle")<div>Mật khẩu mới phải khác mật khẩu hiện tại. Sau khi đổi, mọi phiên đăng nhập hiện tại sẽ kết thúc và bạn cần đăng nhập lại.</div></aside>
</div>

@model ChangePasswordVm
@{ViewData["Title"]="Đổi mật khẩu";}
<h1>Đổi mật khẩu</h1><div class="panel"><p class="muted">Mật khẩu mới dùng chung với TAPortal. Bạn sẽ đăng nhập lại sau khi đổi.</p><form method="post" asp-action="ChangePassword"><div asp-validation-summary="All"></div><label class="form-label">Mật khẩu hiện tại<input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" required/></label><label class="form-label">Mật khẩu mới<input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" required/></label><label class="form-label">Xác nhận mật khẩu<input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required/></label><button class="btn btn-primary mt-3">Cập nhật mật khẩu</button></form></div>

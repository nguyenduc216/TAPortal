@model SignupVm
@{
    ViewData["Title"] = "Đăng ký";
    var individual = Model.CustomerType == SignupVm.Individual;
}
<div class="cp-auth">
    <section class="cp-auth__panel" aria-hidden="true">
        <span class="cp-brand"><img src="~/images/logo.png" class="cp-brand__logo" alt="" width="34" height="34" /><span class="cp-brand__text">Hóa đơn tự động<small>Thu tiền &amp; xuất hóa đơn</small></span></span>
        <div class="cp-auth__headline">
            <h1>Bắt đầu cùng Hóa đơn tự động <em>trong vài phút.</em></h1>
            <p>Đăng ký cho doanh nghiệp, hộ kinh doanh hoặc cá nhân; chọn gói dịch vụ và quản lý thanh toán, hóa đơn điện tử ở một nơi.</p>
        </div>
        <ul class="cp-auth__points">
            <li><span>@UiIcon.Render("receipt-tax")</span>Nhập mã số thuế, tự điền tên và địa chỉ</li>
            <li><span>@UiIcon.Render("mail")</span>Thông tin đăng nhập gửi về email</li>
            <li><span>@UiIcon.Render("shield-check")</span>Dữ liệu riêng cho từng tài khoản</li>
        </ul>
    </section>
    <div class="cp-auth__form">
        <div class="cp-auth__card cp-auth__card--wide">
            <div class="cp-eyebrow">Hóa đơn tự động</div>
            <h2>Đăng ký tài khoản</h2>
            <p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
            <form method="post" asp-action="Register" data-cp-signup>
                <div asp-validation-summary="ModelOnly" class="cp-alert" role="alert"></div>
                <div class="cp-seg cp-seg--3" role="radiogroup" aria-label="Loại hình">
                    <label><input type="radio" name="CustomerType" value="@SignupVm.Business" checked="@(Model.CustomerType is not (SignupVm.Household or SignupVm.Individual))" /><strong>Doanh nghiệp</strong><small>Công ty, chi nhánh (MST 10 số)</small></label>
                    <label><input type="radio" name="CustomerType" value="@SignupVm.Household" checked="@(Model.CustomerType == SignupVm.Household)" /><strong>Hộ kinh doanh</strong><small>MST 10 hoặc 12 số</small></label>
                    <label><input type="radio" name="CustomerType" value="@SignupVm.Individual" checked="@individual" /><strong>Cá nhân</strong><small>Không bắt buộc MST, chỉ dùng thu tiền</small></label>
                </div>
                <div class="cp-form-grid">
                    <div class="cp-field cp-span">
                        <label asp-for="TaxCode" class="cp-label" data-cp-signup-tax-label>@(individual ? "Mã số thuế cá nhân (không bắt buộc)" : "Mã số thuế")</label>
                        <div class="cp-lookup">
                            <div class="cp-input-wrap">@UiIcon.Render("receipt-tax")<input asp-for="TaxCode" class="cp-input" inputmode="numeric" maxlength="20" required="@(!individual)" autocomplete="off" placeholder="VD: 0101234567" data-cp-tax-input /></div>
                            <button class="cp-btn cp-btn--ghost" type="button" data-cp-tax-lookup="@Url.Action("TaxLookup")" data-cp-fill-name="#CompanyName" data-cp-fill-address="#Address" hidden="@individual">@UiIcon.Render("search")<span>Tra cứu</span></button>
                        </div>
                        <div class="cp-lookup-msg" aria-live="polite" data-cp-tax-msg>@(individual ? "Cá nhân không có mã số thuế vẫn đăng ký được; khi đó chỉ dùng phần thu tiền, chưa xuất hóa đơn điện tử đứng tên mình." : "Nhập MST rồi bấm Tra cứu (hoặc rời ô) để tự điền tên và địa chỉ.")</div>
                        <span asp-validation-for="TaxCode" class="cp-error"></span>
                    </div>
                    <div class="cp-field cp-span"><label asp-for="CompanyName" class="cp-label" data-cp-signup-name-label>@(individual ? "Họ và tên" : "Tên doanh nghiệp / hộ kinh doanh")</label><div class="cp-input-wrap">@UiIcon.Render("building")<input asp-for="CompanyName" class="cp-input" maxlength="250" required /></div><span asp-validation-for="CompanyName" class="cp-error"></span></div>
                    <div class="cp-field cp-span"><label asp-for="Address" class="cp-label">Địa chỉ</label><div class="cp-input-wrap">@UiIcon.Render("map-pin")<input asp-for="Address" class="cp-input" maxlength="1000" /></div><span asp-validation-for="Address" class="cp-error"></span></div>
                    <div class="cp-field"><label asp-for="ContactName" class="cp-label">Người liên hệ</label><div class="cp-input-wrap">@UiIcon.Render("user")<input asp-for="ContactName" class="cp-input" maxlength="200" required autocomplete="name" /></div><span asp-validation-for="ContactName" class="cp-error"></span></div>
                    <div class="cp-field"><label asp-for="Phone" class="cp-label">Điện thoại</label><div class="cp-input-wrap">@UiIcon.Render("phone")<input asp-for="Phone" class="cp-input" inputmode="tel" maxlength="10" required autocomplete="tel" /></div><span asp-validation-for="Phone" class="cp-error"></span></div>
                    <div class="cp-field cp-span"><label asp-for="Email" class="cp-label">Email (dùng để đăng nhập)</label><div class="cp-input-wrap">@UiIcon.Render("mail")<input asp-for="Email" class="cp-input" type="email" maxlength="100" required autocomplete="email" /></div><div class="cp-hint">Mật khẩu đăng nhập do hệ thống tạo và gửi về email này; bạn đổi mật khẩu ở lần đăng nhập đầu tiên.</div><span asp-validation-for="Email" class="cp-error"></span></div>
                    <div class="cp-field cp-span"><label class="cp-check"><input type="checkbox" name="AcceptTerms" value="true" checked="@Model.AcceptTerms" required data-cp-terms-accept /><span>Tôi đồng ý với <a asp-action="Terms" target="_blank" data-cp-terms-open>điều khoản sử dụng dịch vụ Hóa đơn tự động</a> và xác nhận thông tin đăng ký là đúng.</span></label><span asp-validation-for="AcceptTerms" class="cp-error"></span></div>
                </div>
                <button type="submit" class="cp-btn cp-btn--primary cp-btn--block">@UiIcon.Render("user-plus")<span>Đăng ký</span></button>
            </form>
            <p class="cp-auth__foot">Sau khi đăng ký, kiểm tra email để nhận thông tin đăng nhập.</p>
        </div>
        <partial name="_AuthMaker" />
    </div>
</div>
<dialog class="cp-terms-dialog" id="termsDialog" aria-labelledby="termsTitle" data-cp-terms-dialog>
    <div class="cp-terms-dialog__head">
        <h2 id="termsTitle">@TAPortal.Shared.PortalTerms.Title</h2>
        <button type="button" class="cp-terms-dialog__close" aria-label="Đóng" data-cp-terms-close>@UiIcon.Render("x")</button>
    </div>
    <div class="cp-terms-dialog__body"><partial name="_TermsBody" /></div>
    <div class="cp-terms-dialog__foot">
        <button type="button" class="cp-btn cp-btn--ghost" data-cp-terms-close>Đóng</button>
        <button type="button" class="cp-btn cp-btn--primary" data-cp-terms-agree>@UiIcon.Render("circle-check")<span>Tôi đồng ý</span></button>
    </div>
</dialog>

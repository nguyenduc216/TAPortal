@model ResetPasswordVm
@using Microsoft.AspNetCore.Html
@{ ViewData["Title"] = "Đặt mật khẩu mới"; }
@functions {
    private static IHtmlContent Toggle(string id) => new HtmlString(
        $"<button class=\"cp-toggle\" type=\"button\" onclick=\"taTogglePassword('{id}',this)\" aria-label=\"Hiện mật khẩu\" aria-pressed=\"false\">{UiIcon.Render("eye", "ta-icon-show")}{UiIcon.Render("eye-off", "ta-icon-hide")}</button>");
}
<div class="cp-auth">
    <section class="cp-auth__panel" aria-hidden="true">
        <span class="cp-brand"><img src="~/images/logo.svg" class="cp-brand__logo" alt="" width="34" height="34" /><span class="cp-brand__text">Hóa đơn tự động<small>Thu tiền &amp; xuất hóa đơn</small></span></span>
        <div class="cp-auth__headline">
            <h1>Đặt <em>mật khẩu mới.</em></h1>
            <p>Mật khẩu mới dùng cho lần đăng nhập tiếp theo vào Hóa đơn tự động.</p>
        </div>
    </section>
    <div class="cp-auth__form">
        <div class="cp-auth__card">
            <div class="cp-eyebrow">Hóa đơn tự động</div>
            <h2>Đặt mật khẩu mới</h2>
            @if (!Model.Valid)
            {
                <div class="cp-alert" role="alert" data-cp-reset-invalid>Liên kết đặt lại mật khẩu không hợp lệ, đã hết hạn hoặc đã được dùng. Hãy yêu cầu liên kết mới.</div>
                <a class="cp-btn cp-btn--primary cp-btn--block" asp-action="ForgotPassword">@UiIcon.Render("mail")<span>Yêu cầu liên kết mới</span></a>
            }
            else
            {
                <p>Tài khoản <strong>@Model.Username</strong></p>
                <form method="post" asp-action="ResetPassword">
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="All" class="cp-alert" role="alert"></div>
                    <div class="cp-field"><label asp-for="NewPassword" class="cp-label">Mật khẩu mới</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input asp-for="NewPassword" class="cp-input" type="password" autocomplete="new-password" required oninput="taCheckPassword(this.value,'newPasswordRules');taCheckConfirm('NewPassword','ConfirmPassword','confirmRule')" />@Toggle("NewPassword")</div>
                        <ul id="newPasswordRules" class="password-rules"><li data-rule="len">Ít nhất 8 ký tự</li><li data-rule="letter">Có chữ cái</li><li data-rule="digit">Có chữ số</li><li data-rule="special">Có ký tự đặc biệt</li></ul></div>
                    <div class="cp-field"><label asp-for="ConfirmPassword" class="cp-label">Xác nhận mật khẩu</label><div class="cp-input-wrap">@UiIcon.Render("lock")<input asp-for="ConfirmPassword" class="cp-input" type="password" autocomplete="new-password" required oninput="taCheckConfirm('NewPassword','ConfirmPassword','confirmRule')" />@Toggle("ConfirmPassword")</div>
                        <ul class="password-rules"><li id="confirmRule">Khớp với mật khẩu mới</li></ul></div>
                    <button type="submit" class="cp-btn cp-btn--primary cp-btn--block">@UiIcon.Render("device-floppy")<span>Lưu mật khẩu mới</span></button>
                </form>
            }
            <p class="cp-auth__foot"><a asp-action="Login">@UiIcon.Render("arrow-left")<span>Quay lại đăng nhập</span></a></p>
        </div>
    </div>
</div>

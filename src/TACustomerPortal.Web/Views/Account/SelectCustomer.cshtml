@model IReadOnlyList<CustomerMembership>
@{
    ViewData["Title"] = "Chọn doanh nghiệp";
    ViewData["Subtitle"] = "Truy cập doanh nghiệp bạn được cấp quyền quản lý.";
    ViewData["PageIcon"] = "switch-horizontal";
}
<div class="ta-company-list">
@foreach (var c in Model)
{
    <form method="post" asp-action="SelectCustomer"><input type="hidden" name="customerId" value="@c.CustomerId" />
        <button type="submit" class="ta-company-option">
            <span class="ta-stat-icon" aria-hidden="true">@UiIcon.Render("building")</span>
            <span class="ta-company-option__body"><span class="ta-company-option__name">@c.Name</span><span class="ta-company-option__meta">@c.Code · Vai trò: @c.Role</span></span>
            @UiIcon.Render("chevron-right", "text-secondary")
        </button>
    </form>
}
</div>

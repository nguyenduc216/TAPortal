@model PayPageVm
@using TAPortal.Integrations.Tingee
@inject IBankAppCatalog BankApps
@{
    // Public page: its own minimal shell (no portal navigation), also when a signed-in staff member opens the link.
    Layout = null;
    var o = Model.Order;
    var (label, css) = PaymentText.OrderStatus(Model.Status);
    var transfer = OrderMath.TransferContent(o.OrderNo);
    var pay = "/pay/" + Model.Token;
    var downloadIcon = new Microsoft.AspNetCore.Html.HtmlString("<svg class=\"ta-icon\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\" aria-hidden=\"true\"><path d=\"M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2\"/><path d=\"M7 11l5 5l5 -5\"/><path d=\"M12 4l0 12\"/></svg>");
    // Link previews (Zalo, Messenger…): the portal logo (og-share.png) and "Thanh toán <tiêu đề>"; absolute URLs, as crawlers require.
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var shareText = "Thanh toán " + Model.Title;
    var message = Model.Status switch
    {
        OrderStatus.Paid => "Đơn hàng đã được thanh toán đủ. Cảm ơn quý khách!",
        OrderStatus.Cancelled or OrderStatus.CancelledPaid => "Đơn hàng đã hủy. Vui lòng liên hệ người bán nếu cần hỗ trợ.",
        OrderStatus.Expired or OrderStatus.ExpiredPaid => "Mã QR đã hết hạn. Vui lòng liên hệ người bán để nhận mã mới.",
        _ => "Đơn hàng chưa có mã QR thanh toán. Vui lòng liên hệ người bán."
    };
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/png" href="~/images/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <meta name="theme-color" content="#A16207" />
    <title>@Model.Title · @Model.SellerName</title>
    <meta name="description" content="@shareText" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hóa đơn tự động" />
    <meta property="og:title" content="@Model.Title · @Model.SellerName" />
    <meta property="og:description" content="@shareText" />
    <meta property="og:url" content="@(origin + pay)" />
    <meta property="og:image" content="@(origin + "/images/og-share.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hóa đơn tự động" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>
<body class="cp cp-pay-body">
<main class="cp-pay">
    <article class="cp-pay__card" aria-labelledby="payTitle">
        <header class="cp-pay__brands @(Model.BuyerName is null ? "is-single" : "")" aria-label="Các bên của đơn hàng">
            @* Buyer on the left, seller on the right: the payment flows from the customer through the bank to the seller. *@
            @if (Model.BuyerName is string buyer)
            {
                <figure class="cp-pay__party cp-pay__party--buyer">
                    <span class="cp-pay__logo">
                        @if (Model.BuyerLogo is string bv) {<img src="@pay/logo/buyer?v=@bv" alt="Logo @buyer" />}
                        else {<span class="cp-pay__initials cp-pay__initials--buyer" aria-hidden="true">@PayPageVm.Initials(buyer)</span>}
                    </span>
                    <figcaption><small>Khách hàng</small><strong>@buyer</strong></figcaption>
                </figure>
                @* Paid in full: the bank in between becomes a green check (operator 2026-11-06). *@
                <div class="cp-pay__bridge@(Model.Status == OrderStatus.Paid ? " is-paid" : "")" aria-hidden="true"><span class="cp-pay__wire"></span><span class="cp-pay__knot">@UiIcon.Render(Model.Status == OrderStatus.Paid ? "circle-check" : "building-bank")</span><span class="cp-pay__wire"></span></div>
            }
            <figure class="cp-pay__party cp-pay__party--seller">
                <span class="cp-pay__logo">
                    @if (Model.SellerLogo is string sv) {<img src="@pay/logo/seller?v=@sv" alt="Logo @Model.SellerName" />}
                    else {<span class="cp-pay__initials" aria-hidden="true">@PayPageVm.Initials(Model.SellerName)</span>}
                </span>
                <figcaption><small>Người bán</small><strong>@Model.SellerName</strong></figcaption>
            </figure>
        </header>

        <section class="cp-pay__head">
            <div class="cp-eyebrow">Đơn hàng <span class="cp-code">@o.OrderNo</span></div>
            <h1 id="payTitle">@Model.Title</h1>
            <span class="cp-badge @css" data-cp-order-status="@Model.Status">@label</span>
        </section>

        @* Goods and services right under the title (operator 2026-11-06), then the transfer button. *@
        @if (o.Lines.Count > 0)
        {
            <details class="cp-pay__lines">
                <summary>@UiIcon.Render("list-tree")Chi tiết hàng hóa, dịch vụ (@o.Lines.Count)</summary>
                <ul>
                    @foreach (var l in o.Lines)
                    {
                        <li><span>@l.ItemName <small class="cp-muted">× @l.Quantity.ToString("0.###")@(l.UnitName is null ? "" : " " + l.UnitName)</small></span><strong>@PaymentText.Money(l.Total)</strong></li>
                    }
                </ul>
            </details>
        }

        @if (Model.Transfer is not null) {<button class="cp-btn cp-btn--primary cp-btn--block cp-pay__transfer" type="button" data-cp-open-dialog="bankApps">@UiIcon.Render("building-bank")<span>Chuyển khoản</span></button>}

        @if (TempData["Success"] is string ok) {<div class="cp-flash cp-flash--ok" role="status">@UiIcon.Render("circle-check")<div>@ok</div></div>}
        @if (TempData["Error"] is string err) {<div class="cp-flash cp-flash--error" role="alert">@UiIcon.Render("alert-circle")<div>@err</div></div>}

        <section class="cp-pay__invoice" id="invoice" aria-labelledby="invoiceTitle">
            <div class="cp-pay__section-title" id="invoiceTitle">@UiIcon.Render("receipt-tax")Thông tin xuất hóa đơn</div>
            @if (Model.InvoiceEditable)
            {
                <form method="post" action="@pay/invoice" data-cp-dirty-form>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="cp-alert" role="alert"></div>
                    <div class="cp-pay__invoice-row">
                        <div class="cp-field">
                            <label class="cp-label" for="TaxCode">Mã số thuế</label>
                            <div class="cp-lookup">
                                <div class="cp-input-wrap">@UiIcon.Render("hash")<input class="cp-input" id="TaxCode" name="TaxCode" value="@Model.Input.TaxCode" data-cp-saved="@Model.Saved.TaxCode" inputmode="numeric" maxlength="20" autocomplete="off" placeholder="Không bắt buộc" data-cp-tax-input /></div>
                                <button class="cp-btn cp-btn--ghost cp-btn--icon" type="button" title="Tra cứu tên theo mã số thuế" aria-label="Tra cứu mã số thuế" data-cp-tax-lookup="@Url.Action("TaxLookup", "Account")" data-cp-fill-name="#Name">@UiIcon.Render("search")</button>
                            </div>
                            <div class="cp-lookup-msg" aria-live="polite" data-cp-tax-msg></div>
                            <span class="cp-error">@Html.ValidationMessage("TaxCode")</span>
                        </div>
                        <div class="cp-field">
                            <label class="cp-label" for="Name">Tên xuất hóa đơn</label>
                            <div class="cp-input-wrap">@UiIcon.Render("building")<input class="cp-input" id="Name" name="Name" value="@Model.Input.Name" data-cp-saved="@Model.Saved.Name" maxlength="250" placeholder="Tự điền khi tra cứu mã số thuế" readonly /></div>
                            <span class="cp-error">@Html.ValidationMessage("Name")</span>
                        </div>
                        <button class="cp-btn cp-btn--primary cp-pay__save" type="submit">@UiIcon.Render("device-floppy")<span>Lưu</span></button>
                    </div>
                    <p class="cp-hint">Nhập mã số thuế, bấm tra cứu rồi Lưu: chỉ lưu được mã số thuế có trong đăng ký kinh doanh, tên đơn vị lấy theo đăng ký. Hóa đơn điện tử được xuất theo thông tin này.@if (Model.InvoiceUpdatedAt is not null) {<span> Đã cập nhật lúc @PaymentText.VietnamTime(Model.InvoiceUpdatedAt).</span>}</p>
                </form>
            }
            else
            {
                <dl class="cp-pay__facts">
                    <div><dt>Mã số thuế</dt><dd>@(Model.Saved.TaxCode ?? "—")</dd></div>
                    <div><dt>Tên xuất hóa đơn</dt><dd>@(Model.Saved.Name ?? "—")</dd></div>
                </dl>
                <p class="cp-hint">@(o.InvoiceStatus == OrderInvoiceStatus.Issued ? "Hóa đơn điện tử đã được xuất cho đơn hàng này." : o.InvoiceStatus is OrderInvoiceStatus.Pending or OrderInvoiceStatus.Draft ? "Hóa đơn điện tử đang được xuất." : Model.Saved.TaxCode is not null && Model.Status is not (OrderStatus.Cancelled or OrderStatus.CancelledPaid) ? "Thông tin xuất hóa đơn do người bán cung cấp." : "Không thể thay đổi thông tin xuất hóa đơn của đơn hàng này.")</p>
            }
        </section>

        <section class="cp-pay__qr" aria-label="Mã QR thanh toán">
            @if (Model.QrSvg is string svg)
            {
                <div class="cp-pay__qr-box" data-cp-poll="@pay/status" data-cp-poll-status="@Model.Status" data-cp-poll-paid="@o.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @Html.Raw(svg)
                </div>
                <div class="cp-pay__amount"><small>Số tiền cần thanh toán</small><strong>@PaymentText.Money(o.Remaining)</strong>@if (o.PaidAmount > 0) {<span class="cp-muted">Đã thanh toán @PaymentText.Money(o.PaidAmount) / @PaymentText.Money(o.Amount)</span>}</div>
                @if (o.ExpiresAt is DateTime expires)
                {
                    <div class="cp-pay__timer" data-cp-countdown="@expires.ToString("o", System.Globalization.CultureInfo.InvariantCulture)" data-cp-countdown-now="@Model.UtcNow.ToString("o", System.Globalization.CultureInfo.InvariantCulture)" role="timer" aria-live="off">
                        @UiIcon.Render("clock")<span>Mã QR còn hiệu lực</span><strong data-cp-countdown-value>@QrLifetime.Text(Math.Max(0, (int)(expires - Model.UtcNow).TotalMinutes))</strong>
                    </div>
                    <div class="cp-muted cp-pay__until">Hết hạn lúc @PaymentText.VietnamTime(expires)</div>
                }
                @* "Tải mã QR" (operator 2026-11-10): one PNG with the QR and the transfer details under it, drawn in the browser. *@
                <button class="cp-btn cp-btn--ghost cp-pay__qr-save" type="button" data-cp-save-qr>@downloadIcon<span>Tải ảnh mã QR</span></button>
                <script type="application/json" data-cp-qr-info>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
                {
                    file = "QR-" + o.OrderNo + ".png",
                    seller = Model.SellerName,
                    title = Model.Title,
                    amount = PaymentText.Money(o.Remaining),
                    rows = new[]
                    {
                        new[] { "Ngân hàng nhận", Model.BankName ?? "" },
                        new[] { "Tài khoản thụ hưởng", Model.AccountName ?? "" },
                        new[] { "Số tài khoản", Model.Account ?? Model.Transfer?.Account ?? "" },
                        new[] { "Nội dung chuyển khoản", Model.Transfer?.Content ?? transfer },
                        new[] { "Mã đơn hàng", o.OrderNo },
                        new[] { "Hết hạn lúc", o.ExpiresAt is null ? "" : PaymentText.VietnamTime(o.ExpiresAt) },
                    }.Where(r => r[1].Length > 0)
                }))</script>
                <dialog class="cp-pay__apps cp-pay__qr-image" id="qrImage" aria-labelledby="qrImageTitle">
                    <div class="cp-pay__apps-head">
                        <strong id="qrImageTitle">Ảnh mã QR</strong>
                        <button class="cp-pay__apps-close" type="button" aria-label="Đóng" data-cp-close-dialog>×</button>
                    </div>
                    <p class="cp-hint">Nhấn giữ ảnh để lưu vào máy, hoặc bấm Tải xuống.</p>
                    <img alt="Mã QR thanh toán kèm thông tin chuyển khoản" data-cp-qr-image />
                    <a class="cp-btn cp-btn--primary cp-btn--block" data-cp-qr-download>@downloadIcon<span>Tải xuống</span></a>
                </dialog>
            }
            else
            {
                <div class="cp-pay__done @(Model.Status == OrderStatus.Paid ? "is-paid" : "")">@UiIcon.Render(Model.Status == OrderStatus.Paid ? "circle-check" : "qrcode")<p>@message</p></div>
                <div class="cp-pay__amount"><small>Tổng tiền đơn hàng</small><strong>@PaymentText.Money(o.Amount)</strong></div>
            }
        </section>

        <dl class="cp-pay__facts">
            <div><dt>Mã đơn hàng</dt><dd><span class="cp-code">@o.OrderNo</span></dd></div>
            @* Copy buttons (operator 2026-11-10): for banks whose app cannot be opened with the transfer filled in. *@
            @if (Model.Open && Model.BankName is string bankName) {<div><dt>Ngân hàng nhận</dt><dd>@bankName</dd></div>}
            @if (Model.Open && Model.AccountName is string holder) {<div><dt>Tài khoản thụ hưởng</dt><dd>@holder</dd></div>}
            @if (Model.Open && (Model.Account ?? Model.Transfer?.Account) is string acc) {<div><dt>Số tài khoản</dt><dd class="cp-pay__copy"><span>@acc</span><button type="button" data-cp-copy-text="@acc" title="Sao chép số tài khoản" aria-label="Sao chép số tài khoản">@UiIcon.Render("copy")</button></dd></div>}
            @if (Model.Open) {<div><dt>Số tiền</dt><dd class="cp-pay__copy"><span>@PaymentText.Money(o.Remaining)</span><button type="button" data-cp-copy-text="@o.Remaining.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" title="Sao chép số tiền" aria-label="Sao chép số tiền">@UiIcon.Render("copy")</button></dd></div>}
            @if (Model.Open) {<div><dt>Nội dung chuyển khoản</dt><dd class="cp-pay__copy"><span class="cp-code">@(Model.Transfer?.Content ?? transfer)</span><button type="button" data-cp-copy-text="@(Model.Transfer?.Content ?? transfer)" title="Sao chép nội dung" aria-label="Sao chép nội dung chuyển khoản">@UiIcon.Render("copy")</button></dd></div>}
            <div><dt>Ngày tạo</dt><dd>@PaymentText.VietnamTime(o.CreatedAt)</dd></div>
        </dl>

        @if (Model.Open && Model.QrOnly)
        {
            <p class="cp-note" data-cp-pay-qr-only>@UiIcon.Render("info-circle")<span>Quét mã QR (hoặc tải ảnh mã QR rồi quét từ ảnh) để thanh toán được xác nhận tự động. Chuyển khoản tay vào số tài khoản trên vẫn nhận được tiền, nhưng người bán sẽ xác nhận sau.</span></p>
        }
        @if (Model.Transfer is { } t)
        {
            <button class="cp-btn cp-btn--primary cp-btn--block cp-pay__transfer" type="button" data-cp-open-dialog="bankApps">@UiIcon.Render("building-bank")<span>Chuyển khoản @PaymentText.Money(o.Remaining)</span></button>
            <dialog class="cp-pay__apps" id="bankApps" aria-labelledby="bankAppsTitle">
                <div class="cp-pay__apps-head">
                    <strong id="bankAppsTitle">Chọn ứng dụng ngân hàng</strong>
                    <button class="cp-pay__apps-close" type="button" aria-label="Đóng" data-cp-close-dialog>×</button>
                </div>
                @* Autofill apps open their transfer screen with the QR's account, amount and content; the others only open the app. *@
                @if (!Model.QrOnly)
                {
                <div class="cp-pay__apps-group">Điền sẵn thông tin chuyển khoản</div>
                <p class="cp-hint">Ứng dụng mở màn hình chuyển khoản với số tài khoản, số tiền và nội dung <span class="cp-code">@(t.Content ?? transfer)</span>. Kiểm tra lại rồi xác nhận.</p>
                <ul class="cp-pay__app-grid">
                    @foreach (var app in BankApps.Apps.Where(a => a.Autofill))
                    {
                        <li><a href="@BankAppLinks.Link(app, t, origin + pay)" rel="noopener noreferrer"><img src="@BankAppLinks.Icon(app)" alt="" width="44" height="44" loading="lazy" referrerpolicy="no-referrer" /><span>@app.Name</span></a></li>
                    }
                </ul>
                }
                <div class="cp-pay__apps-group">@(Model.QrOnly ? "Mở ứng dụng ngân hàng rồi quét ảnh mã QR" : "Ngân hàng khác: chỉ mở ứng dụng")</div>
                <p class="cp-hint">Ngân hàng chưa hỗ trợ điền sẵn. Tải ảnh mã QR, mở ứng dụng rồi chọn quét mã QR từ ảnh trong máy, hoặc sao chép số tài khoản, số tiền, nội dung ở trang thanh toán.</p>
                <button class="cp-btn cp-btn--ghost cp-btn--block" type="button" data-cp-save-qr>@downloadIcon<span>Tải ảnh mã QR</span></button>
                <ul class="cp-pay__app-grid">
                    @foreach (var app in BankApps.Apps.Where(a => !a.Autofill))
                    {
                        <li><a href="@BankAppLinks.Link(app, t, origin + pay)" rel="noopener noreferrer"><img src="@BankAppLinks.Icon(app)" alt="" width="44" height="44" loading="lazy" referrerpolicy="no-referrer" /><span>@app.Name</span></a></li>
                    }
                </ul>
                <p class="cp-hint">Trên máy tính: quét mã QR bằng điện thoại.</p>
            </dialog>
        }

        <footer class="cp-pay__foot">@UiIcon.Render("shield-check")<span>Quét mã bằng ứng dụng ngân hàng. Dịch vụ thanh toán do Hóa đơn tự động cung cấp.</span></footer>
    </article>
</main>
<script src="~/js/customer.js" asp-append-version="true"></script>
<script>
    // "Chuyển khoản": the bank app list (a dialog; closes on ×, Escape or a tap outside).
    document.addEventListener("click", e => {
        const open = e.target.closest("[data-cp-open-dialog]");
        if (open) { document.getElementById(open.dataset.cpOpenDialog)?.showModal(); return; }
        if (e.target.closest("[data-cp-close-dialog]") || e.target.matches("dialog.cp-pay__apps")) e.target.closest("dialog")?.close();
        if (e.target.closest("[data-cp-save-qr]")) saveQr();
        const copy = e.target.closest("[data-cp-copy-text]");
        if (copy) {
            const done = () => { copy.classList.add("is-copied"); copy.title = "Đã sao chép"; setTimeout(() => copy.classList.remove("is-copied"), 1600); };
            const fallback = () => {
                const area = Object.assign(document.createElement("textarea"), { value: copy.dataset.cpCopyText });
                area.setAttribute("readonly", ""); area.style.cssText = "position:fixed;opacity:0";
                document.body.append(area); area.select(); document.execCommand?.("copy"); area.remove(); done();
            };
            if (navigator.clipboard) navigator.clipboard.writeText(copy.dataset.cpCopyText).then(done, fallback); else fallback();
        }
    });

    // "Tải ảnh mã QR": the QR and the transfer details under it, drawn on a canvas as one PNG. Browsers inside chat apps
    // (Zalo, Messenger…) ignore downloads, so the image is also shown to long-press and save.
    async function qrPng() {
        const info = JSON.parse(document.querySelector("[data-cp-qr-info]").textContent);
        const svg = document.querySelector(".cp-pay__qr-box svg").cloneNode(true);
        svg.setAttribute("width", 1000); svg.setAttribute("height", 1000);
        const qr = new Image();
        qr.src = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(svg)], { type: "image/svg+xml" }));
        await qr.decode();
        const W = 720, P = 48, font = (w, s) => `${w} ${s}px -apple-system, "Segoe UI", Roboto, Arial, sans-serif`;
        const c = document.createElement("canvas"), g = c.getContext("2d");
        const wrap = (text, width) => {
            const lines = []; let line = "";
            for (const word of String(text).split(/\s+/)) {
                const next = line ? line + " " + word : word;
                if (line && g.measureText(next).width > width) { lines.push(line); line = word; } else line = next;
            }
            return line ? [...lines, line] : lines;
        };
        // Lay out once to measure the height, then draw.
        const draw = paint => {
            let y = P;
            const text = (t, w, s, color, x = W / 2, align = "center", width = W - 2 * P) => {
                g.font = font(w, s);
                for (const l of wrap(t, width)) { if (paint) { g.fillStyle = color; g.textAlign = align; g.fillText(l, x, y + s); } y += s * 1.3; }
            };
            text(info.seller, "700", 30, "#0f172a");
            text(info.title, "400", 24, "#475569");
            y += 20;
            const q = 440;
            if (paint) { g.drawImage(qr, (W - q) / 2, y, q, q); }
            y += q + 24;
            text("Số tiền cần thanh toán", "400", 22, "#64748b");
            text(info.amount, "800", 46, "#0f172a");
            y += 16;
            for (const [label, value] of info.rows) {
                if (paint) { g.strokeStyle = "#e2e8f0"; g.beginPath(); g.moveTo(P, y); g.lineTo(W - P, y); g.stroke(); }
                y += 14;
                const top = y;
                text(label, "400", 22, "#64748b", P, "left", 240);
                const after = y; y = top;
                text(value, "700", 22, "#0f172a", W - P, "right", W - 2 * P - 260);
                y = Math.max(y, after) + 6;
            }
            y += 18;
            text("Quét mã bằng ứng dụng ngân hàng · Hóa đơn tự động", "400", 18, "#94a3b8");
            return y + P - 20;
        };
        const H = draw(false), k = 2;   // drawn at twice the size: sharp on phones and in print
        c.width = W * k; c.height = H * k;
        g.scale(k, k);
        g.fillStyle = "#fff"; g.fillRect(0, 0, W, H);
        draw(true);
        URL.revokeObjectURL(qr.src);
        return { info, url: c.toDataURL("image/png") };
    }
    async function saveQr() {
        let png;
        try { png = await qrPng(); } catch { alert("Không tạo được ảnh mã QR. Hãy chụp màn hình mã QR."); return; }
        const dialog = document.getElementById("qrImage");
        dialog.querySelector("[data-cp-qr-image]").src = png.url;
        const link = dialog.querySelector("[data-cp-qr-download]");
        link.href = png.url; link.download = png.info.file;
        document.getElementById("bankApps")?.close();
        if (/Zalo|FBAN|FBAV|FB_IAB|Instagram|Line\//i.test(navigator.userAgent)) { dialog.showModal(); return; }
        link.click();
        dialog.showModal();
    }
</script>
</body>
</html>

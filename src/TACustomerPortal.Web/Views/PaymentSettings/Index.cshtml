@model PaymentSettingsVm
@{
    ViewData["Title"] = "Cài đặt thanh toán";
    ViewData["Eyebrow"] = "Thanh toán";
    ViewData["Subtitle"] = "Giá trị mặc định khi tạo đơn hàng mới; có thể thay đổi riêng cho từng đơn.";
    var i = Model.Input;
}
<div class="cp-grid cp-grid--2">
    <form class="cp-card" method="post" asp-action="Index">
        <div class="cp-card__body">
            <div class="cp-field">
                <input type="hidden" name="AutoIssueInvoiceDefault" value="false" />
                <label class="cp-check"><input type="checkbox" name="AutoIssueInvoiceDefault" value="true" checked="@i.AutoIssueInvoiceDefault" disabled="@(!Model.CanManage)" /><span><strong>Tự động xuất hóa đơn điện tử khi đơn được thanh toán đủ</strong><span class="cp-muted" style="display:block">Áp dụng mặc định cho đơn hàng mới.</span></span></label>
            </div>
            <div class="cp-field" style="margin-bottom:0">
                <label class="cp-label" for="DefaultQrExpireMinutes">Thời hạn QR mặc định (phút)</label>
                <div class="cp-input-wrap">@UiIcon.Render("clock")<input class="cp-input" id="DefaultQrExpireMinutes" name="DefaultQrExpireMinutes" type="number" min="1" max="43200" value="@i.DefaultQrExpireMinutes" required disabled="@(!Model.CanManage)" /></div>
                <div class="cp-error">@Html.ValidationMessage("DefaultQrExpireMinutes")</div>
            </div>
        </div>
        @if (Model.CanManage) {<div class="cp-card__foot"><button class="cp-btn cp-btn--primary" type="submit" style="margin-left:auto">@UiIcon.Render("device-floppy")<span>Lưu cài đặt</span></button></div>}
    </form>
    <aside class="cp-note" style="align-self:start">@UiIcon.Render("info-circle")<div>Hóa đơn chỉ được xuất khi đơn đã nhận đủ tiền. Chức năng kết nối nhà cung cấp hóa đơn điện tử sẽ được T.A kích hoạt ở giai đoạn sau.</div></aside>
</div>

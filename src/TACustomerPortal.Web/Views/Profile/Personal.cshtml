@model CustomerUser
@{
    ViewData["Title"] = "Thông tin cá nhân";
    ViewData["PageIcon"] = "id";
}
<div class="row"><div class="col-xl-7">
<section class="card">
    <div class="card-body">
        <dl class="ta-dl"><dt>Họ tên</dt><dd>@Model.DisplayName</dd><dt>Tên đăng nhập</dt><dd>@Model.Username</dd><dt>Email</dt><dd>@(Model.Email ?? "—")</dd><dt>Trạng thái</dt><dd><span class="ta-badge ta-badge--success">Đang hoạt động</span></dd></dl>
    </div>
    <div class="card-footer ta-form-actions"><a asp-controller="Account" asp-action="ChangePassword" class="btn btn-primary">@UiIcon.Render("key")<span>Đổi mật khẩu</span></a></div>
</section>
</div></div>

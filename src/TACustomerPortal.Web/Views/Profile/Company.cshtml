@model CustomerMembership
@{
    ViewData["Title"] = "Hồ sơ doanh nghiệp";
    ViewData["Eyebrow"] = "Doanh nghiệp";
    ViewData["Heading"] = Model.Name;
    ViewData["Subtitle"] = "Thông tin doanh nghiệp đang truy cập. Cần thay đổi? Liên hệ quản trị viên T.A.";
}
<div class="cp-grid cp-grid--2">
    <section class="cp-card" aria-labelledby="companyInfo">
        <div class="cp-card__head"><span class="cp-blob">@UiIcon.Render("building")</span><h2 id="companyInfo">Thông tin doanh nghiệp</h2></div>
        <div class="cp-card__body">
            <dl class="cp-dl">
                <div><dt>@UiIcon.Render("hash")Mã khách hàng</dt><dd><span class="cp-code">@Model.Code</span></dd></div>
                <div><dt>@UiIcon.Render("receipt-tax")Mã số thuế</dt><dd>@(Model.TaxCode ?? "—")</dd></div>
                <div><dt>@UiIcon.Render("mail")Email</dt><dd>@(Model.Email ?? "—")</dd></div>
                <div><dt>@UiIcon.Render("phone")Điện thoại</dt><dd>@(Model.Phone ?? "—")</dd></div>
                <div class="cp-span"><dt>@UiIcon.Render("map-pin")Địa chỉ</dt><dd>@(Model.Address ?? "—")</dd></div>
            </dl>
        </div>
    </section>
    <section class="cp-card" aria-labelledby="yourRole">
        <div class="cp-card__head"><span class="cp-blob cp-blob--gold">@UiIcon.Render("shield-check")</span><h2 id="yourRole">Quyền của bạn</h2></div>
        <div class="cp-card__body">
            <span class="cp-badge cp-badge--green" style="font-size:14px;padding:6px 14px">@CustomerAccess.RoleLabel(Model.Role)</span>
            <p class="cp-hint" style="margin-top:12px">Quyền chỉ áp dụng cho doanh nghiệp này trong Customer Portal.</p>
        </div>
        <div class="cp-card__foot"><a class="cp-btn cp-btn--ghost cp-btn--block" asp-controller="Account" asp-action="SelectCustomer">@UiIcon.Render("switch-horizontal")<span>Đổi doanh nghiệp</span></a></div>
    </section>
    <section class="cp-card" aria-labelledby="companyLogo" data-cp-company-logo>
        <div class="cp-card__head"><span class="cp-blob cp-blob--blue">@UiIcon.Render("photo")</span><h2 id="companyLogo">Logo doanh nghiệp</h2></div>
        <div class="cp-card__body">
            @if (ViewData["LogoUnavailable"] is true)
            {
                <p class="cp-muted">Chức năng logo đang được T.A cập nhật, vui lòng quay lại sau.</p>
            }
            else
            {
                var version = ViewData["LogoVersion"] as string;
                var canManage = CustomerAccess.CanManage(Model, CustomerModules.Profile);
                <form class="cp-logo-picker" method="post" asp-action="Logo" enctype="multipart/form-data" data-cp-logo-picker data-ta-hard>
                    <span class="cp-logo-frame">
                        <img src="@(version is null ? null : Url.Action("CompanyLogo") + "?v=" + version)" alt="Logo @Model.Name" hidden="@(version is null)" data-cp-logo-preview />
                        <span data-cp-logo-empty hidden="@(version is not null)">@UiIcon.Render("photo")</span>
                    </span>
                    <div class="cp-logo-picker__body">
                        <p class="cp-hint" style="margin:0">Hiển thị trên trang thanh toán QR gửi cho khách hàng. Ảnh PNG, JPG hoặc WEBP, tối đa 1 MB, nên dùng ảnh vuông.</p>
                        @if (canManage)
                        {
                            <input type="file" name="logo" accept="@LogoUpload.Accept" aria-label="Chọn ảnh logo" data-cp-logo-input />
                            <div class="cp-logo-picker__actions">
                                <button class="cp-btn cp-btn--primary cp-btn--sm" type="submit">@UiIcon.Render("upload")<span>Lưu logo</span></button>
                                @if (version is not null) {<button class="cp-btn cp-btn--danger cp-btn--sm" type="submit" name="remove" value="true" onclick="return confirm('Xóa logo doanh nghiệp?')">@UiIcon.Render("trash")<span>Xóa logo</span></button>}
                            </div>
                        }
                        else {<p class="cp-muted" style="margin:0">Tài khoản có quyền quản lý hồ sơ doanh nghiệp có thể thay logo.</p>}
                    </div>
                </form>
            }
        </div>
    </section>
</div>

@model ModuleDeniedVm
@{
    ViewData["Title"] = "Chưa được cấp quyền";
    ViewData["HideHeader"] = true;
}
<div class="cp-center" data-cp-module-denied="@Model.Module">
    <section class="cp-card cp-state">
        <span class="cp-blob cp-blob--gold">@UiIcon.Render("lock")</span>
        <h1>Chưa được cấp quyền</h1>
        @if (Model.Manage)
        {
            <p>Tài khoản của bạn chưa có quyền quản lý mục <strong>@Model.Label</strong> nên không thực hiện được thao tác này.</p>
        }
        else
        {
            <p>Tài khoản của bạn chưa được cấp quyền xem mục <strong>@Model.Label</strong>.</p>
        }
        <p class="cp-muted">Vui lòng liên hệ người quản lý tài khoản của doanh nghiệp để được cấp quyền.</p>
        <a class="cp-btn cp-btn--primary" asp-controller="Dashboard" asp-action="Index">@UiIcon.Render("layout-dashboard")<span>Về trang tổng quan</span></a>
    </section>
</div>

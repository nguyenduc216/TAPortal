@functions {
    // Customer Portal navigation (top pills on desktop, bottom tab bar on phones). Same four destinations everywhere.
    private static readonly (string Controller, string Action, string Icon, string Label, string Short)[] Nav =
    [
        ("Dashboard", "Index", "layout-dashboard", "Tổng quan", "Tổng quan"),
        ("Profile", "Company", "building", "Doanh nghiệp", "Doanh nghiệp"),
        ("Profile", "Personal", "id", "Cá nhân", "Cá nhân"),
        ("Account", "ChangePassword", "shield-lock", "Bảo mật", "Bảo mật"),
    ];

    private bool IsCurrent(string controller, string action) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase);

    private static string Initials(string? name)
    {
        var last = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        return string.IsNullOrEmpty(last) ? "TA" : last[..1].ToUpperInvariant();
    }
}
@{
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name;
    var heading = ViewData["Heading"] as string ?? ViewData["Title"] as string;
    var hideHeader = ViewData["HideHeader"] is true;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="~/images/favicon-32x32.png" />
    <meta name="theme-color" content="#0F5132" />
    <title>@ViewData["Title"] · T.A Customer Portal</title>
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>
<body class="cp">
@if (User.Identity?.IsAuthenticated == true)
{
    <a class="cp-skip" href="#cpMain">Bỏ qua đến nội dung chính</a>
    <header class="cp-top">
        <div class="cp-top__inner">
            <a class="cp-brand" asp-controller="Dashboard" asp-action="Index" aria-label="T.A Customer Portal — Tổng quan">
                <span class="cp-brand__mark" aria-hidden="true">T<span>A</span></span>
                <span class="cp-brand__text">T.A Portal<small>Khách hàng</small></span>
            </a>
            <nav class="cp-nav" id="cpNav" data-ta-swap aria-label="Điều hướng chính">@foreach (var n in Nav) {<a class="cp-nav__link" href="@Url.Action(n.Action, n.Controller)" aria-current="@(IsCurrent(n.Controller, n.Action) ? "page" : null)">@UiIcon.Render(n.Icon)<span>@n.Label</span></a>}</nav>
            <div class="cp-top__end">
                <a class="cp-chip" asp-controller="Account" asp-action="SelectCustomer" title="Đổi doanh nghiệp">@UiIcon.Render("switch-horizontal")<span>Đổi doanh nghiệp</span></a>
                <details class="cp-user" data-cp-menu>
                    <summary aria-label="Tài khoản: @displayName"><span class="cp-avatar" aria-hidden="true">@Initials(displayName)</span><span class="cp-user__name">@displayName<small>@User.Identity?.Name</small></span></summary>
                    <div class="cp-user__menu">
                        <a asp-controller="Profile" asp-action="Personal">@UiIcon.Render("id")<span>Thông tin cá nhân</span></a>
                        <a asp-controller="Account" asp-action="ChangePassword">@UiIcon.Render("key")<span>Đổi mật khẩu</span></a>
                        <a asp-controller="Account" asp-action="SelectCustomer">@UiIcon.Render("switch-horizontal")<span>Đổi doanh nghiệp</span></a>
                        <hr />
                        <form method="post" asp-controller="Account" asp-action="Logout" data-ta-hard><button type="submit" class="cp-danger">@UiIcon.Render("logout")<span>Đăng xuất</span></button></form>
                    </div>
                </details>
            </div>
        </div>
    </header>
    <main id="cpMain" class="cp-main cp-enter" tabindex="-1" data-ta-swap>
        @if (!hideHeader)
        {
            <div class="cp-head">
                <div class="cp-head__text">
                    @if (ViewData["Eyebrow"] is string eyebrow) {<div class="cp-eyebrow">@eyebrow</div>}
                    <h1 class="cp-title">@heading</h1>
                    @if (ViewData["Subtitle"] is string subtitle) {<p class="cp-sub">@subtitle</p>}
                </div>
            </div>
        }
        @RenderBody()
    </main>
    <nav class="cp-tabbar" id="cpTabbar" data-ta-swap aria-label="Điều hướng nhanh">@foreach (var n in Nav) {<a href="@Url.Action(n.Action, n.Controller)" aria-current="@(IsCurrent(n.Controller, n.Action) ? "page" : null)">@UiIcon.Render(n.Icon)<span>@n.Short</span></a>}</nav>
    <footer class="cp-footer"><span>T.A Customer Portal</span><span>Cần hỗ trợ? Liên hệ quản trị viên T.A của bạn.</span></footer>
}
else
{
    <main class="cp-auth-shell">@RenderBody()</main>
}
<script src="~/js/ta-shell.js" asp-append-version="true"></script>
<script src="~/js/customer.js" asp-append-version="true"></script>
</body>
</html>

@using TAPortal.Integrations.Tingee
@model OrdersVm
@{
    ViewData["Title"] = "Đơn hàng & QR";
    ViewData["Eyebrow"] = "Thanh toán";
    ViewData["Subtitle"] = "Mỗi đơn có mã QR thanh toán; khách có thể trả nhiều lần đến khi đủ số tiền.";
}
@if (!Model.Linked) { <partial name="_PaymentsNotLinked" /> }
<nav class="cp-stats" aria-label="Tổng hợp theo trạng thái đơn hàng" data-cp-order-cards>
    @foreach (var card in Model.Cards)
    {
        <a class="cp-card cp-stat" asp-action="Index" asp-route-status="@card.Code" aria-current="@(card.Code == Model.Filter ? "page" : null)" data-cp-card="@(card.Code ?? "ALL")">
            <div class="cp-stat__top"><span class="cp-stat__label">@card.Label</span><span class="cp-blob @card.Tone">@UiIcon.Render(card.Icon)</span></div>
            <div class="cp-stat__value">@card.Count đơn</div>
            <div class="cp-stat__hint">@PaymentText.Money(card.Amount) · đã thu @PaymentText.Money(card.Paid)</div>
        </a>
    }
</nav>
<section class="cp-card">
    <div class="cp-toolbar">
        <div class="cp-search">@UiIcon.Render("search")<input class="cp-input" type="search" aria-label="Tìm đơn hàng" placeholder="Tìm theo mã đơn, khách hàng..." oninput="taFilterRows(this.value,'ordersTable')" /></div>
        @if (Model.CanManage) {<div class="cp-toolbar__end"><a class="cp-btn cp-btn--primary" asp-action="Create">@UiIcon.Render("plus")<span>Tạo đơn hàng</span></a></div>}
    </div>
    @if (Model.Orders.Count == 0)
    {
        <div class="cp-empty" data-cp-empty>@UiIcon.Render("file-invoice")<p>Chưa có đơn hàng nào.</p></div>
    }
    else
    {
        <div class="cp-table-wrap">
            <table class="cp-table" id="ordersTable" data-ta-pager="10">
                <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th class="cp-num">Số tiền</th><th class="cp-num">Đã thu</th><th>Trạng thái</th><th>Hóa đơn</th><th>Hết hạn QR</th><th>Tạo lúc</th></tr></thead>
                <tbody>
                @foreach (var o in Model.Orders)
                {
                    var (label, css) = PaymentText.OrderStatus(o.Status);
                    <tr data-ta-row>
                        <td><a class="cp-link" asp-action="Details" asp-route-id="@o.Id">@o.OrderNo</a><div class="cp-muted">@o.Description</div></td>
                        <td>@(o.ContactName ?? "Khách lẻ")</td>
                        <td class="cp-num">@PaymentText.Money(o.Amount)</td>
                        <td class="cp-num">@PaymentText.Money(o.PaidAmount)</td>
                        <td><span class="cp-badge @css">@label</span>@if (o.Overpaid > 0) {<span class="cp-badge cp-badge--red">Trả dư</span>}@if (o.PartnerDiffers) {<span class="cp-badge cp-badge--gold">Lệch đối soát</span>}</td>
                        @{ var (invLabel, invCss) = InvoiceText.Status(o.InvoiceStatus); }
                        <td data-cp-invoice-status="@o.InvoiceStatus"><span class="cp-badge @invCss" title="@(o.InvoiceStatus == OrderInvoiceStatus.Failed ? PartnerText.Scrub(o.InvoiceError) : null)">@invLabel</span>@if (o.InvoiceNumber is string no) {<div class="cp-muted">Số @no</div>}
                            else if (o.InvoiceStatus == OrderInvoiceStatus.None) {<div class="cp-muted">@(o.AutoIssueInvoice ? "Tự xuất khi thanh toán đủ" : "Xuất tay")</div>}</td>
                        <td>@PaymentText.VietnamTime(o.ExpiresAt)</td>
                        <td>@PaymentText.VietnamTime(o.CreatedAt)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

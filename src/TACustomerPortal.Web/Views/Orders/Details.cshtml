@model OrderDetailsVm
@using TAPortal.Integrations.Tingee
@{
    var o = Model.Order;
    var (label, css) = PaymentText.OrderStatus(Model.Status);
    ViewData["Title"] = o.OrderNo;
    ViewData["Eyebrow"] = "Đơn hàng & QR";
    ViewData["Heading"] = "Đơn " + o.OrderNo;
    ViewData["Subtitle"] = o.Description;
    var percent = o.Amount == 0 ? 0 : (int)Math.Min(100, Math.Round(o.PaidAmount * 100 / o.Amount));
    var canIssue = Model.CanManage && OrderMath.CanReissueQr(Model.Status) && o.Remaining > 0;
    var firstQr = Model.Status is OrderStatus.Draft or OrderStatus.Expired;
    var open = Model.Status is OrderStatus.Awaiting or OrderStatus.Partial;
    var (invoiceLabel, invoiceCss) = InvoiceText.Status(o.InvoiceStatus);
    var issued = o.InvoiceStatus == OrderInvoiceStatus.Issued;
    var draft = o.InvoiceStatus == OrderInvoiceStatus.Draft;
    var canInvoice = Model.CanManage && Model.InvoiceReady && o.Status == OrderStatus.Paid && !issued;
}
<div class="cp-grid cp-grid--2">
    <div>
        <section class="cp-card" style="margin-bottom:14px">
            <div class="cp-card__head"><span class="cp-blob">@UiIcon.Render("file-invoice")</span><h2>Thanh toán</h2><span class="cp-badge @css" style="margin-left:auto" data-cp-order-status="@Model.Status">@label</span></div>
            <div class="cp-card__body">
                <dl class="cp-dl">
                    <div><dt>@UiIcon.Render("report-money")Số tiền đơn</dt><dd>@PaymentText.Money(o.Amount)</dd></div>
                    <div><dt>@UiIcon.Render("circle-check")Đã thu</dt><dd>@PaymentText.Money(o.PaidAmount)</dd></div>
                    <div><dt>@UiIcon.Render("clock")Còn phải thu</dt><dd>@PaymentText.Money(o.Remaining)</dd></div>
                    @if (o.Overpaid > 0) {<div><dt>@UiIcon.Render("alert-triangle")Trả dư</dt><dd>@PaymentText.Money(o.Overpaid) <span class="cp-badge cp-badge--red">Trả dư</span></dd></div>}
                    @if (o.PartnerPaidAmount is decimal partner) {<div><dt>@UiIcon.Render("refresh")Đối chiếu dịch vụ thanh toán</dt><dd>@PaymentText.Money(partner) <span class="cp-muted">(@PaymentText.VietnamTime(o.PartnerCheckedAt))</span> @if (o.PartnerDiffers) {<span class="cp-badge cp-badge--red">Lệch đối soát</span>} else {<span class="cp-badge cp-badge--green">Khớp</span>}</dd></div>}
                    <div><dt>@UiIcon.Render("clock")QR hết hạn</dt><dd>@PaymentText.VietnamTime(o.ExpiresAt)</dd></div>
                    <div><dt>@UiIcon.Render("user")Khách hàng</dt><dd>@if (Model.Contact is { } who) {<button type="button" class="cp-linkbtn" data-cp-show-dialog="contactDialog" title="Xem thông tin khách hàng">@who.Name</button>} else {<span>Khách lẻ</span>}</dd></div>
                    <div><dt>@UiIcon.Render("building-bank")Nhận tiền vào</dt><dd>@(Model.Bank is { } b ? $"{b.BankName} — {b.ReceiveAccount}" : "—")</dd></div>
                    <div data-cp-invoice="@o.InvoiceStatus"><dt>@UiIcon.Render("file-text")Hóa đơn điện tử</dt><dd>@(o.AutoIssueInvoice ? "Tự động xuất khi thanh toán đủ" : "Không tự động") <span class="cp-badge @invoiceCss">@invoiceLabel</span>
                        @if (o.InvoiceNumber is string number) {<div>Số hóa đơn <span class="cp-code">@number</span> · @PaymentText.VietnamTime(o.InvoiceIssuedAt)</div>}
                        @if (o.InvoiceEmailedAt is not null) {<div class="cp-muted">Đã gửi email cho người mua. <button type="button" class="cp-linkbtn" data-cp-show-dialog="invoiceEmailDialog">Xem email đã gửi</button></div>}</dd></div>
                    @if (Model.InvoiceBuyer is { IsSet: true } payer)
                    {
                        <div data-cp-invoice-buyer><dt>@UiIcon.Render("receipt-tax")Thông tin xuất hóa đơn</dt><dd>@(payer.Name ?? "—")@if (payer.TaxCode is string tax) {<span> · MST <span class="cp-code">@tax</span></span>}
                            <div class="cp-muted">Người mua cập nhật qua trang thanh toán · @PaymentText.VietnamTime(payer.UpdatedAt)</div></dd></div>
                    }
                    <div><dt>@UiIcon.Render("qrcode")Loại QR</dt><dd>@(o.QrType == TingeeQrTypes.Recurring ? "QR động (trả nhiều lần đến khi đủ)" : o.QrType == TingeeQrTypes.Static ? $"QR tĩnh (nội dung: {OrderMath.TransferContent(o.OrderNo)})" : "—")</dd></div>
                </dl>
                <div class="cp-progress" style="margin-top:14px" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="Tỷ lệ đã thanh toán"><span style="width:@(percent)%"></span></div>
                @if (Model.InCollection is { } inside) {<aside class="cp-note" style="margin-top:12px" data-cp-in-collection>@UiIcon.Render("cash")<div>Đơn này đang nằm trong phiếu thu gộp <a class="cp-link" asp-controller="Collections" asp-action="Details" asp-route-id="@inside.Id">@inside.CollectionNo</a>: tiền khách trả qua mã QR của phiếu thu cũng được trừ vào đơn này.</div></aside>}
                @if (o.LastError is string err) {<div class="cp-error" style="margin-top:10px">@err</div>}
                @if (o.InvoiceError is string invoiceError) {<div class="@(issued || draft ? "cp-muted" : "cp-error")" style="margin-top:10px" data-cp-invoice-error>Hóa đơn: @PartnerText.Scrub(invoiceError)</div>}
                @if (o.Status == OrderStatus.Paid && !Model.InvoiceReady && !issued) {<div class="cp-muted" style="margin-top:10px">Chưa cài đặt hóa đơn điện tử. <a class="cp-link" asp-controller="EInvoice" asp-action="Index">Kết nối phần mềm hóa đơn</a></div>}
                @if (Model.Status is OrderStatus.ExpiredPaid or OrderStatus.CancelledPaid || o.Overpaid > 0 || o.PartnerDiffers)
                {
                    <div class="cp-error" style="margin-top:10px">@(Model.Status == OrderStatus.ExpiredPaid ? "Có tiền chuyển vào sau khi mã QR hết hạn." : Model.Status == OrderStatus.CancelledPaid ? "Có tiền chuyển vào đơn đã hủy." : o.Overpaid > 0 ? "Khách đã chuyển dư so với số tiền đơn." : "Số đã thu trên hệ thống khác số dịch vụ thanh toán báo về.")
                        <a class="cp-link" asp-controller="Transactions" asp-action="Index" asp-route-q="@OrderMath.TransferContent(o.OrderNo)">Xem tại Đối soát giao dịch</a></div>
                }
            </div>
            <div class="cp-card__foot">
                <a class="cp-btn cp-btn--ghost" asp-action="Index">@UiIcon.Render("arrow-left")<span>Danh sách đơn</span></a>
                @if (open || Model.Status is OrderStatus.Expired or OrderStatus.ExpiredPaid) {<form method="post" asp-action="Refresh" asp-route-id="@o.Id"><button class="cp-btn cp-btn--ghost" type="submit">@UiIcon.Render("refresh")<span>Kiểm tra thanh toán</span></button></form>}
                @if (issued || draft) {<a class="cp-btn cp-btn--ghost" asp-action="InvoicePdf" asp-route-id="@o.Id" target="_blank" rel="noopener">@UiIcon.Render("file-text")<span>@(draft ? "Xem bản nháp PDF" : "Xem hóa đơn PDF")</span></a>}
                @if (canInvoice) {<form method="post" asp-action="IssueInvoice" asp-route-id="@o.Id" onsubmit="return confirm('Xuất hóa đơn điện tử cho đơn @o.OrderNo? Hóa đơn được ký và gửi cơ quan thuế.')"><button class="cp-btn cp-btn--primary" type="submit">@UiIcon.Render("send")<span>@(o.InvoiceStatus is OrderInvoiceStatus.Failed or OrderInvoiceStatus.Draft ? "Xuất lại hóa đơn" : "Xuất hóa đơn")</span></button></form>}
                @if (Model.CanManage && OrderStatus.IsOpen(o.Status) && o.PaidAmount == 0) {<form method="post" asp-action="Cancel" asp-route-id="@o.Id" style="margin-left:auto" onsubmit="return confirm('Hủy đơn @o.OrderNo? Mã QR sẽ không còn dùng được.')"><button class="cp-btn cp-btn--danger" type="submit">@UiIcon.Render("ban")<span>Hủy đơn</span></button></form>}
            </div>
        </section>
        <section class="cp-card">
            <div class="cp-card__head"><span class="cp-blob cp-blob--gold">@UiIcon.Render("list-tree")</span><h2>Hàng hóa / dịch vụ</h2></div>
            <div class="cp-table-wrap">
                <table class="cp-table cp-table--stack">
                    <thead><tr><th>#</th><th>Tên</th><th>ĐVT</th><th class="cp-num">SL</th><th class="cp-num">Đơn giá</th><th>Thuế</th><th class="cp-num">Thành tiền</th></tr></thead>
                    <tbody>
                    @foreach (var l in o.Lines)
                    {
                        <tr><td data-label="#">@l.LineNumber</td><td data-label="Tên" class="cp-stack-title">@l.ItemName</td><td data-label="ĐVT">@(l.UnitName ?? "—")</td><td class="cp-num" data-label="SL">@l.Quantity.ToString("0.###")</td><td class="cp-num" data-label="Đơn giá">@PaymentText.Money(l.UnitPrice)</td><td data-label="Thuế">@OrderMath.TaxRates.First(t => t.Code == l.TaxRateCode).Label</td><td class="cp-num cp-stack-total" data-label="Thành tiền">@PaymentText.Money(l.Total)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <section class="cp-card" style="align-self:start" aria-label="Mã QR thanh toán">
        @if (Model.QrSvg is string svg)
        {
            <div class="cp-qr" data-cp-qr data-cp-poll="@Url.Action("Status", new { id = o.Id })" data-cp-poll-status="@Model.Status" data-cp-poll-paid="@o.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                @Html.Raw(svg)
                <div class="cp-qr__amount">@PaymentText.Money(o.Remaining)</div>
                <div class="cp-muted">Quét bằng ứng dụng ngân hàng · Nội dung: <span class="cp-code">@OrderMath.TransferContent(o.OrderNo)</span></div>
                <div class="cp-muted">Hiệu lực đến @PaymentText.VietnamTime(o.ExpiresAt)</div>
            </div>
        }
        else
        {
            <div class="cp-qr cp-muted">@UiIcon.Render("qrcode")<p>@(Model.Status switch { OrderStatus.Paid => "Đơn đã được thanh toán đủ.", OrderStatus.Cancelled => "Đơn đã hủy.", OrderStatus.Expired => "Mã QR đã hết hạn.", OrderStatus.ExpiredPaid => "Mã QR đã hết hạn và có giao dịch cần đối soát.", OrderStatus.CancelledPaid => "Đơn đã hủy và có giao dịch cần đối soát.", _ => "Đơn chưa có mã QR." })</p></div>
        }
        @if (canIssue)
        {
            <details class="cp-card__foot cp-reissue" data-cp-reissue open="@firstQr">
                <summary>@UiIcon.Render(firstQr ? "qrcode" : "refresh")<span>@(firstQr ? "Tạo QR thanh toán" : "Đổi thời hạn / tạo lại QR")</span></summary>
                <form method="post" asp-action="IssueQr" asp-route-id="@o.Id" class="cp-reissue__form" onsubmit="@(firstQr ? null : "return confirm('Tạo QR mới cho đơn " + o.OrderNo + "? Mã QR hiện tại sẽ được thay bằng mã mới; link QR cho khách hàng giữ nguyên.')")">
                    <p class="cp-muted">@(firstQr ? "QR cho số tiền còn phải thu, hiệu lực tính từ lúc tạo." : "QR mới thay QR hiện tại, cho số tiền còn phải thu; hiệu lực tính từ lúc tạo. Link QR cho khách hàng giữ nguyên.")</p>
                    @await Html.PartialAsync("_QrLifetime", new QrLifetimeField("QrExpire", firstQr ? "Thời hạn QR" : "Thời hạn QR mới", o.QrExpireMinutes, Last: true))
                    @if (Model.Banks.Count > 1)
                    {
                        <div class="cp-field" style="margin-bottom:0">
                            <label class="cp-label" for="reissue-bank">Tài khoản nhận tiền</label>
                            <select class="cp-input cp-input--plain" id="reissue-bank" name="bankAccountId" data-cp-issue-bank>@foreach (var b in Model.Banks) {<option value="@b.Id" selected="@(b.Id == (Model.Bank is { IsActive: true } cur ? cur.Id : Model.Banks[0].Id))">@PaymentText.BankOption(b)</option>}</select>
                        </div>
                    }
                    <button class="cp-btn cp-btn--primary" type="submit">@UiIcon.Render("qrcode")<span>@(firstQr ? "Tạo QR" + (o.PaidAmount > 0 ? " cho số còn lại" : "") : "Tạo QR mới")</span></button>
                </form>
            </details>
        }
        @if (Model.PayUrl is string payUrl)
        {
            <div class="cp-card__foot cp-paylink" data-cp-paylink>
                <div class="cp-paylink__text"><strong>Link QR cho khách hàng</strong><span class="cp-muted">Gửi link để khách quét QR, xem đơn và cập nhật thông tin xuất hóa đơn.</span></div>
                <div class="cp-paylink__row">
                    <div class="cp-input-wrap">@UiIcon.Render("link")<input class="cp-input" value="@payUrl" readonly aria-label="Link trang thanh toán" data-cp-copy-source /></div>
                    <button class="cp-btn cp-btn--ghost" type="button" data-cp-copy title="Sao chép link">@UiIcon.Render("copy")<span>Sao chép</span></button>
                    <a class="cp-btn cp-btn--primary" href="@payUrl" target="_blank" rel="noopener" data-ta-hard>@UiIcon.Render("external-link")<span>Xem link QR</span></a>
                </div>
            </div>
        }
    </section>
</div>
@if (Model.Contact is { } person)
{
    <dialog class="cp-dialog" id="contactDialog" aria-labelledby="contactDialogTitle" data-cp-contact-dialog>
        <div class="cp-dialog__head"><strong id="contactDialogTitle">@person.Name</strong><button type="button" class="cp-dialog__close" data-cp-dialog-close aria-label="Đóng">×</button></div>
        <dl class="cp-dl cp-dl--stack">
            <div><dt>Mã khách hàng</dt><dd><span class="cp-code">@person.Code</span>@if (!person.IsActive) {<span class="cp-badge cp-badge--soft" style="margin-left:6px">Ngừng dùng</span>}</dd></div>
            @if (person.LegalName is { Length: > 0 } legal && legal != person.Name) {<div><dt>Tên đơn vị</dt><dd>@legal</dd></div>}
            @if (person.TaxCode is { Length: > 0 } tax) {<div><dt>Mã số thuế</dt><dd><span class="cp-code">@tax</span></dd></div>}
            @if (person.IdentityNumber is { Length: > 0 } idn) {<div><dt>CCCD/Định danh</dt><dd>@idn</dd></div>}
            <div><dt>Điện thoại</dt><dd>@if (person.Phone is { Length: > 0 } phone) {<a class="cp-link" href="tel:@phone">@phone</a>} else {<span>—</span>}</dd></div>
            @if (person.Zalo is { Length: > 0 } zalo && zalo != person.Phone) {<div><dt>Zalo</dt><dd>@zalo</dd></div>}
            <div><dt>Email</dt><dd>@if (person.Email is { Length: > 0 } mail) {<a class="cp-link" href="mailto:@mail">@mail</a>} else {<span>—</span>}</dd></div>
            <div><dt>Địa chỉ</dt><dd>@(person.Address is { Length: > 0 } addr ? addr : "—")</dd></div>
            @if (person.BankAccountNumber is { Length: > 0 } acc) {<div><dt>Tài khoản ngân hàng</dt><dd>@acc@(person.BankName is { Length: > 0 } bn ? " — " + bn : "")@(person.BankAccountName is { Length: > 0 } an ? " (" + an + ")" : "")</dd></div>}
            @if (person.Note is { Length: > 0 } note) {<div><dt>Ghi chú</dt><dd>@note</dd></div>}
        </dl>
        <div class="cp-dialog__foot">
            @if (Model.CanManage) {<a class="cp-btn cp-btn--ghost" asp-controller="Contacts" asp-action="Edit" asp-route-id="@person.Id">@UiIcon.Render("pencil")<span>Sửa thông tin</span></a>}
            <button type="button" class="cp-btn cp-btn--primary" data-cp-dialog-close>Đóng</button>
        </div>
    </dialog>
}
@if (o.InvoiceEmailedAt is not null)
{
    var provider = Model.InvoiceProvider ?? "nhà cung cấp hóa đơn điện tử";
    <dialog class="cp-dialog" id="invoiceEmailDialog" aria-labelledby="invoiceEmailTitle" data-cp-invoice-email-dialog>
        <div class="cp-dialog__head"><strong id="invoiceEmailTitle">Email hóa đơn đã gửi người mua</strong><button type="button" class="cp-dialog__close" data-cp-dialog-close aria-label="Đóng">×</button></div>
        <dl class="cp-dl cp-dl--stack">
            <div><dt>Thời điểm gửi</dt><dd>@PaymentText.VietnamTime(o.InvoiceEmailedAt)</dd></div>
            <div><dt>Gửi tới</dt><dd>@if (Model.Contact?.Email is { Length: > 0 } to) {<span>@to</span><div class="cp-muted">Email của khách hàng tại thời điểm xuất hóa đơn. Nếu đã sửa email khách sau đó, thư đã đi tới địa chỉ cũ.</div>} else {<span>Email của khách hàng lúc xuất hóa đơn</span><div class="cp-muted">Khách hàng hiện không còn lưu email.</div>}</dd></div>
            <div><dt>Người gửi</dt><dd>@provider<div class="cp-muted">Hệ thống hóa đơn điện tử gửi thay doanh nghiệp, theo mẫu thư của họ.</div></dd></div>
            <div><dt>Nội dung</dt><dd>Thông báo phát hành hóa đơn điện tử@(o.InvoiceNumber is string n ? " số " + n : ""), kèm thông tin để người mua tra cứu và tải hóa đơn.</dd></div>
        </dl>
        <p class="cp-muted" style="margin:12px 0 0">Hệ thống không lưu bản sao thư. Hóa đơn người mua nhận được chính là bản PDF dưới đây. Muốn xem nguyên văn thư hoặc gửi lại, vào trang quản lý của @provider.</p>
        <div class="cp-dialog__foot">
            <a class="cp-btn cp-btn--ghost" asp-action="InvoicePdf" asp-route-id="@o.Id" target="_blank" rel="noopener">@UiIcon.Render("file-text")<span>Xem hóa đơn PDF</span></a>
            <button type="button" class="cp-btn cp-btn--primary" data-cp-dialog-close>Đóng</button>
        </div>
    </dialog>
}

@model PageVm
@{
    ViewData["Site"] = Model.Site;
    ViewData["Preselect"] = Model.Preselect;
    ViewData["PageStyles"] = Model.Page.Def.Styles;
    ViewData["PageScripts"] = Model.Page.Def.Scripts;
}
<main id="top" class="@Model.Page.Def.MainClass">
@foreach (var section in Model.Page.Sections.Where(s => s.IsVisible))
{
    <partial name="~/Views/Sections/@(section.Def.Type).cshtml" model="@(new SectionVm(section, Model.Site, Model.Posts))" view-data="ViewData" />
}
</main>
